From cf2f5f53aa88103d607f36a2ead190bac8202669 Mon Sep 17 00:00:00 2001
From: Sebastian Huang <sebastian_huang@accton.com>
Date: Thu, 15 Oct 2026 22:56:52 +0800
Subject: [PATCH] mediatek: add an option to build the MediaTek SDK kernel

Some filogic boards (Edgecore EAP111, EAP112, EAP115 and EAP115a) run
the MediaTek reference SDK Wi-Fi stack, which needs the SDK kernel
patches. Applying those patches to the whole target would also move
every other filogic board to the SDK kernel.

Add MTK_SDK_KERNEL. When it is set, the kernel is built with the
patches, files and kernel config from patches-6.12-mtk-sdk,
files-6.12-mtk-sdk and filogic/config-6.12-mtk-sdk on top of the
standard mediatek kernel. Boards that do not set it keep the standard
kernel.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 config/Config-kernel.in        | 11 +++++++++++
 target/linux/mediatek/Makefile | 11 +++++++++++
 2 files changed, 22 insertions(+)

diff --git a/config/Config-kernel.in b/config/Config-kernel.in
index fee4b0bce8..ffff71d094 100644
--- a/config/Config-kernel.in
+++ b/config/Config-kernel.in
@@ -11,6 +11,17 @@ config KERNEL_IPQ_MEM_PROFILE
 	  This option select memory profile to be used,which defines
 	  the reserved memory configuration used in device tree.
 
+config MTK_SDK_KERNEL
+	bool "Build the kernel with the MediaTek SDK patches"
+	depends on TARGET_mediatek_filogic
+	help
+	  Build the filogic kernel with the MediaTek reference SDK patches
+	  (target/linux/mediatek/patches-6.12-mtk-sdk), files
+	  (files-6.12-mtk-sdk) and kernel config
+	  (filogic/config-6.12-mtk-sdk) on top of the standard mediatek
+	  kernel. Only boards that use the MediaTek SDK Wi-Fi stack
+	  should select this.
+
 config KERNEL_BUILD_USER
 	string "Custom Kernel Build User Name"
 	default "builder" if BUILDBOT
diff --git a/target/linux/mediatek/Makefile b/target/linux/mediatek/Makefile
index 49b273f57c..7c73d549ac 100644
--- a/target/linux/mediatek/Makefile
+++ b/target/linux/mediatek/Makefile
@@ -10,6 +10,17 @@ FEATURES:=dt-overlay emmc fpu gpio nand pci pcie rootfs-part separate_ramdisk sq
 
 KERNEL_PATCHVER:=6.12
 
+# Set before target.mk so the kernel config of every build context
+# (kernel, packages, images) includes the SDK config. The SDK patches
+# and files only apply to the kernel itself, not to the toolchain headers.
+ifeq ($(CONFIG_MTK_SDK_KERNEL),y)
+  KERNEL_EXTRA_CONFIG:=$(TOPDIR)/target/linux/$(BOARD)/filogic/config-$(KERNEL_PATCHVER)-mtk-sdk
+  ifeq ($(TARGET_BUILD),1)
+    KERNEL_EXTRA_PATCH_DIR:=$(TOPDIR)/target/linux/$(BOARD)/patches-$(KERNEL_PATCHVER)-mtk-sdk
+    KERNEL_EXTRA_FILES_DIR:=$(wildcard $(TOPDIR)/target/linux/$(BOARD)/files-$(KERNEL_PATCHVER)-mtk-sdk)
+  endif
+endif
+
 include $(INCLUDE_DIR)/target.mk
 DEFAULT_PACKAGES += \
 	kmod-leds-gpio kmod-gpio-button-hotplug
-- 
2.34.1

