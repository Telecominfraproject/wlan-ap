From b28537828a2f64a3362442d73c3836a1bdb2cc99 Mon Sep 17 00:00:00 2001
From: Firas Shaari <firas.shaari@shaariconsultancy.com>
Date: Fri, 16 Oct 2026 00:54:46 -0400
Subject: [PATCH] netifd: stop the wireless handler dump loop at EOF

handler_load() in lib/netifd/utils.uc reads each driver dump with
"while (!f.error())". The ucode fs error state is global and the loop
only ends when a stale error (an EINVAL left behind by the first
mkstemp/seek) is consumed at the first EOF. With a single script in
/lib/netifd/wireless this happens to work; with two scripts netifd
either spins forever on the last script at boot or, once the stale
error is gone, skips the second script entirely, so its driver never
registers and the whole network configuration fails to load.

Terminate the loop on EOF instead and do not consult the error state,
so every driver script in the directory is parsed exactly once.

Seen on the Morse Micro HaLow Link 2, where netifd-morse installs
morse.sh next to mac80211.sh and netifd never brought up any interface.

Signed-off-by: Firas Shaari <firas.shaari@shaariconsultancy.com>
---
 package/network/config/netifd/files/lib/netifd/utils.uc | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/package/network/config/netifd/files/lib/netifd/utils.uc b/package/network/config/netifd/files/lib/netifd/utils.uc
index 84db69d2fa..4bde4f5b6d 100644
--- a/package/network/config/netifd/files/lib/netifd/utils.uc
+++ b/package/network/config/netifd/files/lib/netifd/utils.uc
@@ -54,8 +54,11 @@ export function handler_load(path, cb)
 		system(`./${script} "" "dump" >&${f.fileno()}`);
 		chdir(prev_dir);
 		f.seek();
-		while (!f.error()) {
-			let data = trim(f.read("line"));
+		while (true) {
+			let data = f.read("line");
+			if (data == null || data == "")
+				break;
+			data = trim(data);
 			try {
 				data = json(data);
 			} catch (e) {
