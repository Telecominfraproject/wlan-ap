From ce1a577dbf2031789c8b2ec9838199b9090fab1a Mon Sep 17 00:00:00 2001
From: "crychic.tan" <crychic.tan@cybertan.com.tw>
Date: Fri, 20 Nov 2026 10:56:52 +0800
Subject: [PATCH 141/150] mediatek: apply the WED offload fixes only for the
 RAP630W-211G

The SonicFi RAP630W-211G is the only board with WED enabled
(wed_enable=1 for mt7915e), and the mtk_ppe fixes for its WED offload
are only verified on it. Other filogic boards, including the MediaTek
SDK kernel of the Edgecore EAP111/112/115/115a, should not build them.

Apply the kernel patches in patches-6.12-sonicfi_rap630w_211g as the
extra patch set of the target when building for the RAP630W-211G,
through KERNEL_EXTRA_PATCH_DIR. The extra patch set takes part in the
kernel prepare stamp, so switching between the RAP630W-211G and another
board re-prepares the kernel. The RAP630W-211G does not use the SDK
kernel, so the two extra patch sets are never needed together; the SDK
kernel keeps its own.

Signed-off-by: crychic.tan <crychic.tan@cybertan.com.tw>
---
 target/linux/mediatek/Makefile | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/target/linux/mediatek/Makefile b/target/linux/mediatek/Makefile
index 7c73d549ac..e3a1f1b973 100644
--- a/target/linux/mediatek/Makefile
+++ b/target/linux/mediatek/Makefile
@@ -21,6 +21,17 @@ ifeq ($(CONFIG_MTK_SDK_KERNEL),y)
   endif
 endif
 
+# The WED offload fixes are only built for the RAP630W-211G, the only board
+# with WED enabled (wed_enable=1 in mt76). Other boards build the kernel
+# without them.
+ifeq ($(CONFIG_TARGET_PROFILE),"DEVICE_sonicfi_rap630w_211g")
+  ifneq ($(CONFIG_MTK_SDK_KERNEL),y)
+    ifeq ($(TARGET_BUILD),1)
+      KERNEL_EXTRA_PATCH_DIR:=$(TOPDIR)/target/linux/$(BOARD)/patches-$(KERNEL_PATCHVER)-sonicfi_rap630w_211g
+    endif
+  endif
+endif
+
 include $(INCLUDE_DIR)/target.mk
 DEFAULT_PACKAGES += \
 	kmod-leds-gpio kmod-gpio-button-hotplug
-- 
