From d290aa25987491aea45528bcd6dae04a66fd5fe3 Mon Sep 17 00:00:00 2001
From: Harrison Yeh <harrison_yeh@accton.com>
Date: Wed, 29 Jul 2026 17:31:33 +0800
Subject: [PATCH] Add uart1,uart2 and pins control definition to dts for eap115

---
 target/linux/mediatek/dts/mt7987-pinctrl.dtsi          |  7 +++++++
 target/linux/mediatek/dts/mt7987a-edgecore-eap115.dtsi | 12 ++++++++++++
 2 files changed, 19 insertions(+)

diff --git a/target/linux/mediatek/dts/mt7987-pinctrl.dtsi b/target/linux/mediatek/dts/mt7987-pinctrl.dtsi
index 41215c4..5835cb9 100644
--- a/target/linux/mediatek/dts/mt7987-pinctrl.dtsi
+++ b/target/linux/mediatek/dts/mt7987-pinctrl.dtsi
@@ -256,4 +256,11 @@
 			groups = "uart1_2";
 		};
 	};
+
+	uart2_pins: uart2-pins {
+		mux {
+			function = "uart";
+			groups = "uart2_1";
+		};
+	};
 };
diff --git a/target/linux/mediatek/dts/mt7987a-edgecore-eap115.dtsi b/target/linux/mediatek/dts/mt7987a-edgecore-eap115.dtsi
index d0a4a5b..ff956b2 100644
--- a/target/linux/mediatek/dts/mt7987a-edgecore-eap115.dtsi
+++ b/target/linux/mediatek/dts/mt7987a-edgecore-eap115.dtsi
@@ -232,3 +232,15 @@
 
 	status = "okay";
 };
+
+&uart1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart1_pins>;
+	status = "okay";
+};
+
+&uart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart2_pins>;
+	status = "okay";
+};
-- 
2.7.4

