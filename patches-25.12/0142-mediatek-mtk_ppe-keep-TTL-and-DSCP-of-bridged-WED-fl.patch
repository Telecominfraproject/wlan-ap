From 48d496900b0561bff55052c3bdf748e58c0bd64a Mon Sep 17 00:00:00 2001
From: "crychic.tan" <crychic.tan@cybertan.com.tw>
Date: Wed, 18 Nov 2026 10:09:51 +0800
Subject: [PATCH 142/150] mediatek: mtk_ppe: keep TTL and DSCP of bridged WED
 flows

With WED offload enabled, bridged WiFi <-> Ethernet traffic is forwarded
by the PPE as L2 subflows. Once a flow is offloaded, the PPE decrements
the IP TTL of every bridged packet and rewrites its DSCP to 0. Bridged
packets must keep their TTL, and losing the DSCP breaks QoS for the rest
of the network.

The L2 flow template sets the BIND_TTL bit for every packet type and
never fills IB2_DSCP, which the PPE uses to rewrite the TOS byte.

Add a mediatek target kernel patch that clears BIND_TTL in the template
of bridged flows, and that stores the TOS / traffic class of the packet
that triggers the bind in IB2_DSCP of the subflow. QinQ (802.1ad) and
PPPoE frames are not parsed and still get DSCP 0.

The patch is only applied when building for the SonicFi RAP630W-211G,
the only board with WED enabled, and only changes flows that are
forwarded to or received from a WED device.

Signed-off-by: crychic.tan <crychic.tan@cybertan.com.tw>
---
 ...ep-ttl-and-dscp-of-bridged-wed-flows.patch | 163 ++++++++++++++++++
 1 file changed, 163 insertions(+)
 create mode 100644 target/linux/mediatek/patches-6.12-sonicfi_rap630w_211g/999-2702-net-ethernet-mtk_ppe-keep-ttl-and-dscp-of-bridged-wed-flows.patch

diff --git a/target/linux/mediatek/patches-6.12-sonicfi_rap630w_211g/999-2702-net-ethernet-mtk_ppe-keep-ttl-and-dscp-of-bridged-wed-flows.patch b/target/linux/mediatek/patches-6.12-sonicfi_rap630w_211g/999-2702-net-ethernet-mtk_ppe-keep-ttl-and-dscp-of-bridged-wed-flows.patch
new file mode 100644
index 0000000000..80114a7792
--- /dev/null
+++ b/target/linux/mediatek/patches-6.12-sonicfi_rap630w_211g/999-2702-net-ethernet-mtk_ppe-keep-ttl-and-dscp-of-bridged-wed-flows.patch
@@ -0,0 +1,163 @@
+From: crychic.tan <crychic.tan@cybertan.com.tw>
+Subject: [PATCH] net: ethernet: mtk_ppe: keep TTL and DSCP of bridged WED flows
+
+L2 (bridge) flows are offloaded as per-5-tuple subflows that inherit ib1
+and ib2 from the L2 flow template. Two fields of that template are wrong
+for bridged traffic:
+
+- mtk_foe_entry_prepare() sets BIND_TTL for every packet type, so the PPE
+  decrements the IP TTL / hop limit of bridged packets as if it routed
+  them.
+- IB2_DSCP is never set, and the PPE rewrites the TOS byte / traffic
+  class of every bound packet from it, so all bridged packets lose their
+  DSCP and ECN bits once the flow is offloaded.
+
+Clear BIND_TTL in the template of bridged flows. When binding a subflow,
+take the TOS / traffic class from the packet that triggered the bind and
+store it in IB2_DSCP, the same way the MediaTek SDK does. The packet
+comes from either the GMAC rx path (skb->data at the network header,
+possibly behind an in-band MTK DSA tag) or the WED rx path (skb->data at
+the MAC header), so it is parsed from the MAC header. Frames without an
+IP header right after the MAC header and an optional 802.1Q tag, such as
+QinQ (802.1ad) or PPPoE frames, are not parsed and still get DSCP 0.
+
+So far this has only been verified for flows that are forwarded to or
+received from a WED device, so only change those, and keep the previous
+behaviour for all other flows. A flow is forwarded to a WED device when
+its output is a WDMA port, and packets received from a wireless device
+only reach the PPE through WED, so mark flows with either in the flow
+entry. Subflows inherit the mark from their L2 flow. The TOS / traffic
+class is stored in IB2_DSCP of the L2 flow right before the subflow
+copies its ib2, under ppe_lock.
+
+NETSYS v2 has no "keep DSCP/ECN" option, so the value is fixed for the
+lifetime of the subflow, including the ECN bits.
+
+Signed-off-by: crychic.tan <crychic.tan@cybertan.com.tw>
+---
+ drivers/net/ethernet/mediatek/mtk_ppe.c         |   64 ++++++++++++++
+ drivers/net/ethernet/mediatek/mtk_ppe.h         |    2 
+ drivers/net/ethernet/mediatek/mtk_ppe_offload.c |   14 ++++
+ 3 files changed, 80 insertions(+)
+
+--- a/drivers/net/ethernet/mediatek/mtk_ppe.c
++++ b/drivers/net/ethernet/mediatek/mtk_ppe.c
+@@ -739,6 +739,55 @@ int mtk_foe_entry_commit(struct mtk_ppe *ppe, struct mtk_flow_entry *entry)
+ 	return 0;
+ }
+ 
++/* length of the in-band MediaTek DSA tag, see net/dsa/tag_mtk.c */
++#define MTK_PPE_DSA_TAG_LEN	4
++
++/* Return the IPv4 TOS or IPv6 traffic class of the packet that is about to be
++ * bound. skb->data points to the network header on the GMAC rx path and to the
++ * MAC header on the WED rx path, so parse from the MAC header in both cases.
++ * Return -1 when no IP header follows the MAC header and an optional 802.1Q
++ * tag, e.g. for QinQ (802.1ad) or PPPoE frames.
++ */
++static int mtk_ppe_skb_dsfield(struct sk_buff *skb)
++{
++	u8 *end = skb_tail_pointer(skb);
++	__be16 proto;
++	u8 *hdr;
++
++	if (!skb_mac_header_was_set(skb))
++		return -1;
++
++	hdr = skb_mac_header(skb) + 2 * ETH_ALEN;
++	if (IS_ENABLED(CONFIG_NET_DSA) &&
++	    skb->protocol == htons(ETH_P_XDSA) && !skb_metadata_dst(skb))
++		hdr += MTK_PPE_DSA_TAG_LEN;
++
++	if (hdr + 2 > end)
++		return -1;
++
++	proto = get_unaligned((__be16 *)hdr);
++	hdr += 2;
++	if (proto == htons(ETH_P_8021Q)) {
++		if (hdr + VLAN_HLEN > end)
++			return -1;
++
++		proto = get_unaligned((__be16 *)(hdr + 2));
++		hdr += VLAN_HLEN;
++	}
++
++	if (hdr + 2 > end)
++		return -1;
++
++	switch (proto) {
++	case htons(ETH_P_IP):
++		return hdr[1];
++	case htons(ETH_P_IPV6):
++		return (get_unaligned_be16(hdr) >> 4) & 0xff;
++	default:
++		return -1;
++	}
++}
++
+ static void
+ mtk_foe_entry_commit_subflow(struct mtk_ppe *ppe, struct mtk_flow_entry *entry,
+ 			     u16 hash)
+@@ -755,6 +804,7 @@ mtk_foe_entry_commit_subflow(struct mtk_ppe *ppe, struct mtk_flow_entry *entry,
+ 		return;
+ 
+ 	flow_info->type = MTK_FLOW_TYPE_L2_SUBFLOW;
++	flow_info->wed = entry->wed;
+ 	flow_info->hash = hash;
+ 	hlist_add_head(&flow_info->list,
+ 		       &ppe->foe_flow[hash / soc->hash_offset]);
+@@ -849,6 +899,20 @@ void __mtk_ppe_check_skb(struct mtk_ppe *ppe, struct sk_buff *skb, u16 hash)
+ 	if (!entry)
+ 		goto out;
+ 
++	/* The PPE rewrites the TOS / traffic class of bound packets from
++	 * IB2_DSCP, which the subflow takes from its L2 flow. Set it to the
++	 * value of the packet being bound. Only done for flows from or to a
++	 * WED device so far.
++	 */
++	if (entry->wed) {
++		u32 *ib2 = &entry->data.bridge.ib2;
++		int dsfield = mtk_ppe_skb_dsfield(skb);
++
++		*ib2 &= ~MTK_FOE_IB2_DSCP;
++		if (dsfield > 0)
++			*ib2 |= FIELD_PREP(MTK_FOE_IB2_DSCP, dsfield);
++	}
++
+ 	mtk_foe_entry_commit_subflow(ppe, entry, hash);
+ 
+ out:
+--- a/drivers/net/ethernet/mediatek/mtk_ppe.h
++++ b/drivers/net/ethernet/mediatek/mtk_ppe.h
+@@ -300,6 +300,8 @@ struct mtk_flow_entry {
+ 	u8 type;
+ 	s8 wed_index;
+ 	u8 ppe_index;
++	/* forwarded to or received from a WED device */
++	bool wed;
+ 	u16 hash;
+ 	struct mtk_foe_entry data;
+ 	struct rhash_head node;
+--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
++++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+@@ -496,6 +496,20 @@ mtk_flow_offload_replace(struct mtk_eth *eth, struct flow_cls_offload *f,
+ 	memcpy(&entry->data, &foe, sizeof(entry->data));
+ 	entry->wed_index = wed_index;
+ 	entry->ppe_index = ppe_index;
++
++	/* Bridged packets must not have their IP TTL decremented. This is
++	 * only changed for flows from or to a WED device so far, other flows
++	 * keep the previous behaviour. Packets received from a wireless
++	 * device only reach the PPE through WED.
++	 */
++	entry->wed = wed_index >= 0;
++#if IS_ENABLED(CONFIG_CFG80211_HEADERS)
++	if (idev && idev->ieee80211_ptr)
++		entry->wed = true;
++#endif
++	if (entry->wed && offload_type == MTK_PPE_PKT_TYPE_BRIDGE)
++		entry->data.ib1 &= ~(mtk_is_netsys_v2_or_greater(eth) ?
++				     MTK_FOE_IB1_BIND_TTL_V2 : MTK_FOE_IB1_BIND_TTL);
+ 
+ 	err = mtk_foe_entry_commit(eth->ppe[entry->ppe_index], entry);
+ 	if (err < 0)
-- 
2.34.1

