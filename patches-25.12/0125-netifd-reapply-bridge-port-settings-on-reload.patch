From 3c438b82b1c9f9750fec650ba351333d5a7aaecf Mon Sep 17 00:00:00 2001
From: Trista Hsiao <trista_hsiao@accton.com>
Date: Tue, 20 Oct 2026 08:17:24 +0800
Subject: [PATCH] netifd: re-apply bridge port settings when a kept vif changes

A config reload keeps an existing wifi vif and its bridge membership and only
updates its device settings through netifd.device_set(). The bridge port flags
(hairpin_mode, multicast_to_unicast, proxyarp_wifi, isolated) were written only
by system_bridge_addif() when the port joined the bridge, and isolated was only
ever written as 1. So a change of bridge_isolate or isolate did not reach the
kernel until the interface was recreated: client isolation stayed on after it
was turned off and stayed off after it was turned on (WIFI-15755).

Write isolated as 0 or 1 whenever it is configured, and let device_set()
re-apply the port settings to a device that already is a bridge port.

Fixes: WIFI-15755
Signed-off-by: Trista Hsiao <trista_hsiao@accton.com>
---
 .../netifd/patches/310-bridge-reapply-port-settings.patch | 96 ++++
 1 file changed, 96 insertions(+)
 create mode 100644 package/network/config/netifd/patches/310-bridge-reapply-port-settings.patch

diff --git a/package/network/config/netifd/patches/310-bridge-reapply-port-settings.patch b/package/network/config/netifd/patches/310-bridge-reapply-port-settings.patch
new file mode 100644
index 0000000000..7a2b4edac9
--- /dev/null
+++ b/package/network/config/netifd/patches/310-bridge-reapply-port-settings.patch
@@ -0,0 +1,96 @@
+--- a/system-dummy.c
++++ b/system-dummy.c
+@@ -51,6 +51,11 @@ int system_bridge_delif(struct device *bridge, struct device *dev)
+ 	return 0;
+ }
+ 
++int system_bridge_update_port(struct device *dev)
++{
++	return 0;
++}
++
+ int system_bridge_vlan(const char *iface, uint16_t vid, int16_t vid_end, bool add, unsigned int vflags)
+ {
+ 	return 0;
+--- a/system-linux.c
++++ b/system-linux.c
+@@ -1004,9 +1004,8 @@ int system_bridge_addif(struct device *bridge, struct device *dev)
+ 	    !dev->settings.unicast_flood)
+ 		system_bridge_set_unicast_flood(dev, "0");
+ 
+-	if (dev->settings.flags & DEV_OPT_ISOLATE &&
+-	    dev->settings.isolate)
+-		system_bridge_set_isolated(dev, "1");
++	if (dev->settings.flags & DEV_OPT_ISOLATE)
++		system_bridge_set_isolated(dev, dev->settings.isolate ? "1" : "0");
+ 
+ 	if (dev->bpdu_filter)
+ 		system_bridge_set_bpdu_filter(dev, dev->bpdu_filter ? "1" : "0");
+@@ -1014,6 +1013,35 @@ int system_bridge_addif(struct device *bridge, struct device *dev)
+ 	return ret;
+ }
+ 
++/*
++ * Re-apply the port settings that system_bridge_addif() writes when a port
++ * joins its bridge (the wireless flags and isolation) to a device that already
++ * is a bridge port. On a reload the wireless code keeps the vif and only
++ * updates its settings, so without this a change of e.g. bridge_isolate does
++ * not reach the kernel until the interface is recreated.
++ */
++int system_bridge_update_port(struct device *dev)
++{
++	struct device *bridge;
++	char *brname;
++
++	brname = system_get_bridge(dev->ifname, dev_buf, sizeof(dev_buf));
++	if (!brname)
++		return -ENOENT;
++
++	bridge = device_find(brname);
++	if (!bridge)
++		return -ENOENT;
++
++	if (dev->wireless)
++		system_bridge_set_wireless(bridge, dev);
++
++	if (dev->settings.flags & DEV_OPT_ISOLATE)
++		system_bridge_set_isolated(dev, dev->settings.isolate ? "1" : "0");
++
++	return 0;
++}
++
+ int system_bridge_delif(struct device *bridge, struct device *dev)
+ {
+ 	return system_bridge_if(bridge->ifname, dev, SIOCBRDELIF, NULL);
+--- a/system.h
++++ b/system.h
+@@ -246,6 +246,7 @@ int system_bridge_addbr(struct device *bridge, struct bridge_config *cfg);
+ int system_bridge_delbr(struct device *bridge);
+ int system_bridge_addif(struct device *bridge, struct device *dev);
+ int system_bridge_delif(struct device *bridge, struct device *dev);
++int system_bridge_update_port(struct device *dev);
+ int system_bridge_vlan(const char *iface, uint16_t vid, int16_t vid_end, bool add, unsigned int vflags);
+ int system_bridge_vlan_check(struct device *dev, char *ifname);
+ void system_bridge_set_stp_state(struct device *dev, bool val);
+--- a/ucode.c
++++ b/ucode.c
+@@ -17,6 +17,7 @@
+ #include "netifd.h"
+ #include "device.h"
+ #include "interface.h"
++#include "system.h"
+ #include "ucode.h"
+ 
+ static uc_vm_t vm;
+@@ -107,6 +108,11 @@ uc_netifd_device_set(uc_vm_t *vm, size_t nargs)
+ 			dev->bpdu_filter = 1;
+ 	}
+ 
++	/* a vif kept across a reload is already a bridge port: apply the new
++	 * port settings now, addif only runs when the port joins the bridge */
++	if (dev->sys_present)
++		system_bridge_update_port(dev);
++
+ 	return ucv_boolean_new(true);
+ }
+
-- 
