From 752be3edf3044c35b15f4aa1bb4a48fbd95f0f44 Mon Sep 17 00:00:00 2001
From: "crychic.tan" <crychic.tan@cybertan.com.tw>
Date: Wed, 18 Nov 2026 10:09:51 +0800
Subject: [PATCH 144/150] mediatek: mtk_ppe: don't drop WED subflows of other
 bucket entries

When a flow is about to be bound, the PPE driver drops every other flow
of the same hash bucket. For a bridged (L2) subflow that is still bound
to another entry of the bucket, this loses its counters and leaves its
hardware entry bound but untracked, so it is not invalidated when the
flow rule is removed and keeps forwarding to the old destination, for
example a station that has left.

Add a target patch that only drops the subflow of the entry that is
about to be bound, after adding its last counters to its L2 flow. This
is only done for the subflows of flows that are forwarded to or received
from a WED device, other subflows keep the previous behaviour.

The patch is only applied when building for the RAP630W-211G.

Signed-off-by: crychic.tan <crychic.tan@cybertan.com.tw>
---
 ...wed-subflows-of-other-bucket-entries.patch | 108 ++++++++++++++++++
 1 file changed, 108 insertions(+)
 create mode 100644 target/linux/mediatek/patches-6.12-sonicfi_rap630w_211g/999-2704-net-ethernet-mtk_ppe-do-not-drop-wed-subflows-of-other-bucket-entries.patch

diff --git a/target/linux/mediatek/patches-6.12-sonicfi_rap630w_211g/999-2704-net-ethernet-mtk_ppe-do-not-drop-wed-subflows-of-other-bucket-entries.patch b/target/linux/mediatek/patches-6.12-sonicfi_rap630w_211g/999-2704-net-ethernet-mtk_ppe-do-not-drop-wed-subflows-of-other-bucket-entries.patch
new file mode 100644
index 0000000000..eafac3aa58
--- /dev/null
+++ b/target/linux/mediatek/patches-6.12-sonicfi_rap630w_211g/999-2704-net-ethernet-mtk_ppe-do-not-drop-wed-subflows-of-other-bucket-entries.patch
@@ -0,0 +1,108 @@
+From: crychic.tan <crychic.tan@cybertan.com.tw>
+Subject: [PATCH] net: ethernet: mtk_ppe: don't drop WED subflows of other bucket entries
+
+When a packet of an unbound flow reaches the bind rate,
+__mtk_ppe_check_skb() walks the flows of the hash bucket of its entry and
+drops every one that does not match the new flow. An L2 subflow bound to
+another entry of the same bucket is freed as well, while its hardware
+entry stays bound. From then on the packets forwarded by that entry are
+no longer counted, and the entry is not invalidated when its L2 flow is
+removed, so it keeps forwarding to the old destination, for example a
+station that has left, until it ages out. That does not happen as long
+as packets keep arriving.
+
+With two connections whose entries fall in the same bucket, the first
+one stayed bound after all flow rules were removed in 6 of 6 tries on
+MT7981, and the flower counters showed 8-28 % of the bytes, as the
+counters already reported for the dropped subflow were lost as well.
+
+Only drop the subflow of the entry that is about to be bound, and add
+its last counters to its L2 flow. This is done in a walk of its own
+before the other flows of the bucket are handled, so that it always
+happens before anything else is bound to the entry and its counters are
+cleared. Subflows of the other entries stay tracked, and the next stats
+update drops them once they have expired. To find the L2 flow, keep a
+pointer to it in the subflow again, as before "net: ethernet:
+mtk_eth_soc: improve keeping track of offloaded flows". With this, no
+entry stayed bound after the flow rules were removed in the same 6
+tries, and the counters showed 104-105 % of the bytes (the PPE counts L2
+frames).
+
+Only do this for the subflows of flows that are forwarded to or received
+from a WED device, where it was verified. Other subflows keep the
+previous behaviour.
+
+Signed-off-by: crychic.tan <crychic.tan@cybertan.com.tw>
+---
+ drivers/net/ethernet/mediatek/mtk_ppe.c |   33 ++++++++++++++++++++++
+ drivers/net/ethernet/mediatek/mtk_ppe.h |    2 +
+ 2 files changed, 35 insertions(+)
+
+--- a/drivers/net/ethernet/mediatek/mtk_ppe.c
++++ b/drivers/net/ethernet/mediatek/mtk_ppe.c
+@@ -640,6 +640,24 @@ mtk_flow_entry_update_l2(struct mtk_ppe *ppe, struct mtk_flow_entry *entry)
+ 	}
+ }
+ 
++/* The hardware entry of an L2 subflow is about to be bound to another flow:
++ * add its last counters to the L2 flow and drop the subflow.
++ */
++static void
++mtk_flow_entry_expire_subflow(struct mtk_ppe *ppe, struct mtk_flow_entry *entry)
++{
++	struct mtk_flow_entry *l2_flow = entry->l2_flow;
++	struct mtk_foe_accounting *acct;
++
++	acct = mtk_ppe_mib_entry_read(ppe, entry->hash);
++	if (acct) {
++		l2_flow->prev_packets += acct->packets;
++		l2_flow->prev_bytes += acct->bytes;
++	}
++
++	__mtk_foe_entry_clear(ppe, entry, false);
++}
++
+ void mtk_foe_entry_get_stats(struct mtk_ppe *ppe, struct mtk_flow_entry *entry,
+ 			     int *idle)
+ {
+@@ -813,6 +831,7 @@ mtk_foe_entry_commit_subflow(struct mtk_ppe *ppe, struct mtk_flow_entry *entry,
+ 
+ 	flow_info->type = MTK_FLOW_TYPE_L2_SUBFLOW;
+ 	flow_info->wed = entry->wed;
++	flow_info->l2_flow = entry;
+ 	flow_info->hash = hash;
+ 	hlist_add_head(&flow_info->list,
+ 		       &ppe->foe_flow[hash / soc->hash_offset]);
+@@ -860,7 +879,21 @@ void __mtk_ppe_check_skb(struct mtk_ppe *ppe, struct sk_buff *skb, u16 hash)
+ 	entry_len = mtk_flow_entry_match_len(ppe->eth, hwe);
+ 	memcpy(&foe, hwe, entry_len);
+ 
++	/* Subflows of L2 flows from or to a WED device are created from their
++	 * L2 flow below. Drop the one that was bound to this entry before
++	 * anything else is bound to it, and leave the others alone: the other
++	 * entries of the bucket may still be bound to them. Other subflows
++	 * keep the previous behaviour.
++	 */
++	hlist_for_each_entry_safe(entry, n, head, list)
++		if (entry->type == MTK_FLOW_TYPE_L2_SUBFLOW && entry->wed &&
++		    entry->hash == hash)
++			mtk_flow_entry_expire_subflow(ppe, entry);
++
+ 	hlist_for_each_entry_safe(entry, n, head, list) {
++		if (entry->type == MTK_FLOW_TYPE_L2_SUBFLOW && entry->wed)
++			continue;
++
+ 		if (found ||
+ 		    !mtk_flow_entry_match(ppe->eth, entry, &foe, entry_len)) {
+ 			if (entry->hash != 0xffff)
+--- a/drivers/net/ethernet/mediatek/mtk_ppe.h
++++ b/drivers/net/ethernet/mediatek/mtk_ppe.h
+@@ -290,6 +290,8 @@ struct mtk_flow_entry {
+ 		struct {
+ 			struct hlist_node list;
+ 			struct hlist_node l2_list;
++			/* L2 flow of an L2 subflow */
++			struct mtk_flow_entry *l2_flow;
+ 		};
+ 		/* L2 flows */
+ 		struct {
