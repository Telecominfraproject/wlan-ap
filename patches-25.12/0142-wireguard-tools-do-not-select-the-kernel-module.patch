From 92da4c44b59137f3f5babd9722f376637a946b35 Mon Sep 17 00:00:00 2001
From: Trista Hsiao <trista_hsiao@accton.com>
Date: Fri, 20 Nov 2026 14:18:20 +0800
Subject: [PATCH] wireguard-tools: do not select the kernel module

Kernel 5.4 has no in-tree WireGuard, so kmod-wireguard cannot be
built there. ucentral-wireguard selects the module that matches the
target kernel: kmod-wireguard, or kmod-wireguard-backport on 5.4. This
restores the change of wlan-ap commit aa3cb952 (John Crispin), which
was dropped in e37f47c6 together with unetd's use of it.

Signed-off-by: Trista Hsiao <trista_hsiao@accton.com>
---
 package/network/utils/wireguard-tools/Makefile | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/package/network/utils/wireguard-tools/Makefile b/package/network/utils/wireguard-tools/Makefile
index 12127eb12f..a997026f0f 100644
--- a/package/network/utils/wireguard-tools/Makefile
+++ b/package/network/utils/wireguard-tools/Makefile
@@ -36,8 +36,7 @@ define Package/wireguard-tools
   TITLE:=WireGuard userspace control program (wg)
   DEPENDS:= \
 	  +!BUSYBOX_CONFIG_IP:ip \
-	  +!BUSYBOX_CONFIG_FEATURE_IP_LINK:ip \
-	  +kmod-wireguard
+	  +!BUSYBOX_CONFIG_FEATURE_IP_LINK:ip
 endef
 
 define Package/wireguard-tools/description
-- 
2.34.1

