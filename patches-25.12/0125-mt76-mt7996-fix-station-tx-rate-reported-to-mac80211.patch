From 6460ec5ed8f98aff99708a203a51662b1705bba2 Mon Sep 17 00:00:00 2001
From: "huimin.he" <huimin.he@cybertan.com.tw>
Date: Thu, 22 Oct 2026 09:20:51 +0800
Subject: [PATCH] mt76: mt7996: fix station tx rate reported to mac80211

---
 ...station-tx-rate-reported-to-mac80211.patch | 231 ++++++++++++++++++
 1 file changed, 231 insertions(+)
 create mode 100644 package/kernel/mt76/patches/0001-mt76-mt7996-fix-station-tx-rate-reported-to-mac80211.patch

diff --git a/package/kernel/mt76/patches/0001-mt76-mt7996-fix-station-tx-rate-reported-to-mac80211.patch b/package/kernel/mt76/patches/0001-mt76-mt7996-fix-station-tx-rate-reported-to-mac80211.patch
new file mode 100644
index 0000000000..07f1a1dea0
--- /dev/null
+++ b/package/kernel/mt76/patches/0001-mt76-mt7996-fix-station-tx-rate-reported-to-mac80211.patch
@@ -0,0 +1,231 @@
+mt76: mt7996: fix station tx rate reported to mac80211
+
+wcid->rate is taken from the last TXS and passed to mac80211 with every
+tx status. Only frames that request a tx status get a TXS, and most of
+those (mgmt, EAPOL, nullfunc) are sent at the fixed basic rate, so on
+2.4 GHz wcid->rate often becomes OFDM 6 Mbps for an HE station.
+
+mac80211 stores it in last_rate_info and uses it to estimate the airtime
+of every queued frame for AQL. With a legacy rate the estimate is the
+full non-aggregated 6 Mbps airtime, so AQL allows only a few frames in
+flight and downlink TCP drops from ~200 Mbps to ~50-80 Mbps until a
+data frame TXS happens to restore an HE rate.
+
+- Skip legacy-rate TXS when updating the rate of an HT/HE/EHT station.
+- Take the whole TX rate (mode, bw, mcs, nss, gi) from the periodic
+  UNI_ALL_STA_TXRX_RATE firmware report instead of only the GI, so
+  wcid->rate follows the firmware rate control. The rate conversion is
+  taken from mt7996_mcu_update_rate() in the MediaTek SDK patch
+  "mtk: mt76: rework statistics report for mt7996" (0044), TX part
+  only, with HE MCS limited to 11 as in the TXS path.
+
+Signed-off-by: huimin.he <huimin.he@cybertan.com.tw>
+
+---
+diff -Nur a/mt7996/mac.c c/mt7996/mac.c
+--- a/mt7996/mac.c	2026-10-21 17:11:06.416837162 +0800
++++ c/mt7996/mac.c	2026-10-22 09:06:44.489017310 +0800
+@@ -1544,6 +1544,10 @@
+ 		stats->tx_bw[0]++;
+ 		break;
+ 	}
++
++	if (mt7996_wcid_skip_legacy_rate(wcid, mode))
++		goto out;
++
+ 	wcid->rate = rate;
+ 
+ out:
+diff -Nur a/mt7996/mcu.c c/mt7996/mcu.c
+--- a/mt7996/mcu.c	2026-10-21 17:11:06.416837162 +0800
++++ c/mt7996/mcu.c	2026-10-22 09:06:44.493017321 +0800
+@@ -608,42 +608,138 @@
+ }
+ 
+ static int
+-mt7996_mcu_update_tx_gi(struct rate_info *rate, struct all_sta_trx_rate *mcu_rate)
++mt7996_mcu_update_rate(struct rate_info *rate, struct ieee80211_supported_band *sband,
++		       u8 mode, u8 bw, u8 mcs, u8 nss, u8 stbc, u8 gi)
+ {
+-	switch (mcu_rate->tx_mode) {
++	struct rate_info tmp_rate = {};
++
++	tmp_rate.mcs = mcs;
++	tmp_rate.nss = (stbc && nss > 1) ? nss / 2 : nss;
++
++	switch (mode) {
+ 	case MT_PHY_TYPE_CCK:
+ 	case MT_PHY_TYPE_OFDM:
++		if (!sband || mcs >= sband->n_bitrates)
++			return -EINVAL;
++
++		tmp_rate.legacy = sband->bitrates[mcs].bitrate;
+ 		break;
+ 	case MT_PHY_TYPE_HT:
+ 	case MT_PHY_TYPE_HT_GF:
++		if (mcs > 31)
++			return -EINVAL;
++
++		tmp_rate.flags |= RATE_INFO_FLAGS_MCS;
++		if (gi)
++			tmp_rate.flags |= RATE_INFO_FLAGS_SHORT_GI;
++		break;
+ 	case MT_PHY_TYPE_VHT:
+-		if (mcu_rate->tx_gi)
+-			rate->flags |= RATE_INFO_FLAGS_SHORT_GI;
+-		else
+-			rate->flags &= ~RATE_INFO_FLAGS_SHORT_GI;
++		if (mcs > 9)
++			return -EINVAL;
++
++		tmp_rate.flags |= RATE_INFO_FLAGS_VHT_MCS;
++		if (gi)
++			tmp_rate.flags |= RATE_INFO_FLAGS_SHORT_GI;
+ 		break;
+ 	case MT_PHY_TYPE_HE_SU:
+ 	case MT_PHY_TYPE_HE_EXT_SU:
+ 	case MT_PHY_TYPE_HE_TB:
+ 	case MT_PHY_TYPE_HE_MU:
+-		if (mcu_rate->tx_gi > NL80211_RATE_INFO_HE_GI_3_2)
++		tmp_rate.mcs = mcs & GENMASK(3, 0);
++		if (tmp_rate.mcs > 11 || gi > NL80211_RATE_INFO_HE_GI_3_2)
+ 			return -EINVAL;
+-		rate->he_gi = mcu_rate->tx_gi;
++
++		tmp_rate.flags |= RATE_INFO_FLAGS_HE_MCS;
++		tmp_rate.he_gi = gi;
++		tmp_rate.he_dcm = !!(mcs & MT_PRXV_TX_DCM);
+ 		break;
+ 	case MT_PHY_TYPE_EHT_SU:
+ 	case MT_PHY_TYPE_EHT_TRIG:
+ 	case MT_PHY_TYPE_EHT_MU:
+-		if (mcu_rate->tx_gi > NL80211_RATE_INFO_EHT_GI_3_2)
++		tmp_rate.mcs = mcs & GENMASK(3, 0);
++		if (tmp_rate.mcs > 13 || gi > NL80211_RATE_INFO_EHT_GI_3_2)
+ 			return -EINVAL;
+-		rate->eht_gi = mcu_rate->tx_gi;
++
++		tmp_rate.flags |= RATE_INFO_FLAGS_EHT_MCS;
++		tmp_rate.eht_gi = gi;
++		break;
++	default:
++		return -EINVAL;
++	}
++
++	switch (bw) {
++	case IEEE80211_STA_RX_BW_20:
++		tmp_rate.bw = RATE_INFO_BW_20;
++		break;
++	case IEEE80211_STA_RX_BW_40:
++		tmp_rate.bw = RATE_INFO_BW_40;
++		break;
++	case IEEE80211_STA_RX_BW_80:
++		tmp_rate.bw = RATE_INFO_BW_80;
++		break;
++	case IEEE80211_STA_RX_BW_160:
++		tmp_rate.bw = RATE_INFO_BW_160;
++		break;
++	case IEEE80211_STA_RX_BW_320:
++		tmp_rate.bw = RATE_INFO_BW_320;
+ 		break;
+ 	default:
+ 		return -EINVAL;
+ 	}
+ 
++	if (mode == MT_PHY_TYPE_HE_EXT_SU && mcs & MT_PRXV_TX_ER_SU_106T) {
++		tmp_rate.bw = RATE_INFO_BW_HE_RU;
++		tmp_rate.he_ru_alloc = NL80211_RATE_INFO_HE_RU_ALLOC_106;
++	}
++	*rate = tmp_rate;
++
+ 	return 0;
+ }
+ 
++static int
++mt7996_mcu_update_tx_rate(struct mt7996_dev *dev, struct mt76_wcid *wcid,
++			  struct all_sta_trx_rate *mcu_rate)
++{
++	struct mt76_phy *phy = mt76_dev_phy(&dev->mt76, wcid->phy_idx);
++	struct ieee80211_supported_band *sband = NULL;
++	u8 mcs = mcu_rate->tx_mcs;
++
++	if (mt7996_wcid_skip_legacy_rate(wcid, mcu_rate->tx_mode))
++		return 0;
++
++	/* nothing sent yet */
++	if (!mcu_rate->tx_nss)
++		return 0;
++
++	switch (mcu_rate->tx_mode) {
++	case MT_PHY_TYPE_CCK:
++	case MT_PHY_TYPE_OFDM:
++		if (!phy->chandef.chan)
++			return -EINVAL;
++
++		if (phy->chandef.chan->band == NL80211_BAND_2GHZ) {
++			sband = &phy->sband_2g.sband;
++			if (mcu_rate->tx_mode == MT_PHY_TYPE_OFDM)
++				mcs += 4;
++		} else if (phy->chandef.chan->band == NL80211_BAND_5GHZ) {
++			sband = &phy->sband_5g.sband;
++		} else {
++			sband = &phy->sband_6g.sband;
++		}
++		break;
++	case MT_PHY_TYPE_HT:
++	case MT_PHY_TYPE_HT_GF:
++		mcs += (mcu_rate->tx_nss - 1) << 3;
++		break;
++	default:
++		break;
++	}
++
++	return mt7996_mcu_update_rate(&wcid->rate, sband, mcu_rate->tx_mode,
++				      mcu_rate->tx_bw, mcs, mcu_rate->tx_nss,
++				      mcu_rate->tx_stbc, mcu_rate->tx_gi);
++}
++
+ static void
+ mt7996_mcu_rx_all_sta_info_event(struct mt7996_dev *dev, struct sk_buff *skb)
+ {
+@@ -667,8 +763,8 @@
+ 			if (!wcid)
+ 				break;
+ 
+-			if (mt7996_mcu_update_tx_gi(&wcid->rate, &res->rate[i]))
+-				dev_err(dev->mt76.dev, "Failed to update TX GI\n");
++			if (mt7996_mcu_update_tx_rate(dev, wcid, &res->rate[i]))
++				dev_err(dev->mt76.dev, "Failed to update TX rate\n");
+ 			break;
+ 		case UNI_ALL_STA_TXRX_ADM_STAT:
+ 			wlan_idx = le16_to_cpu(res->adm_stat[i].wlan_idx);
+diff -Nur a/mt7996/mt7996.h c/mt7996/mt7996.h
+--- a/mt7996/mt7996.h	2026-10-21 17:11:06.416837162 +0800
++++ c/mt7996/mt7996.h	2026-10-22 09:06:44.493017321 +0800
+@@ -565,6 +565,26 @@
+ 	return MT_RDD_IDX_BAND1;
+ }
+ 
++/* Frames sent at a fixed basic rate (mgmt, EAPOL, nullfunc) report a legacy
++ * rate. Don't let it override the data rate of an HT/HE/EHT station: the rate
++ * is reported to mac80211, which uses it to estimate airtime for AQL, and a
++ * 6 Mbps estimate throttles TX.
++ */
++static inline bool
++mt7996_wcid_skip_legacy_rate(struct mt76_wcid *wcid, u8 mode)
++{
++	struct ieee80211_sta *sta;
++
++	if (mode != MT_PHY_TYPE_CCK && mode != MT_PHY_TYPE_OFDM)
++		return false;
++
++	sta = wcid_to_sta(wcid);
++
++	return sta && (sta->deflink.ht_cap.ht_supported ||
++		       sta->deflink.he_cap.has_he ||
++		       sta->deflink.eht_cap.has_eht);
++}
++
+ static inline struct mt7996_dev *
+ mt7996_hw_dev(struct ieee80211_hw *hw)
+ {
-- 
2.34.1

