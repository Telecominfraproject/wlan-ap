+	compatible = "sonicfi,rap736c", "mediatek,mt7987a", "mediatek,mt7987";
+
+	mediatek,reset-boot-count;
+
+	memory@40000000 {
+		reg = <0 0x40000000 0 0x20000000>;
+	};
+
+	aliases {
+		serial0 = &uart0;
+		led-boot = &led_green;
+		led-failsafe = &led_green;
+		led-running = &led_green;
+		led-upgrade = &led_green;
+		label-mac-device = &gmac1;
