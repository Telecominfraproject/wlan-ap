diff --git a/target/linux/mediatek/patches-6.12/999-mtd-add-flash-models-for-gigadevice-and-winbond.patch b/target/linux/mediatek/patches-6.12/999-mtd-add-flash-models-for-gigadevice-and-winbond.patch
new file mode 100644
index 0000000000..37be9a3778
--- /dev/null
+++ b/target/linux/mediatek/patches-6.12/999-mtd-add-flash-models-for-gigadevice-and-winbond.patch
@@ -0,0 +1,115 @@
+diff -Nur a/drivers/mtd/nand/spi/gigadevice.c b/drivers/mtd/nand/spi/gigadevice.c
+--- a/drivers/mtd/nand/spi/gigadevice.c	2026-07-29 16:24:19.961817146 +0800
++++ b/drivers/mtd/nand/spi/gigadevice.c	2026-08-05 15:55:19.764175813 +0800
+@@ -181,6 +181,35 @@
+ 	.free = gd5fxgq4xc_ooblayout_256_free,
+ };
+ 
++static int gd5f4gm7ueyig_ooblayout_ecc(struct mtd_info *mtd, int section,
++                                 struct mtd_oob_region *region)
++{
++       if (section > 7)
++               return -ERANGE;
++
++       region->offset = 128 + (16 * section);
++       region->length = 13;
++
++       return 0;
++}
++
++static int gd5f4gm7ueyig_ooblayout_free(struct mtd_info *mtd, int section,
++                                  struct mtd_oob_region *region)
++{
++       if (section > 7)
++               return -ERANGE;
++
++       region->offset = (16 * section) + 2;
++       region->length = 14;
++
++       return 0;
++}
++
++static const struct mtd_ooblayout_ops gd5f4gm7ueyig_ooblayout = {
++       .ecc = gd5f4gm7ueyig_ooblayout_ecc,
++       .free = gd5f4gm7ueyig_ooblayout_free,
++};
++
+ static int gd5fxgq4uexxg_ecc_get_status(struct spinand_device *spinand,
+ 					u8 status)
+ {
+@@ -483,6 +512,16 @@
+ 		     SPINAND_HAS_QE_BIT,
+ 		     SPINAND_ECCINFO(&gd5fxgqx_variant2_ooblayout,
+ 				     gd5fxgq4uexxg_ecc_get_status)),
