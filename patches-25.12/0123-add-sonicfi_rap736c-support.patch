+		};
+
+		led_green: led-green {
+			label = "green:indicator";
+			pwms = <&pwm 2 1250000>;    /* PWM2, from MTK SDK RFB */
+			active-high;
+			max-brightness = <255>;
+		};
+
+		led_blue: led-blue {
+			label = "blue:indicator";
+			pwms = <&pwm 0 1250000>;    /* PWM0, from MTK SDK RFB */
