From 9e4a3c7f82b1d605e4f7a0c31d2b8e9f56a74c13 Mon Sep 17 00:00:00 2001
From: EdgeCore <dev@edge-core.com>
Date: Mon, 20 Jul 2026 00:00:00 +0800
Subject: [PATCH] netifd: handler_load read whole dump at once (shell handlers
 that leak the dump fd)

25.12 netifd's ucode wireless handler_load() runs each
/lib/netifd/wireless/*.sh via a synchronous
    system(`./<handler> "" "dump" >&<tmpfd>`)
then reads that tmpfd with `while (!f.error()) { json(trim(f.read("line"))) }`.

A wireless handler's dump is a single JSON object emitted by `jshn -w` as
ONE line WITHOUT a trailing newline. The morse HaLow shell handler also
sources the hostapd_s1g / wpa_supplicant_s1g helper stack during dump, which
leaves a background process alive that inherited the dump stdout fd. While
that write end stays open the fd never reaches EOF, so f.read("line") keeps
returning "" and NEVER yields the (newline-less) JSON line: handler_load
registers 0 objects and the morse handler is silently dropped -> radio2 never
enters netifd -> no wlan0. (mac80211 doesn't fork such a process, which is why
only morse broke.)

Proven on EAP115: `./morse.sh "" dump > /tmp/md.json` yields 9071 bytes of
valid JSON that ucode json() parses fine, but the line-by-line reader over the
same fd yields 0 lines, while f.read("all") over that fd returns the full 9071
bytes.

Fix: read the WHOLE dump at once with f.read("all") and json()-parse the
single object. This returns the data already written to the temp file
regardless of the missing newline / missing EOF, is correct for every
well-formed handler dump (mac80211 included), and is immune to fd inheritance
from shell handlers, without changing any handler behaviour or requiring a
netifd downgrade.

Signed-off-by: EdgeCore <dev@edge-core.com>
---
 .../config/netifd/files/lib/netifd/utils.uc   | 27 +++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)

diff --git a/package/network/config/netifd/files/lib/netifd/utils.uc b/package/network/config/netifd/files/lib/netifd/utils.uc
--- a/package/network/config/netifd/files/lib/netifd/utils.uc
+++ b/package/network/config/netifd/files/lib/netifd/utils.uc
@@ -55,8 +55,31 @@ export function handler_load(path, cb)
 		system(`./${script} "" "dump" >&${f.fileno()}`);
 		chdir(prev_dir);
 		f.seek();
-		while (!f.error()) {
-			let data = trim(f.read("line"));
+		//
+		// Read the WHOLE dump at once instead of line-by-line.
+		//
+		// A wireless handler's dump is a single JSON object emitted by
+		// `jshn -w` as one line WITHOUT a trailing newline. The morse HaLow
+		// handler additionally sources the hostapd_s1g/wpa_supplicant_s1g
+		// helper stack, which leaves a background process alive that inherited
+		// the dump stdout fd. With that write end still open the fd never
+		// reaches EOF, so f.read("line") keeps returning "" and NEVER yields
+		// the (newline-less) JSON line: handler_load then registers 0 objects
+		// and the morse handler is silently dropped -> radio2 never enters
+		// netifd -> no wlan0. (mac80211 doesn't fork such a process, which is
+		// why only morse broke.)
+		//
+		// f.read("all") returns the data already written to the temp file
+		// (proven on EAP115: 9071 bytes of valid morse JSON) regardless of the
+		// missing newline / missing EOF, and json() parses the single object.
+		// This is correct for every well-formed handler dump and immune to fd
+		// inheritance from shell handlers, without changing handler behaviour.
+		//
+		let raw = f.read("all");
+		f.close();
+
+		let data = trim(raw ?? "");
+		if (length(data)) {
 			try {
 				data = json(data);
 			} catch (e) {
