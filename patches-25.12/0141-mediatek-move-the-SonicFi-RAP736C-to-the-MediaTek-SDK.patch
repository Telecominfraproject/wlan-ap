From 0fdba4ae3032b137e637143d53ec90f23b19ba51 Mon Sep 17 00:00:00 2001
From: "huimin.he" <huimin.he@cybertan.com.tw>
Date: Fri, 23 Oct 2026 10:39:43 +0800
Subject: [PATCH] mediatek: move the SonicFi RAP736C to the MediaTek SDK

Build the SonicFi RAP736C with the MediaTek SDK kernel

- Include the SDK device tree (mt7987a-mtk-sdk.dtsi) instead of the
  standard one.
- The SDK pinctrl already defines uart1_pins on the uart1_2 group, so
  override its group instead of redefining the node.
- The SDK device tree enables i2c0 on GPIO 43/44, which the standard
  one leaves disabled. Keep it disabled so those pins are not muxed.
- Point HNAT at eth0, the only Ethernet port.
- Use the SDK internal 2.5G PHY driver and firmware, The firmware 
  package installs the same files as mt7987-2p5g-phy-firmware,
  so drop the latter.
- Convert the SDK WED nodes for the new WED driver: point the Ethernet
  node at wed0 with mediatek,wed, drop the old wed node and turn wed0
  into a mediatek,mt7987-wed syscon node. The SDK kernel patch
  999-wed-12-dts-mt7987-wed-changes.patch only changes the kernel tree
  copy of the device tree, which OpenWrt does not build. Without it,
  mtk_wed_add_hw() is never called, the WED hardware version reads as
  0 and mt76 disables WED ("wed version 0 not support"), so LAN to
  Wi-Fi traffic cannot be offloaded even though the SDK mt76 package
  loads mt7996e with wed_enable=1. The change is kept in the board DTS
  rather than the shared mt7987a-mtk-sdk.dtsi

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: huimin.he <huimin.he@cybertan.com.tw>
---
 .../mediatek/dts/mt7987a-sonicfi-rap736c.dts  | 40 +++++++++++++++----
 target/linux/mediatek/image/filogic.mk        |  3 +-
 2 files changed, 32 insertions(+), 11 deletions(-)

diff --git a/target/linux/mediatek/dts/mt7987a-sonicfi-rap736c.dts b/target/linux/mediatek/dts/mt7987a-sonicfi-rap736c.dts
index d6a60b4b69..f9e6bf38e1 100644
--- a/target/linux/mediatek/dts/mt7987a-sonicfi-rap736c.dts
+++ b/target/linux/mediatek/dts/mt7987a-sonicfi-rap736c.dts
@@ -1,7 +1,7 @@
 // SPDX-License-Identifier: (GPL-2.0 OR MIT)
 
 /dts-v1/;
-#include "mt7987a.dtsi"
+#include "mt7987a-mtk-sdk.dtsi"
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/leds/common.h>
 
@@ -82,7 +82,22 @@
 	};
 };
 
+/*
+ * The SDK kernel's new WED driver needs the WED node to be a
+ * mediatek,mt7987-wed syscon referenced from the Ethernet node, which
+ * 999-wed-12-dts-mt7987-wed-changes.patch only applies to the kernel
+ * tree copy of the device tree. Convert the old SDK WED nodes here so
+ * the change stays limited to this board.
+ */
+/delete-node/ &wed;
+
+&wed0 {
+	compatible = "mediatek,mt7987-wed", "syscon";
+	/delete-property/ pci_slot_map;
+};
+
 &eth {
+	mediatek,wed = <&wed0>;
 	/delete-node/ mac@0;
 	/delete-node/ mac@2;
 };
@@ -93,6 +108,14 @@
 	status = "okay";
 };
 
+&hnat {
+	mtketh-wan = "eth0";
+};
+
+&i2c0 {
+	status = "disabled";
+};
+
 &mdio {
 	phy15: phy@15 {
 		pinctrl-names = "i2p5gbe-led";
@@ -1487,15 +1510,6 @@
 	};
 };
 
-&pio {
-	uart1_pins: uart1-pins {
-		mux {
-			function = "uart";
-			groups = "uart1_0";
-		};
-	};
-};
-
 &pwm {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pwm_rgb_pins>;	/* pwm0@PIN13, pwm1_0@PIN7, pwm2_0@PIN12 */
@@ -1519,3 +1533,9 @@
 
 	status = "okay";
 };
+
+&uart1_pins {
+	mux {
+		groups = "uart1_0";
+	};
+};
diff --git a/target/linux/mediatek/image/filogic.mk b/target/linux/mediatek/image/filogic.mk
index 27e5630bd6..0597b34a77 100644
--- a/target/linux/mediatek/image/filogic.mk
+++ b/target/linux/mediatek/image/filogic.mk
@@ -1640,7 +1640,8 @@ define Device/sonicfi_rap736c
   IMAGES := sysupgrade.bin
   IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE)
   IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
-  DEVICE_PACKAGES := mt7987-2p5g-phy-firmware kmod-mt7990-firmware uboot-envtools
+  DEVICE_PACKAGES := mt798x-2p5g-phy-firmware-internal kmod-mt798x-2p5g-phy \
+	kmod-mt7990-firmware uboot-envtools
   SUPPORTED_DEVICES := sonicfi,rap736c
 endef
 TARGET_DEVICES += sonicfi_rap736c
-- 
