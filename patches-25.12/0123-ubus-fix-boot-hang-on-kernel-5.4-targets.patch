From a9c670935fcc7c4e59f995b0311224526cdcab30 Mon Sep 17 00:00:00 2001
From: Tanya Singh <tanya_singh@accton.com>
Date: Fri, 18 Sep 2026 00:00:00 +0000
Subject: [PATCH] ubus: fix boot hang on kernel 5.4 targets

The 25.12.5 baseline picked up ubus commit 24864e7840b3 ("ubusd_id: use
GRND_INSECURE to avoid blocking boot on getrandom()"). GRND_INSECURE was
added in Linux 5.6, so on the qca-wifi-6 targets (ipq50xx, ipq60xx,
ipq807x), which still run a 5.4 kernel, getrandom() fails with EINVAL.

read_random() then returns -1, ubus_alloc_id() fails for every
dynamically allocated id and ubusd rejects every incoming client. procd
retries the connection forever and never leaves its "- ubus -" stage, so
the board never reaches init and no login prompt appears. Observed on
EAP101 (IPQ6010) and EAP104 (IPQ5018); EAP105 (IPQ5332, kernel 6.6) is
unaffected.

Retry getrandom() without flags when GRND_INSECURE is rejected.
---
 ..._id-getrandom-grnd-insecure-fallback.patch | 50 +++++++++++++++++++
 1 file changed, 50 insertions(+)
 create mode 100644 package/system/ubus/patches/000-ubusd_id-getrandom-grnd-insecure-fallback.patch

diff --git a/package/system/ubus/patches/000-ubusd_id-getrandom-grnd-insecure-fallback.patch b/package/system/ubus/patches/000-ubusd_id-getrandom-grnd-insecure-fallback.patch
new file mode 100644
index 0000000000..4a6ea2ef23
--- /dev/null
+++ b/package/system/ubus/patches/000-ubusd_id-getrandom-grnd-insecure-fallback.patch
@@ -0,0 +1,50 @@
+From: Tanya Singh <tanya_singh@accton.com>
+Subject: [PATCH] ubusd_id: fall back to getrandom() flags=0 on kernels < 5.6
+
+Upstream commit 24864e7840b3 ("ubusd_id: use GRND_INSECURE to avoid
+blocking boot on getrandom()") passes GRND_INSECURE unconditionally.
+That flag only exists since Linux 5.6; older kernels reject the unknown
+flag with EINVAL. read_random() then returns -1, ubus_alloc_id() fails
+for every dynamically allocated id, and ubusd rejects every client
+connection. procd never gets past its "- ubus -" stage, so the board
+hangs before init and never reaches a login prompt.
+
+The qca-wifi-6 targets (ipq50xx, ipq60xx, ipq807x) still run a 5.4
+kernel, so retry without flags when GRND_INSECURE is not supported.
+
+--- a/ubusd_id.c
++++ b/ubusd_id.c
+@@ -15,6 +15,7 @@
+ #include <stdlib.h>
+ #include <unistd.h>
+ #include <fcntl.h>
++#include <errno.h>
+ #ifdef __linux__
+ #include <sys/random.h>
+ /* Added in Linux 5.6; define it in case the libc headers are older. */
+@@ -34,12 +35,24 @@ static int random_fd = -1;
+ static ssize_t read_random(void *buf, size_t len)
+ {
+ #ifdef __linux__
++	ssize_t ret;
++
+ 	/*
+ 	 * IDs only need to be hard to guess, not crypto-strong.
+ 	 * GRND_INSECURE returns bytes without blocking on the CRNG, so
+ 	 * ubusd does not stall boot on boards whose pool seeds late.
+ 	 */
+-	return getrandom(buf, len, GRND_INSECURE);
++	ret = getrandom(buf, len, GRND_INSECURE);
++
++	/*
++	 * GRND_INSECURE was added in Linux 5.6. Older kernels reject the
++	 * unknown flag with EINVAL, which would leave ubusd unable to
++	 * allocate any object id. Fall back to a plain getrandom() there.
++	 */
++	if (ret < 0 && errno == EINVAL)
++		ret = getrandom(buf, len, 0);
++
++	return ret;
+ #else
+ 	if (random_fd < 0) {
+ 		random_fd = open("/dev/urandom", O_RDONLY);
-- 
2.34.1

