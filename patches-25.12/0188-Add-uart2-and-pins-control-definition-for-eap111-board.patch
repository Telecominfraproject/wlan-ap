From 7c1314fcc1addad5f8dae7179ebbdf33ea5d5f18 Mon Sep 17 00:00:00 2001
From: Harrison Yeh <harrison_yeh@accton.com>
Date: Tue, 15 Sep 2026 17:34:45 +0800
Subject: [PATCH] Add uart2 and pins control definition to dts for eap111

---
 .../linux/mediatek/dts/mt7981a-edgecore-eap111.dts   | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/target/linux/mediatek/dts/mt7981a-edgecore-eap111.dts b/target/linux/mediatek/dts/mt7981a-edgecore-eap111.dts
index bfe72bd..b23c4e0 100644
--- a/target/linux/mediatek/dts/mt7981a-edgecore-eap111.dts
+++ b/target/linux/mediatek/dts/mt7981a-edgecore-eap111.dts
@@ -59,6 +59,12 @@
 	status = "okay";
 };
 
+&uart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart2_pins>;
+	status = "okay";
+};
+
 &watchdog {
 	status = "okay";
 };
@@ -70,6 +76,20 @@
 			groups = "spi0", "spi0_wp_hold";
 		};
 	};
+
+	uart1_pins: uart1-pins {
+		mux {
+			function = "uart";
+			groups = "uart1_1";
+		};
+	};
+
+ 	uart2_pins: uart2-pins {
+		mux {
+			function = "uart";
+			groups = "uart2_1";
+		};
+	};
 };
 
 &spi0 {
-- 
2.7.4

