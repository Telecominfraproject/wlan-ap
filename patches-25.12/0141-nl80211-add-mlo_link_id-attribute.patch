From 4b4322831213a756dfa5e5350253fd8e26ab669c Mon Sep 17 00:00:00 2001
From: Niko Lei <niko.lei@cybertan.com.tw>
Date: Tue, 17 Nov 2026 09:23:02 +0800
Subject: [PATCH] nl80211: add NL80211_ATTR_MLO_LINK_ID attribute

Expose NL80211_ATTR_MLO_LINK_ID as "mlo_link_id" so that ucode scripts
can read and pass the MLO link id in nl80211 messages.

Signed-off-by: Niko Lei <niko.lei@cybertan.com.tw>
---
 ...22-nl80211-add-mlo_link_id-attribute.patch | 37 +++++++++++++++++++
 1 file changed, 37 insertions(+)
 create mode 100644 package/utils/ucode/patches/122-nl80211-add-mlo_link_id-attribute.patch

diff --git a/package/utils/ucode/patches/122-nl80211-add-mlo_link_id-attribute.patch b/package/utils/ucode/patches/122-nl80211-add-mlo_link_id-attribute.patch
new file mode 100644
index 0000000000..a483972660
--- /dev/null
+++ b/package/utils/ucode/patches/122-nl80211-add-mlo_link_id-attribute.patch
@@ -0,0 +1,37 @@
+From 59afe12e7dc91f37304628dd1e707c5bda87e607 Mon Sep 17 00:00:00 2001
+From: "niko.lei" <niko.lei@cybertan.com.tw>
+Date: Mon, 16 Nov 2026 18:44:45 +0800
+Subject: [PATCH] nl80211:  add NL80211_ATTR_MLO_LINK_ID attribute
+
+Expose NL80211_ATTR_MLO_LINK_ID as "mlo_link_id" so that ucode scripts
+can read and pass the MLO link id in nl80211 messages.
+
+Signed-off-by: Niko Lei <niko.lei@cybertan.com.tw>
+---
+ lib/nl80211.c | 3 ++-
+ 1 file changed, 2 insertions(+), 1 deletion(-)
+
+diff --git a/lib/nl80211.c b/lib/nl80211.c
+index 95f49fa..dee24dc 100644
+--- a/lib/nl80211.c
++++ b/lib/nl80211.c
+@@ -978,7 +978,7 @@ static const uc_nl_nested_spec_t nl80211_mlo_link_nla = {
+ 
+ static const uc_nl_nested_spec_t nl80211_msg = {
+ 	.headsize = 0,
+-	.nattrs = 131,
++	.nattrs = 132,
+ 	.attrs = {
+ 		{ NL80211_ATTR_4ADDR, "4addr", DT_U8, 0, NULL },
+ 		{ NL80211_ATTR_AIRTIME_WEIGHT, "airtime_weight", DT_U16, 0, NULL },
+@@ -1108,6 +1108,7 @@ static const uc_nl_nested_spec_t nl80211_msg = {
+ 		{ NL80211_ATTR_SOFTWARE_IFTYPES, "software_iftypes", DT_NESTED, 0, &nl80211_ifcomb_limit_types_nla },
+ 		{ NL80211_ATTR_MAX_AP_ASSOC_STA, "max_ap_assoc", DT_U16, 0, NULL },
+ 		{ NL80211_ATTR_MLO_LINKS, "mlo_links", DT_NESTED, DF_MULTIPLE|DF_AUTOIDX, &nl80211_mlo_link_nla },
++		{ NL80211_ATTR_MLO_LINK_ID, "mlo_link_id", DT_U8, 0, NULL },
+ 		{ NL80211_ATTR_SURVEY_INFO, "survey_info", DT_NESTED, 0, &nl80211_survey_info_nla },
+ 		{ NL80211_ATTR_WIPHY_RADIOS, "radios", DT_NESTED, DF_MULTIPLE|DF_AUTOIDX, &nl80211_wiphy_radio_nla },
+ 		{ NL80211_ATTR_VIF_RADIO_MASK, "vif_radio_mask", DT_U32, 0, NULL },
+-- 
+2.34.1
+
-- 
2.34.1

