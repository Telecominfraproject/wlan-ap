From 13a3eb81f4f550aa80173c9b9d24f3cf73020b39 Mon Sep 17 00:00:00 2001
From: Sebastian Huang <sebastian_huang@accton.com>
Date: Thu, 15 Oct 2026 22:56:29 +0800
Subject: [PATCH] kernel: allow a target to add an extra patch set, files and
 config

Some targets need to build an alternative kernel, for example one
carrying a vendor SDK, for a subset of their boards while every other
board keeps the standard kernel. Today that means either forcing the
alternative kernel on all boards of the target or keeping a second
copy of the target.

Let a target point to an extra patch directory, files directory and
kernel config fragment via KERNEL_EXTRA_PATCH_DIR,
KERNEL_EXTRA_FILES_DIR and KERNEL_EXTRA_CONFIG. The extra patches are
applied after the platform patches under the platform-extra/ quilt
prefix, so "make target/linux/refresh" writes them back to their own
directory. The extra files are copied after the platform files and
the extra config is merged after the target and subtarget configs.
Both directories take part in the kernel prepare stamp, so switching
between the variants re-prepares the kernel. When reconfiguring, the
extra config is part of the base, so its symbols do not leak into the
target or subtarget config.

Targets that do not set these variables are not affected.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/kernel-build.mk | 2 +-
 include/quilt.mk        | 8 +++++---
 include/target.mk       | 8 +++++++-
 3 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/include/kernel-build.mk b/include/kernel-build.mk
index 404c318d41..adb2465e17 100644
--- a/include/kernel-build.mk
+++ b/include/kernel-build.mk
@@ -9,7 +9,7 @@ ifneq ($(DUMP),1)
   all: compile
 endif
 
-KERNEL_FILE_DEPENDS=$(GENERIC_BACKPORT_DIR) $(GENERIC_PATCH_DIR) $(GENERIC_HACK_DIR) $(PATCH_DIR) $(GENERIC_FILES_DIR) $(FILES_DIR)
+KERNEL_FILE_DEPENDS=$(GENERIC_BACKPORT_DIR) $(GENERIC_PATCH_DIR) $(GENERIC_HACK_DIR) $(PATCH_DIR) $(GENERIC_FILES_DIR) $(FILES_DIR) $(KERNEL_EXTRA_PATCH_DIR) $(KERNEL_EXTRA_FILES_DIR)
 STAMP_PREPARED=$(LINUX_DIR)/.prepared$(if $(QUILT)$(DUMP),,_$(shell $(call $(if $(CONFIG_AUTOREMOVE),find_md5_reproducible,find_md5),$(KERNEL_FILE_DEPENDS),)))
 STAMP_CONFIGURED:=$(LINUX_DIR)/.configured
 include $(INCLUDE_DIR)/download.mk
diff --git a/include/quilt.mk b/include/quilt.mk
index e57bad507c..7838c40d48 100644
--- a/include/quilt.mk
+++ b/include/quilt.mk
@@ -90,7 +90,7 @@ define Build/Patch/Default
 	$(if $(QUILT),touch $(PKG_BUILD_DIR)/.quilt_used)
 endef
 
-kernel_files=$(foreach fdir,$(GENERIC_FILES_DIR) $(FILES_DIR),$(fdir)/.)
+kernel_files=$(foreach fdir,$(GENERIC_FILES_DIR) $(FILES_DIR) $(KERNEL_EXTRA_FILES_DIR),$(fdir)/.)
 define Kernel/Patch/Default
 	$(if $(QUILT),rm -rf $(LINUX_DIR)/patches; mkdir -p $(LINUX_DIR)/patches)
 	$(if $(kernel_files),$(CP) $(kernel_files) $(LINUX_DIR)/)
@@ -103,6 +103,7 @@ define Kernel/Patch/Default
 	$(call PatchDir,$(LINUX_DIR),$(GENERIC_PATCH_DIR),generic/)
 	$(call PatchDir,$(LINUX_DIR),$(GENERIC_HACK_DIR),generic-hack/)
 	$(call PatchDir,$(LINUX_DIR),$(PATCH_DIR),platform/)
+	$(if $(KERNEL_EXTRA_PATCH_DIR),$(call PatchDir,$(LINUX_DIR),$(KERNEL_EXTRA_PATCH_DIR),platform-extra/))
 	$(if $(QUILT),touch $(LINUX_DIR)/.quilt_used)
 endef
 
@@ -126,14 +127,15 @@ define Quilt/Refresh/Package
 endef
 
 define Quilt/Refresh/Kernel
-	@[ -z "$$(grep -v '^generic/' $(PKG_BUILD_DIR)/patches/series | grep -v '^platform/')" ] || { \
-		echo "All kernel patches must start with either generic/ or platform/"; \
+	@[ -z "$$(grep -v '^generic/' $(PKG_BUILD_DIR)/patches/series | grep -v '^platform/' | grep -v '^platform-extra/')" ] || { \
+		echo "All kernel patches must start with either generic/, platform/ or platform-extra/"; \
 		false; \
 	}
 	$(call Quilt/RefreshDir,$(PKG_BUILD_DIR),$(GENERIC_BACKPORT_DIR),generic-backport/)
 	$(call Quilt/RefreshDir,$(PKG_BUILD_DIR),$(GENERIC_PATCH_DIR),generic/)
 	$(call Quilt/RefreshDir,$(PKG_BUILD_DIR),$(GENERIC_HACK_DIR),generic-hack/)
 	$(call Quilt/RefreshDir,$(PKG_BUILD_DIR),$(PATCH_DIR),platform/)
+	$(if $(KERNEL_EXTRA_PATCH_DIR),$(call Quilt/RefreshDir,$(PKG_BUILD_DIR),$(KERNEL_EXTRA_PATCH_DIR),platform-extra/))
 endef
 
 define Quilt/Template
diff --git a/include/target.mk b/include/target.mk
index 0bb0cf6156..7e68d7563c 100644
--- a/include/target.mk
+++ b/include/target.mk
@@ -194,7 +194,7 @@ ifneq ($(PLATFORM_DIR),$(PLATFORM_SUBDIR))
 endif
 
 # config file list used for compiling
-LINUX_KCONFIG_LIST = $(wildcard $(GENERIC_LINUX_CONFIG) $(LINUX_TARGET_CONFIG) $(LINUX_SUBTARGET_CONFIG) $(TOPDIR)/env/kernel-config)
+LINUX_KCONFIG_LIST = $(wildcard $(GENERIC_LINUX_CONFIG) $(LINUX_TARGET_CONFIG) $(LINUX_SUBTARGET_CONFIG) $(KERNEL_EXTRA_CONFIG) $(TOPDIR)/env/kernel-config)
 
 # default config list for reconfiguring
 # defaults to subtarget if subtarget exists and target does not
@@ -230,6 +230,12 @@ else ifneq ($(strip $(CFG_TARGET)),)
   $(error CONFIG_TARGET=$(CFG_TARGET) is invalid. Valid: target|subtarget|subtarget_target|env)
 endif
 
+# a target's optional extra kernel config is part of the base when reconfiguring,
+# so its symbols are not written into the target or subtarget config
+ifneq ($(CFG_TARGET),env)
+  LINUX_RECONFIG_LIST += $(wildcard $(KERNEL_EXTRA_CONFIG))
+endif
+
 __linux_confcmd = $(2) $(patsubst %,+,$(wordlist 2,9999,$(1))) $(1)
 
 LINUX_CONF_CMD = $(SCRIPT_DIR)/kconfig.pl $(call __linux_confcmd,$(LINUX_KCONFIG_LIST))
-- 
2.34.1

