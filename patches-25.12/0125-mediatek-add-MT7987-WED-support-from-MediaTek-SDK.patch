+ 
+ 	if (mtk_wed_device_attach(wed)) {
+ 		dev->mt76.hwrro_mode = MT76_HWRRO_OFF;
++		wed_enable = false;
+ 		return 0;
+ 	}
+ 
diff --git a/package/kernel/mt76/patches/0005-mtk-mt76-mt7996-Remove-wed_stop-during-L1-SER.patch b/package/kernel/mt76/patches/0005-mtk-mt76-mt7996-Remove-wed_stop-during-L1-SER.patch
