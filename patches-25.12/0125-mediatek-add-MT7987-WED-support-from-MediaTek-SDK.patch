--- /dev/null
+++ b/package/kernel/mt76/patches/0003-mt76-adapt-to-wpdma_tx-array-in-struct-mtk_wed_devic.patch
@@ -0,0 +1,62 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: "huimin.he" <huimin.he@cybertan.com.tw>
+Date: Thu, 24 Sep 2026 17:04:12 +0800
+Subject: [PATCH 2/8] mt76: adapt to wpdma_tx array in struct mtk_wed_device
+
+The MediaTek SDK WED patches (999-wed-10-add-mt7987-hwpath-support)
+turn mtk_wed_device.wlan.wpdma_tx into a per-queue array. Update the
+mt7915 and mt7996 WED init code accordingly.
+
+Taken from the mmio.c part of the SDK patch
+"0033-some-fixes-to-compat-with-internal" plus the matching mt7915 change.
+
+Signed-off-by: huimin.he <huimin.he@cybertan.com.tw>
+---
+ mt7915/mmio.c | 4 ++--
+ mt7996/mmio.c | 4 ++--
+ 2 files changed, 4 insertions(+), 4 deletions(-)
+
+diff --git a/mt7915/mmio.c b/mt7915/mmio.c
+index 2708b15..6e47ea2 100644
+--- a/mt7915/mmio.c
++++ b/mt7915/mmio.c
+@@ -658,7 +658,7 @@ int mt7915_mmio_wed_init(struct mt7915_dev *dev, void *pdev_ptr,
+ 				       MT_INT_WED_MASK_CSR;
+ 		wed->wlan.wpdma_phys = pci_resource_start(pci_dev, 0) +
+ 				       MT_WFDMA_EXT_CSR_BASE;
+-		wed->wlan.wpdma_tx = pci_resource_start(pci_dev, 0) +
++		wed->wlan.wpdma_tx[0] = pci_resource_start(pci_dev, 0) +
+ 				     MT_TXQ_WED_RING_BASE;
+ 		wed->wlan.wpdma_txfree = pci_resource_start(pci_dev, 0) +
+ 					 MT_RXQ_WED_RING_BASE;
+@@ -684,7 +684,7 @@ int mt7915_mmio_wed_init(struct mt7915_dev *dev, void *pdev_ptr,
+ 		wed->wlan.phy_base = res->start;
+ 		wed->wlan.wpdma_int = res->start + MT_INT_SOURCE_CSR;
+ 		wed->wlan.wpdma_mask = res->start + MT_INT_MASK_CSR;
+-		wed->wlan.wpdma_tx = res->start + MT_TXQ_WED_RING_BASE;
++		wed->wlan.wpdma_tx[0] = res->start + MT_TXQ_WED_RING_BASE;
+ 		wed->wlan.wpdma_txfree = res->start + MT_RXQ_WED_RING_BASE;
+ 		wed->wlan.wpdma_rx_glo = res->start + MT_WPDMA_GLO_CFG;
+ 		wed->wlan.wpdma_rx[0] = res->start + MT_RXQ_WED_DATA_RING_BASE;
+diff --git a/mt7996/mmio.c b/mt7996/mmio.c
+index d9780bb..52fdd00 100644
+--- a/mt7996/mmio.c
++++ b/mt7996/mmio.c
+@@ -488,7 +488,7 @@ int mt7996_mmio_wed_init(struct mt7996_dev *dev, void *pdev_ptr,
+ 				      MT_INT_PCIE1_SOURCE_CSR_EXT;
+ 		wed->wlan.wpdma_mask = wed->wlan.phy_base +
+ 				       MT_INT_PCIE1_MASK_CSR;
+-		wed->wlan.wpdma_tx = wed->wlan.phy_base + hif1_ofs +
++		wed->wlan.wpdma_tx[0] = wed->wlan.phy_base + hif1_ofs +
+ 					     MT_TXQ_RING_BASE(0) +
+ 					     MT7996_TXQ_BAND2 * MT_RING_SIZE;
+ 		if (mt7996_has_hwrro(dev)) {
+@@ -521,7 +521,7 @@ int mt7996_mmio_wed_init(struct mt7996_dev *dev, void *pdev_ptr,
+ 		wed->wlan.hw_rro = mt7996_has_hwrro(dev);
+ 		wed->wlan.wpdma_int = wed->wlan.phy_base + MT_INT_SOURCE_CSR;
+ 		wed->wlan.wpdma_mask = wed->wlan.phy_base + MT_INT_MASK_CSR;
+-		wed->wlan.wpdma_tx = wed->wlan.phy_base + MT_TXQ_RING_BASE(0) +
++		wed->wlan.wpdma_tx[0] = wed->wlan.phy_base + MT_TXQ_RING_BASE(0) +
+ 				     MT7996_TXQ_BAND0 * MT_RING_SIZE;
+ 
+ 		wed->wlan.wpdma_rx_glo = wed->wlan.phy_base + MT_WFDMA0_GLO_CFG;
diff --git a/package/kernel/mt76/patches/0004-mtk-mt76-mt7996-Fix-call-trace-happened-when-wed-att.patch b/package/kernel/mt76/patches/0004-mtk-mt76-mt7996-Fix-call-trace-happened-when-wed-att.patch
