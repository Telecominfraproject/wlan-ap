++		if ((dev->rx_wdma[i].flags & MTK_WED_RING_CONFIGURED))
++			mtk_wed_free_ring(dev, &dev->rx_wdma[i]);
+ }
+ 
+ static void
+@@ -1917,6 +1930,8 @@ mtk_wed_wdma_rx_ring_setup(struct mtk_we
