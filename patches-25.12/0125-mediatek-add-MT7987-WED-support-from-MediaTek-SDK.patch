diff --git a/package/kernel/mt76/patches/0010-mt76-mt7996-separate-host-and-WED-tx-token-ranges.patch b/package/kernel/mt76/patches/0010-mt76-mt7996-separate-host-and-WED-tx-token-ranges.patch
new file mode 100644
index 0000000000..a2a6e8c55d
--- /dev/null
+++ b/package/kernel/mt76/patches/0010-mt76-mt7996-separate-host-and-WED-tx-token-ranges.patch
@@ -0,0 +1,119 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: "huimin.he" <huimin.he@cybertan.com.tw>
+Date: Fri, 9 Oct 2026 16:00:00 +0800
+Subject: [PATCH] mt76: mt7996: separate host and WED tx token ranges
+
+Since "mt7990: add mt7987 wed hw path support", the WED TX buffer
+manager is given MT7996_WED_TOKEN_SIZE (16384) tokens, so
+wed->wlan.token_start = MT7996_TOKEN_SIZE - nbuf = 0 and WED owns
+tokens [0, 16384). The host token pool still starts at 0 with
+MT7996_TOKEN_SIZE entries, so every token used by the host overlaps
+the WED range.
+
+When the txfree event of a host frame reaches WED, WED treats the
+token as one of its own buffers. On MT7987 + MT7990 this makes WED
+stop consuming the txfree ring after a few thousand events, the ring
+fills up, the firmware can no longer report tx-done and the band0
+ALTX queue (probe responses etc.) and then beacons stall, so the SSID
+disappears shortly after boot.
+
+Do what the MediaTek SDK does (mtk-openwrt-feeds 25.12 fb7d0538, part
+of 0054-mtk-mt76-add-debug-tools.patch): keep WED tokens at
+[0, nbuf), move the host pool after it with MT7996_SW_TOKEN_SIZE
+entries, and don't let mt76_wed_offload_enable() shrink the host pool
+to wed->wlan.token_start when WED tokens sit below it. Also only count
+tokens that are really inside the WED range in wed_token_count, so
+offload_enable does not wait for host tokens.
+
+Signed-off-by: huimin.he <huimin.he@cybertan.com.tw>
+---
+ mt7996/mmio.c   | 7 +++++--
+ mt7996/mt7996.h | 2 +-
+ tx.c            | 4 +++-
+ wed.c           | 4 +++-
+ 4 files changed, 12 insertions(+), 5 deletions(-)
+
+diff --git a/mt7996/mmio.c b/mt7996/mmio.c
+index 72fb59d..c20c712 100644
+--- a/mt7996/mmio.c
++++ b/mt7996/mmio.c
+@@ -661,7 +661,7 @@ int mt7996_mmio_wed_init(struct mt7996_dev *dev, void *pdev_ptr,
+ 	}
+ 
+ 	wed->wlan.nbuf = tx_token_size;
+-	wed->wlan.token_start = MT7996_TOKEN_SIZE - wed->wlan.nbuf;
++	wed->wlan.token_start = 0;
+ 	wed->wlan.hif2 = hif2;
+ 
+ 	wed->wlan.amsdu_max_subframes = 8;
+@@ -683,6 +683,9 @@ int mt7996_mmio_wed_init(struct mt7996_dev *dev, void *pdev_ptr,
+ 		return 0;
+ 	}
+ 
++	/* WED TX BM owns tokens [0, nbuf), the host uses the range after it */
++	dev->mt76.token_start = wed->wlan.nbuf;
++
+ 	*irq = wed->irq;
+ 	dev->mt76.dma_dev = wed->dev;
+ 
+@@ -894,7 +897,7 @@ struct mt7996_dev *mt7996_mmio_probe(struct device *pdev,
+ 		.survey_flags = SURVEY_INFO_TIME_TX |
+ 				SURVEY_INFO_TIME_RX |
+ 				SURVEY_INFO_TIME_BSS_RX,
+-		.token_size = MT7996_TOKEN_SIZE,
++		.token_size = MT7996_SW_TOKEN_SIZE,
+ 		.tx_prepare_skb = mt7996_tx_prepare_skb,
+ 		.tx_complete_skb = mt76_connac_tx_complete_skb,
+ 		.rx_skb = mt7996_queue_rx_skb,
+diff --git a/mt7996/mt7996.h b/mt7996/mt7996.h
+index 2824594..98077e4 100644
+--- a/mt7996/mt7996.h
++++ b/mt7996/mt7996.h
+@@ -92,7 +92,7 @@
+ #define MT7996_EEPROM_SIZE		7680
+ #define MT7996_EEPROM_BLOCK_SIZE	16
+ #define MT7996_EXT_EEPROM_BLOCK_SIZE	1024
+-#define MT7996_TOKEN_SIZE		16384
++#define MT7996_SW_TOKEN_SIZE		15360
+ #define MT7996_HW_TOKEN_SIZE		8192
+ #define MT7996_WED_TOKEN_SIZE		16384
+ 
+diff --git a/tx.c b/tx.c
+index f971043..3f8f738 100644
+--- a/tx.c
++++ b/tx.c
+@@ -883,7 +883,8 @@ int mt76_token_consume(struct mt76_dev *dev, struct mt76_txwi_cache **ptxwi)
+ 
+ #ifdef CONFIG_NET_MEDIATEK_SOC_WED
+ 	if (mtk_wed_device_active(&dev->mmio.wed) &&
+-	    token >= dev->mmio.wed.wlan.token_start)
++	    token >= dev->mmio.wed.wlan.token_start &&
++	    token < dev->mmio.wed.wlan.token_start + dev->mmio.wed.wlan.nbuf)
+ 		dev->wed_token_count++;
+ #endif
+ 
+@@ -936,6 +937,7 @@ mt76_token_release(struct mt76_dev *dev, int token, bool *wake)
+ #ifdef CONFIG_NET_MEDIATEK_SOC_WED
+ 		if (mtk_wed_device_active(&dev->mmio.wed) &&
+ 		    token >= dev->mmio.wed.wlan.token_start &&
++		    token < dev->mmio.wed.wlan.token_start + dev->mmio.wed.wlan.nbuf &&
+ 		    --dev->wed_token_count == 0)
+ 			wake_up(&dev->tx_wait);
+ #endif
+diff --git a/wed.c b/wed.c
+index 8753cf7..060915c 100644
+--- a/wed.c
++++ b/wed.c
+@@ -83,7 +83,9 @@ int mt76_wed_offload_enable(struct mtk_wed_device *wed)
+ 	struct mt76_dev *dev = mt76_wed_to_dev(wed);
+ 
+ 	spin_lock_bh(&dev->token_lock);
+-	dev->token_size = wed->wlan.token_start;
++	/* only shrink the host token range if WED tokens sit above it */
++	if (wed->wlan.token_start > dev->token_start)
++		dev->token_size = wed->wlan.token_start;
+ 	spin_unlock_bh(&dev->token_lock);
+ 
+ 	return !wait_event_timeout(dev->tx_wait, !dev->wed_token_count, HZ);
+-- 
+2.45.2
diff --git a/target/linux/mediatek/patches-6.12/999-wed-01-fix-SER-case-call-trace-due-to-double-free-hwrro-buf.patch b/target/linux/mediatek/patches-6.12/999-wed-01-fix-SER-case-call-trace-due-to-double-free-hwrro-buf.patch
