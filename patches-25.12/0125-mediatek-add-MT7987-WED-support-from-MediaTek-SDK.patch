+@@ -578,6 +578,8 @@ struct mtk_wdma_desc {
+ #define MTK_WED_RTQM_IGRS0_I2H_PKT_CNT(_n)		(0xb2c + (_n) * 0x4)
+ #define MTK_WED_RTQM_IGRS0_FDROP_CNT			0xb34
+ 
++#define MTK_WED_RTQM_IGRS1_CFG0				0xb3c
++#define MTK_WED_RTQM_IGRS1_CFG0_DEST_FORCE		GENMASK(2, 0)
+ #define MTK_WED_RTQM_IGRS1_I2HW_DMAD_CNT		0xb44
+ #define MTK_WED_RTQM_IGRS1_I2H_DMAD_CNT(_n)		(0xb48 + (_n) * 0x4)
+ #define MTK_WED_RTQM_IGRS1_I2HW_PKT_CNT			0xb50
+@@ -623,6 +625,7 @@ struct mtk_wdma_desc {
+ #define MTK_WED_RTQM_DEQ_ERR_CNT			0xbec
+ 
+ #define MTK_WED_RROQM_GLO_CFG				0xc04
++#define MTK_WED_RROQM_GLO_CFG_BYPASS			BIT(24)
+ #define MTK_WED_RROQM_RST_IDX				0xc08
+ #define MTK_WED_RROQM_RST_IDX_MIOD			BIT(0)
+ #define MTK_WED_RROQM_RST_IDX_FDBK			BIT(4)
+-- 
+2.45.2
diff --git a/target/linux/mediatek/patches-6.12/999-wed-18-Refactor-wed-msdu-page-ring-init-flow.patch b/target/linux/mediatek/patches-6.12/999-wed-18-Refactor-wed-msdu-page-ring-init-flow.patch
new file mode 100644
index 0000000000..7b36496e40
--- /dev/null
+++ b/target/linux/mediatek/patches-6.12/999-wed-18-Refactor-wed-msdu-page-ring-init-flow.patch
@@ -0,0 +1,126 @@
+---
+[v1] net: ethernet: mtk_wed: refactor MSDU page ring initialization flow
+
+Refactor MSDU (MAC Service Data Unit) page ring initialization for
+better memory management and improved reliability.
+---
+v1: Initial MSDU page ring init refactoring.
+---
+
+From 2d633646567f6ae0d14789a4fa6fc90f759ee5d1 Mon Sep 17 00:00:00 2001
+From: Rex Lu <rex.lu@mediatek.com>
+Date: Mon, 26 Jan 2026 14:30:08 +0800
+Subject: [PATCH] Refactor wed msdu page ring init flow
+
+Signed-off-by: Rex Lu <rex.lu@mediatek.com>
+---
+ drivers/net/ethernet/mediatek/mtk_wed.c | 45 +++++++++++++++----------
+ include/linux/soc/mediatek/mtk_wed.h    |  2 ++
+ 2 files changed, 30 insertions(+), 17 deletions(-)
+
+diff --git a/drivers/net/ethernet/mediatek/mtk_wed.c b/drivers/net/ethernet/mediatek/mtk_wed.c
+index a67270d..4ae5e7b 100644
+--- a/drivers/net/ethernet/mediatek/mtk_wed.c
++++ b/drivers/net/ethernet/mediatek/mtk_wed.c
+@@ -650,7 +650,7 @@ mtk_wed_amsdu_init(struct mtk_wed_device *dev)
+ 	}
+ 
+ 	/* Kite and Eagle E1 PCIE1 tx ring 22 flow control issue */
+-	if (dev->wlan.id == 0x7991 || dev->wlan.id == 0x7992)
++	if (dev->wlan.fc_disable)
+ 		wed_clr(dev, MTK_WED_AMSDU_FIFO, MTK_WED_AMSDU_IS_PRIOR0_RING);
+ 
+ 	wed_set(dev, MTK_WED_CTRL, MTK_WED_CTRL_TX_AMSDU_EN);
+@@ -1331,7 +1331,7 @@ mtk_wed_v3_1_set_wpdma(struct mtk_wed_device *dev)
+ 
+ 	if (dev->wlan.hw_rro == MTK_WED_HWRRO_V3) {
+ 		/* RRO MSDU page rings */
+-		for (i = 0; i < MTK_WED_RX_PAGE_QUEUES; i++) {
++		for (i = 0; i < dev->wlan.pg_ring_num; i++) {
+ 			wed_w32(dev, MTK_WED_RRO_MSDU_PG_RING_CFG_CIDX(i),
+ 				dev->wlan.wpdma_rx_pg + i * 0x10 + MTK_WED_RING_OFS_CPU_IDX);
+ 			wed_w32(dev, MTK_WED_RRO_MSDU_PG_RING_CFG_DIDX(i),
+@@ -1385,7 +1385,7 @@ mtk_wed_set_wpdma(struct mtk_wed_device *dev)
+ 
+ 	wed_w32(dev, MTK_WED_RRO_RX_D_CFG(0), dev->wlan.wpdma_rx_rro[0]);
+ 	wed_w32(dev, MTK_WED_RRO_RX_D_CFG(1), dev->wlan.wpdma_rx_rro[1]);
+-	for (i = 0; i < MTK_WED_RX_PAGE_QUEUES; i++)
++	for (i = 0; i < dev->wlan.pg_ring_num; i++)
+ 		wed_w32(dev, MTK_WED_RRO_MSDU_PG_RING_CFG(i),
+ 			dev->wlan.wpdma_rx_pg + i * 0x10);
+ }
+@@ -2519,6 +2519,7 @@ static void
+ mtk_wed_start_hw_rro(struct mtk_wed_device *dev, u32 irq_mask, bool reset)
+ {
+ 	int i;
++	u32 val = 0;
+ 
+ 	wed_w32(dev, MTK_WED_WPDMA_INT_MASK, irq_mask);
+ 	wed_w32(dev, MTK_WED_INT_MASK, irq_mask);
+@@ -2558,20 +2559,30 @@ mtk_wed_start_hw_rro(struct mtk_wed_device *dev, u32 irq_mask, bool reset)
+ 			FIELD_PREP(MTK_WED_WPDMA_INT_CTRL_RX_RRO_3_1_TRIG,
+ 				   dev->wlan.rro_3_1_rx_tbit));
+ 
+-	if (dev->wlan.hw_rro == MTK_WED_HWRRO_V3)
+-		wed_w32(dev, MTK_WED_WPDMA_INT_CTRL_RRO_MSDU_PG,
+-			MTK_WED_WPDMA_INT_CTRL_RRO_PG0_EN |
+-			MTK_WED_WPDMA_INT_CTRL_RRO_PG0_CLR |
+-			MTK_WED_WPDMA_INT_CTRL_RRO_PG1_EN |
+-			MTK_WED_WPDMA_INT_CTRL_RRO_PG1_CLR |
+-			MTK_WED_WPDMA_INT_CTRL_RRO_PG2_EN |
+-			MTK_WED_WPDMA_INT_CTRL_RRO_PG2_CLR |
+-			FIELD_PREP(MTK_WED_WPDMA_INT_CTRL_RRO_PG0_DONE_TRIG,
+-				   dev->wlan.rx_pg_tbit[0]) |
+-			FIELD_PREP(MTK_WED_WPDMA_INT_CTRL_RRO_PG1_DONE_TRIG,
+-				   dev->wlan.rx_pg_tbit[1]) |
+-			FIELD_PREP(MTK_WED_WPDMA_INT_CTRL_RRO_PG2_DONE_TRIG,
+-				   dev->wlan.rx_pg_tbit[2]));
++	switch (dev->wlan.pg_ring_num) {
++	case 3:
++		val |= MTK_WED_WPDMA_INT_CTRL_RRO_PG2_EN |
++		       MTK_WED_WPDMA_INT_CTRL_RRO_PG2_CLR |
++		       MTK_WED_WPDMA_INT_CTRL_RRO_PG1_EN |
++		       MTK_WED_WPDMA_INT_CTRL_RRO_PG1_CLR |
++		       FIELD_PREP(MTK_WED_WPDMA_INT_CTRL_RRO_PG2_DONE_TRIG,
++				  dev->wlan.rx_pg_tbit[2]) |
++		       FIELD_PREP(MTK_WED_WPDMA_INT_CTRL_RRO_PG1_DONE_TRIG,
++				  dev->wlan.rx_pg_tbit[1]);
++		fallthrough;
++	case 1:
++		val |= MTK_WED_WPDMA_INT_CTRL_RRO_PG0_EN |
++		       MTK_WED_WPDMA_INT_CTRL_RRO_PG0_CLR |
++		       FIELD_PREP(MTK_WED_WPDMA_INT_CTRL_RRO_PG0_DONE_TRIG,
++				  dev->wlan.rx_pg_tbit[0]);
++		wed_w32(dev, MTK_WED_WPDMA_INT_CTRL_RRO_MSDU_PG, val);
++		break;
++	default:
++		if (dev->wlan.hw_rro == MTK_WED_HWRRO_V3)
++			dev_err(dev->hw->dev, "rx_pg_ring num %u is not valid\n",
++				dev->wlan.pg_ring_num);
++		break;
++	}
+ 
+ 	/* RRO_MSDU_PG_RING2_CFG1_FLD_DRV_EN should be enabled after
+ 	 * WM FWDL completed, otherwise RRO_MSDU_PG ring may broken
+diff --git a/include/linux/soc/mediatek/mtk_wed.h b/include/linux/soc/mediatek/mtk_wed.h
+index 6079015..75da4dd 100644
+--- a/include/linux/soc/mediatek/mtk_wed.h
++++ b/include/linux/soc/mediatek/mtk_wed.h
+@@ -171,6 +171,7 @@ struct mtk_wed_device {
+ 		enum mtk_wed_hwrro_mode hw_rro;
+ 		bool msi;
+ 		bool hif2;
++		bool fc_disable;
+ 
+ 		u16 token_start;
+ 		unsigned int nbuf;
+@@ -186,6 +187,7 @@ struct mtk_wed_device {
+ 		u8 txfree_tbit;
+ 		u8 rro_3_1_rx_tbit;
+ 		u8 amsdu_max_subframes;
++		u8 pg_ring_num;
+ 
+ 		struct {
+ 			u8 se_group_nums;
+-- 
+2.45.2
diff --git a/target/linux/mediatek/patches-6.12/999-wed-20-refactor-check-wed-module-busy-time.patch b/target/linux/mediatek/patches-6.12/999-wed-20-refactor-check-wed-module-busy-time.patch
new file mode 100644
index 0000000000..13727b5217
--- /dev/null
+++ b/target/linux/mediatek/patches-6.12/999-wed-20-refactor-check-wed-module-busy-time.patch
@@ -0,0 +1,27 @@
+From 0ac69abdc5ae24353157ec1c8fb41c051bf0da85 Mon Sep 17 00:00:00 2001
+From: Rex Lu <rex.lu@mediatek.com>
+Date: Mon, 1 Jun 2026 13:47:30 +0800
+Subject: [PATCH] refactor check wed module busy time
+
+change timeout from 1.5s to 100ms. Without this patch, L1 SER may spend 5s in heavy bi-di traffic and wed module can not go back to the idle state.
+It will cause some stations disconnect.
+---
+ drivers/net/ethernet/mediatek/mtk_wed.c | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/drivers/net/ethernet/mediatek/mtk_wed.c b/drivers/net/ethernet/mediatek/mtk_wed.c
+index 8b9243f..0c2bb61 100644
+--- a/drivers/net/ethernet/mediatek/mtk_wed.c
++++ b/drivers/net/ethernet/mediatek/mtk_wed.c
+@@ -300,7 +300,7 @@ mtk_wed_check_busy(struct mtk_wed_device *dev, u32 reg, u32 mask)
+ static int
+ mtk_wed_poll_busy(struct mtk_wed_device *dev, u32 reg, u32 mask)
+ {
+-	int sleep = 15000;
++	int sleep = 1000;
+ 	int timeout = 100 * sleep;
+ 	u32 val;
+ 
+-- 
+2.45.2
+
diff --git a/target/linux/mediatek/patches-6.12/999-wed-21-refactor-txbm-reset-flow.patch b/target/linux/mediatek/patches-6.12/999-wed-21-refactor-txbm-reset-flow.patch
new file mode 100644
index 0000000000..6f3151c7bc
--- /dev/null
+++ b/target/linux/mediatek/patches-6.12/999-wed-21-refactor-txbm-reset-flow.patch
@@ -0,0 +1,57 @@
+From f0eae81baca39cf83b351fa62fc54c8041455ede Mon Sep 17 00:00:00 2001
+From: Rex Lu <rex.lu@mediatek.com>
+Date: Fri, 12 Jun 2026 13:55:18 +0800
+Subject: [PATCH] refactor txbm reset flow
+
+add realloc txbm buff pool after wed txbm reset.
+without this patch, tx performance may decrease due to tx buff pool exist wrong data after SER
+
+Signed-off-by: Rex Lu <rex.lu@mediatek.com>
+---
+ drivers/net/ethernet/mediatek/mtk_wed.c | 19 +++++++++++++++----
+ 1 file changed, 15 insertions(+), 4 deletions(-)
+
+diff --git a/drivers/net/ethernet/mediatek/mtk_wed.c b/drivers/net/ethernet/mediatek/mtk_wed.c
+index 0c2bb61..d26d3d6 100644
+--- a/drivers/net/ethernet/mediatek/mtk_wed.c
++++ b/drivers/net/ethernet/mediatek/mtk_wed.c
+@@ -2182,21 +2182,32 @@ mtk_wed_reset_dma(struct mtk_wed_device *dev)
+ 
+ 	/* 3. reset WED TX BM */
+ 	wed_clr(dev, MTK_WED_CTRL, MTK_WED_CTRL_WED_TX_FREE_AGENT_EN);
++	mtk_wed_poll_busy(dev, MTK_WED_CTRL,
++			  MTK_WED_CTRL_WED_TX_FREE_AGENT_BUSY);
+ 
+ 	for (i = 0; i < 100; i++) {
+-		if (mtk_wed_is_v1(dev->hw))
++		if (mtk_wed_is_v1(dev->hw)) {
+ 			val = FIELD_GET(MTK_WED_TX_BM_INTF_TKFIFO_FDEP,
+ 					wed_r32(dev, MTK_WED_TX_BM_INTF));
+-		else
++			if (val == 0x40)
++				break;
++		} else {
+ 			val = FIELD_GET(MTK_WED_TX_TKID_INTF_TKFIFO_FDEP,
+ 					wed_r32(dev, MTK_WED_TX_TKID_INTF));
+-		if (val == 0x40)
+-			break;
++			if (val == 0x200)
++				break;
++		}
+ 	}
+ 
+ 	mtk_wed_reset(dev, MTK_WED_RESET_TX_FREE_AGENT);
+ 	wed_clr(dev, MTK_WED_CTRL, MTK_WED_CTRL_WED_TX_BM_EN);
+ 	mtk_wed_reset(dev, MTK_WED_RESET_TX_BM);
++	mtk_wed_poll_busy(dev, MTK_WED_CTRL, MTK_WED_CTRL_WED_TX_BM_BUSY);
++
++	if (mtk_wed_is_v3_or_greater(dev->hw)) {
++		mtk_wed_free_tx_buffer(dev);
++		mtk_wed_tx_buffer_alloc(dev);
++	}
+ 
+ 	/* 4. reset WED WPDMA tx */
+ 	mtk_wed_wpdma_tx_reset(dev);
+-- 
+2.45.2
+
diff --git a/target/linux/mediatek/patches-6.12/999-wed-22-Refactor-WDMA-RESV_BUFF-to-avoid-wdma-tx-hang.patch b/target/linux/mediatek/patches-6.12/999-wed-22-Refactor-WDMA-RESV_BUFF-to-avoid-wdma-tx-hang.patch
new file mode 100644
index 0000000000..4b034ab426
--- /dev/null
+++ b/target/linux/mediatek/patches-6.12/999-wed-22-Refactor-WDMA-RESV_BUFF-to-avoid-wdma-tx-hang.patch
@@ -0,0 +1,41 @@
+From ff5d8634a05deb2b620c1cbfacae0485f786eb17 Mon Sep 17 00:00:00 2001
+From: Rex Lu <rex.lu@mediatek.com>
+Date: Thu, 13 Aug 2026 18:43:57 +0800
+Subject: [PATCH] Refactor WDMA RESV_BUFF to avoid wdma tx hang
+
+---
+ drivers/net/ethernet/mediatek/mtk_wed.c      | 5 +++++
+ drivers/net/ethernet/mediatek/mtk_wed_regs.h | 1 +
+ 2 files changed, 6 insertions(+)
+
+diff --git a/drivers/net/ethernet/mediatek/mtk_wed.c b/drivers/net/ethernet/mediatek/mtk_wed.c
+index da7b1bb..f157a99 100644
+--- a/drivers/net/ethernet/mediatek/mtk_wed.c
++++ b/drivers/net/ethernet/mediatek/mtk_wed.c
+@@ -2487,6 +2487,11 @@ mtk_wed_dma_enable(struct mtk_wed_device *dev)
+ 		wdma_set(dev, MTK_WDMA_GLO_CFG, MTK_WDMA_GLO_CFG_TX_DMA_EN);
+ 	}
+ 
++	if (mtk_wed_is_v2(dev->hw))
++		wdma_m32(dev, MTK_WDMA_GLO_CFG,
++			 MTK_WDMA_GLO_CFG_RESV_BUFF,
++			 FIELD_PREP(MTK_WDMA_GLO_CFG_RESV_BUFF, 0x80));
++
+ 	wed_set(dev, MTK_WED_GLO_CFG,
+ 		MTK_WED_GLO_CFG_TX_DMA_EN |
+ 		MTK_WED_GLO_CFG_RX_DMA_EN);
+diff --git a/drivers/net/ethernet/mediatek/mtk_wed_regs.h b/drivers/net/ethernet/mediatek/mtk_wed_regs.h
+index 0421956..687308f 100644
+--- a/drivers/net/ethernet/mediatek/mtk_wed_regs.h
++++ b/drivers/net/ethernet/mediatek/mtk_wed_regs.h
+@@ -478,6 +478,7 @@ struct mtk_wdma_desc {
+ #define MTK_WDMA_GLO_CFG_TX_DMA_BUSY			BIT(1)
+ #define MTK_WDMA_GLO_CFG_RX_DMA_EN			BIT(2)
+ #define MTK_WDMA_GLO_CFG_RX_DMA_BUSY			BIT(3)
++#define MTK_WDMA_GLO_CFG_RESV_BUFF			GENMASK(23, 16)
+ #define MTK_WDMA_GLO_CFG_RX_INFO3_PRERES		BIT(26)
+ #define MTK_WDMA_GLO_CFG_RX_INFO2_PRERES		BIT(27)
+ #define MTK_WDMA_GLO_CFG_RX_INFO1_PRERES		BIT(28)
+-- 
+2.45.2
+
