+ 	wdma_w32(dev, MTK_WDMA_RING_TX(idx) + MTK_WED_RING_OFS_COUNT,
+@@ -2529,6 +2546,7 @@ mtk_wed_tx_ring_setup(struct mtk_wed_dev
