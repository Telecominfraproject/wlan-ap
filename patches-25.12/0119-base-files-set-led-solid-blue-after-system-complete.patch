From ca12dea8acd3c4515104266a5d892ec5879848a8 Mon Sep 17 00:00:00 2001
From: "jemmy.lin" <jemmy.lin@cybertan.com.tw>
Date: Fri, 31 Jul 2026 19:50:48 +0800
Subject: [PATCH] base-files: set led to solid-blue after system complete

---
 package/base-files/files/etc/init.d/led | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/package/base-files/files/etc/init.d/led b/package/base-files/files/etc/init.d/led
index 79f9388705..99703fc1ed 100755
--- a/package/base-files/files/etc/init.d/led
+++ b/package/base-files/files/etc/init.d/led
@@ -106,11 +106,6 @@ load_led() {
 		[ "$default" = 0 ] &&
 			echo 0 >/sys/class/leds/${sysfs}/brightness
 
-		[ "$default" = 1 ] && {
-			[ -z "$brightness" ] && brightness="$(cat /sys/class/leds/${sysfs}/max_brightness)"
-			echo "$brightness" > /sys/class/leds/${sysfs}/brightness
-		}
-
 		led_color_set "$1" "$sysfs"
 
 		echo $trigger > /sys/class/leds/${sysfs}/trigger 2> /dev/null
@@ -118,7 +113,13 @@ load_led() {
 		[ $ret = 0 ] || {
 			echo >&2 "Skipping trigger '$trigger' for led '$name' due to missing kernel module"
 			return 1
+		}	
+	
+		[ "$default" = 1 ] && {
+			[ -z "$brightness" ] && brightness="$(cat /sys/class/leds/${sysfs}/max_brightness)"
+			echo "$brightness" > /sys/class/leds/${sysfs}/brightness
 		}
+
 		case "$trigger" in
 		"heartbeat")
 			echo "${inverted}" > "/sys/class/leds/${sysfs}/invert"
-- 
2.34.1

