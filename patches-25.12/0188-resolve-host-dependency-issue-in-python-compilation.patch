++    license_files=['LICENSE'],
+     author='Max Countryman',
+     author_email='maxc@me.com',
+     description='An updated CSRF extension for Flask.',
+@@ -30,7 +31,6 @@ setup(
+         'Development Status :: 4 - Beta',
+         'Environment :: Web Environment',
