diff --git a/package/lang/python/python-lxml/test.sh b/package/lang/python/python-lxml/test.sh
new file mode 100644
index 0000000..e175d92
--- /dev/null
+++ b/package/lang/python/python-lxml/test.sh
@@ -0,0 +1,29 @@
+#!/bin/sh
+
+EXP_VER="$2"
+
+python3 - << EOF
+import lxml
+import sys
+
+if (lxml.__version__) != "$EXP_VER":
+    print("Wrong version: " + lxml.__version__)
+    sys.exit(1)
+
+from lxml import etree
+
+root = etree.Element("root")
+root.append(etree.Element("child1"))
+root.append(etree.Element("child2"))
+root.append(etree.Element("child3"))
+
+exp_str = "b'<root><child1/><child2/><child3/></root>'"
+got_str = str(etree.tostring(root))
+if (got_str != exp_str):
+    print("Expected: '" + exp_str + "' . Got: '" + got_str + "'")
+else:
+    print("OK")
+
+sys.exit(0)
+EOF
+
