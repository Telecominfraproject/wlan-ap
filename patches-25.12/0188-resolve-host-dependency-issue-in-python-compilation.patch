diff --git a/package/lang/python/python-certifi/test.sh b/package/lang/python/python-certifi/test.sh
new file mode 100644
index 0000000..b280216
--- /dev/null
+++ b/package/lang/python/python-certifi/test.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+
+case "$1" in
+	*-src)
+		;;
+	python3-certifi)
+		BUNDLE=$(python3 -m certifi) || {
+			echo "Failed to run the certfi module script.  Exit status=$?." >&2
+			echo "Output='$BUNDLE'" >&2
+			exit 1
+		}
+		ls -l "$BUNDLE"
+		;;
+	*)
+		echo "Unexpected package '$1'" >&2
+		exit 1
+		;;
+esac
