From ea66d7a1dcd1679941418a21f465113073d6a307 Mon Sep 17 00:00:00 2001
From: "javen.hu" <javen.hu@cybertan.com.tw>
Date: Wed, 11 Nov 2026 17:26:26 +0800
Subject: [PATCH] package/linux: add dsa RTL8372N switch compile option

added support for dsa RTL8372N ethernet switch controller for IPQ5332 linux kernel.
---
 package/kernel/linux/modules/netdevices.mk | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/package/kernel/linux/modules/netdevices.mk b/package/kernel/linux/modules/netdevices.mk
index 6ec2851264..02cfde0949 100644
--- a/package/kernel/linux/modules/netdevices.mk
+++ b/package/kernel/linux/modules/netdevices.mk
@@ -822,6 +822,25 @@ endef
 $(eval $(call KernelPackage,dsa-rtl8366rb))
 
 
+define KernelPackage/dsa-rtl8373
+  SUBMENU:=$(NETWORK_DEVICES_MENU)
+  TITLE:=Kernel driver for RTL8372N DSA
+  DEPENDS:=@TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx_64||TARGET_ipq_ipq50xx||TARGET_ipq50xx||TARGET_ipq95xx||TARGET_ipq53xx||TARGET_ipq54xx
+  KCONFIG:=CONFIG_NET_DSA_REALTEK_RTL8373 \
+	CONFIG_NET_DSA_REALTEK_RTL8373_SMI=y \
+	CONFIG_NET_DSA_REALTEK_RTL8373_PHY=y \
+	CONFIG_NET_DSA_REALTEK_RTL8373_I2C=n \
+	CONFIG_NET_DSA_REALTEK_RTL8373_EXTPHY=n
+  FILES:=$(LINUX_DIR)/drivers/net/dsa/rtl8373/rtl8373_dsa.ko
+  AUTOLOAD:=$(call AutoLoad,42,rtl8373_dsa)
+endef
+
+define KernelPackage/rtl8373/description
+Kernel driver for REALTEK DSA RTL8373
+endef
+
+$(eval $(call KernelPackage,dsa-rtl8373))
+
 define KernelPackage/dsa-rtl8365mb
   SUBMENU:=$(NETWORK_DEVICES_MENU)
   TITLE:=Realtek RTL8365MB switch DSA support
-- 
2.34.1

