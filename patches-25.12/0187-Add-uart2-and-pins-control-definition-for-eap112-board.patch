From caa01ef4ae15a5e5cae5a4eb6d937041c2ef9224 Mon Sep 17 00:00:00 2001
From: Harrison Yeh <harrison_yeh@accton.com>
Date: Fri, 21 Aug 2026 17:17:34 +0800
Subject: [PATCH] Add uart2 and pins control definition to dts for eap112

---
 .../linux/mediatek/dts/mt7981a-edgecore-eap112.dts   | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/target/linux/mediatek/dts/mt7981a-edgecore-eap112.dts b/target/linux/mediatek/dts/mt7981a-edgecore-eap112.dts
index 93cdf70..f69ddaf 100644
--- a/target/linux/mediatek/dts/mt7981a-edgecore-eap112.dts
+++ b/target/linux/mediatek/dts/mt7981a-edgecore-eap112.dts
@@ -59,6 +59,12 @@
 	status = "okay";
 };
 
+&uart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart2_pins>;
+	status = "okay";
+};
+
 &watchdog {
 	status = "okay";
 };
@@ -89,6 +95,20 @@
 			mediatek,pull-down-adv = <3>;
 		};
 	};
+
+	uart1_pins: uart1-pins {
+		mux {
+			function = "uart";
+			groups = "uart1_1";
+		};
+	};
+
+    uart2_pins: uart2-pins {
+		mux {
+			function = "uart";
+			groups = "uart2_1";
+		};
+	};
 };
 
 &spi0 {
-- 
2.7.4

