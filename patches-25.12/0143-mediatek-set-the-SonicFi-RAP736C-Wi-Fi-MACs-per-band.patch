From 5f9ee488ac621f24b4fa900c6fd3569f328566c2 Mon Sep 17 00:00:00 2001
From: "huimin.he" <huimin.he@cybertan.com.tw>
Date: Thu, 26 Nov 2026 15:39:12 +0800
Subject: [PATCH] mediatek: set the SonicFi RAP736C Wi-Fi MACs per band

The MT7987 Wi-Fi on the RAP736C is a single wiphy with one radio per
band. mt7996 does not fill wiphy->addresses, so the phy only exposes
its own MAC and wifi-scripts derives the 5 GHz radio MAC from it
(locally administered, first octet flipped, +32), instead of using
an address taken from ethaddr.

Set the per-band base MACs in board.json with
ucidef_set_wireless_macaddr_base, so that 2.4 GHz uses ethaddr + 1 and
5 GHz uses ethaddr + 2, and set the phy MAC to ethaddr + 1 to match.

This needs the MediaTek SDK wifi-scripts to copy macaddr_base from
board.json into the wifi-device section.

Fixes: WIFI-15835
Signed-off-by: huimin.he <huimin.he@cybertan.com.tw>
---
 .../linux/mediatek/filogic/base-files/etc/board.d/02_network   | 3 ++-
 .../filogic/base-files/etc/hotplug.d/ieee80211/11_fix_wifi_mac | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/target/linux/mediatek/filogic/base-files/etc/board.d/02_network b/target/linux/mediatek/filogic/base-files/etc/board.d/02_network
index 7927727209..c524cfd7c0 100644
--- a/target/linux/mediatek/filogic/base-files/etc/board.d/02_network
+++ b/target/linux/mediatek/filogic/base-files/etc/board.d/02_network
@@ -346,8 +346,9 @@ mediatek_setup_macs()
 		;;
 	sonicfi,rap736c)
 		wan_mac=$(mtd_get_mac_ascii u-boot-env ethaddr)
-		lan_mac=$(macaddr_add "$wan_mac" 1)
 		label_mac=$wan_mac
+		ucidef_set_wireless_macaddr_base 2g $(macaddr_add "$wan_mac" 1)
+		ucidef_set_wireless_macaddr_base 5g $(macaddr_add "$wan_mac" 2)
 		;;
 	sonicfi,rap630w-211g)
 		local mac sysfs="/sys/class/ieee80211"
diff --git a/target/linux/mediatek/filogic/base-files/etc/hotplug.d/ieee80211/11_fix_wifi_mac b/target/linux/mediatek/filogic/base-files/etc/hotplug.d/ieee80211/11_fix_wifi_mac
index a040ff8581..17e34099c3 100644
--- a/target/linux/mediatek/filogic/base-files/etc/hotplug.d/ieee80211/11_fix_wifi_mac
+++ b/target/linux/mediatek/filogic/base-files/etc/hotplug.d/ieee80211/11_fix_wifi_mac
@@ -264,6 +264,6 @@ case "$board" in
 		;;
 	sonicfi,rap736c)
 		addr=$(mtd_get_mac_ascii u-boot-env ethaddr)
-		[ "$PHYNBR" = "0" ] && macaddr_add $addr 2 > /sys${DEVPATH}/macaddress
+		[ "$PHYNBR" = "0" ] && macaddr_add $addr 1 > /sys${DEVPATH}/macaddress
 		;;
 esac
