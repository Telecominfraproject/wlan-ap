From b74da9b60c3c2b009322df7f874b49897137414a Mon Sep 17 00:00:00 2001
From: Tanya Singh <tanya_singh@accton.com>
Date: Fri, 18 Sep 2026 00:00:00 +0000
Subject: [PATCH] Revert "base-files: move config_generate to preinit"

This reverts upstream commit 2a8b27fab9c8e8bf67ff8a0c341b06a8c68453cf,
which landed in v25.12.5. It moves board file generation out of
/etc/init.d/boot into a new /lib/preinit/82_config_generate hook.

Our ethernet drivers (nss-dp and friends) are kernel modules loaded by
kmodloader from /etc/modules.d, which runs in /etc/init.d/boot. Preinit
has only loaded /etc/modules-boot.d, so no ethernet netdev exists yet
when the hook runs.

Every board.d/02_network we ship derives its MAC addresses by reading a
netdev, including the default arm of the case statement:

	*)
		wan_mac=$(cat /sys/class/net/eth0/address)
		lan_mac=$(macaddr_add "$wan_mac" 1)

So this is not specific to any one vendor or board. It affects all five
targets that ship a board file generator - ipq50xx, ipq60xx, ipq807x,
ipq53xx and ipq54xx - and on each of them every board that does not
have an explicit branch sourcing the MAC from flash. Boards with a
named netdev branch include glinet,b3000, emplus,wap386v2,
yuncore,ax840, yuncore,fap650, sercomm,ap72tip, sercomm,ap72tip-v4,
sonicfi,rap750e-s, sonicfi,rap750w-311a and edgecore,eap105. Only the
boards that read 0:APPSBLENV, 0:ART or the kernel command line are
unaffected.

The cat yields an empty string, and macaddr_add() then evaluates
$((0x + 1 & 0xffffff)) and dies. Because that sits inside a command
substitution it kills only the subshell, so board_detect carries on and
still writes board.json - just without wireless_macaddr_base or the
lan, wan and label MACs. The failure is silent apart from "arithmetic
syntax error" lines on the console.

Radios then fall back to caldata or synthesised addresses, some BSSes
are not created at all, and affected radios come up with no channel and
no tx power. Observed on EAP105 (2G and 5G down, 6G up), EAP101 and
EAP104.

Restore the previous ordering so board_detect runs after kmodloader.

The longer term fix is to stop sourcing the base MAC from a netdev in
board.d and read it from flash instead, which would let the upstream
ordering stand.

Fixes: WIFI-15714
Signed-off-by: Tanya Singh <tanya_singh@accton.com>
---
 package/base-files/files/etc/init.d/boot        | 17 ++++++++++++-----
 .../files/lib/preinit/82_config_generate        | 16 ----------------
 .../etc/hotplug.d/ieee80211/10-wifi-detect      |  2 +-
 .../network/config/wifi-scripts/files/sbin/wifi |  1 +
 4 files changed, 14 insertions(+), 22 deletions(-)
 delete mode 100644 package/base-files/files/lib/preinit/82_config_generate

diff --git a/package/base-files/files/etc/init.d/boot b/package/base-files/files/etc/init.d/boot
index 174fead3ec..ab25c11129 100755
--- a/package/base-files/files/etc/init.d/boot
+++ b/package/base-files/files/etc/init.d/boot
@@ -43,15 +43,22 @@ boot() {
 	grep -q pstore /proc/filesystems && /bin/mount -o nosuid,nodev,noexec,noatime -t pstore pstore /sys/fs/pstore
 	[ "$FAILSAFE" = "true" ] && touch /tmp/.failsafe
 
-	# update wifi config before additional ieee80211 hotplug events
-	# get executed because of '/sbin/kmodloader' kmod loading.
-	[ -f /etc/board.json ] && /sbin/wifi config
-
+	touch /tmp/.config_pending
 	/sbin/kmodloader
 
+	[ ! -f /etc/config/wireless ] && {
+		# compat for bcm47xx and mvebu
+		sleep 1
+	}
+
+	mkdir -p /tmp/.uci
+	[ -f /etc/uci-defaults/30_uboot-envtools ] && (. /etc/uci-defaults/30_uboot-envtools)
+	/bin/config_generate
+	rm -f /tmp/.config_pending
+	/sbin/wifi config
 	uci_apply_defaults
 	sync
-
+	
 	# temporary hack until configd exists
 	/sbin/reload_config
 }
diff --git a/package/base-files/files/lib/preinit/82_config_generate b/package/base-files/files/lib/preinit/82_config_generate
deleted file mode 100644
index e40448d10f..0000000000
--- a/package/base-files/files/lib/preinit/82_config_generate
+++ /dev/null
@@ -1,16 +0,0 @@
-do_config_generate() {
-	[ -f /etc/board.json ] || {
-		# This allows /etc/board.d/* scripts to use values from the uboot environment
-		mkdir -p /tmp/.uci
-		[ -f /etc/uci-defaults/30_uboot-envtools ] && (. /etc/uci-defaults/30_uboot-envtools)
-
-		echo "- generating board file -"
-		/bin/board_detect /tmp/board.json
-		mv /tmp/board.json /etc/board.json
-
-		/bin/config_generate > /dev/null
-	}
-}
-
-boot_hook_add preinit_main do_config_generate
-boot_hook_add initramfs do_config_generate
diff --git a/package/network/config/wifi-scripts/files/etc/hotplug.d/ieee80211/10-wifi-detect b/package/network/config/wifi-scripts/files/etc/hotplug.d/ieee80211/10-wifi-detect
index a9d5f701bb..64eeb7235b 100644
--- a/package/network/config/wifi-scripts/files/etc/hotplug.d/ieee80211/10-wifi-detect
+++ b/package/network/config/wifi-scripts/files/etc/hotplug.d/ieee80211/10-wifi-detect
@@ -1,6 +1,6 @@
 #!/bin/sh
 
-[ "${ACTION}" = "add" ] && [ -f /etc/board.json ] && {
+[ "${ACTION}" = "add" ] && {
 	/sbin/wifi config
 	ubus call network.wireless retry
 }
diff --git a/package/network/config/wifi-scripts/files/sbin/wifi b/package/network/config/wifi-scripts/files/sbin/wifi
index 67a3ec7b40..c70723560b 100755
--- a/package/network/config/wifi-scripts/files/sbin/wifi
+++ b/package/network/config/wifi-scripts/files/sbin/wifi
@@ -62,6 +62,7 @@ wifi_detect_notice() {
 }
 
 wifi_config() {
+	[ -e /tmp/.config_pending ] && return
 	ucode /usr/share/hostap/wifi-detect.uc
 	[ ! -f /etc/config/wireless ] && touch /etc/config/wireless
 	ucode /lib/wifi/mac80211.uc | uci -q batch
-- 
2.34.1

