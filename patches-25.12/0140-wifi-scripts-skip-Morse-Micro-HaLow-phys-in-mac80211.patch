From 1f5ed357d9f9706ea9ef6fb1dde40152dcf793cf Mon Sep 17 00:00:00 2001
From: Firas Shaari <firas.shaari@shaariconsultancy.com>
Date: Fri, 16 Oct 2026 00:54:46 -0400
Subject: [PATCH] wifi-scripts: skip Morse Micro HaLow phys in mac80211
 detection

The Morse Micro HaLow driver registers an S1G phy that mac80211 reports
as a 5 GHz band, so wifi config creates a second, bogus wifi-device of
type mac80211 for it next to the section created by the morse driver
script. The renderer then binds either section by path and, depending
on which one comes first, configures a 2.4 GHz or HaLow radio onto the
wrong phy, and hostapd fails with "Could not select hw_mode and
channel".

Leave phys whose driver is a morse driver to the morse wireless script,
as the Morse Micro OpenWrt tree does.

Signed-off-by: Firas Shaari <firas.shaari@shaariconsultancy.com>
---
 .../network/config/wifi-scripts/files/lib/wifi/mac80211.uc | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc b/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc
index ef6ce8bca6..595a0dc074 100644
--- a/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc
+++ b/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc
@@ -1,5 +1,5 @@
 #!/usr/bin/env ucode
-import { readfile } from "fs";
+import { readfile, realpath } from "fs";
 import * as uci from 'uci';
 
 const bands_order = [ "6G", "5G", "2G" ];
@@ -32,6 +32,11 @@ function radio_exists(path, macaddr, phy, radio) {
 }
 
 for (let phy_name, phy in board.wlan) {
+	/* Morse Micro HaLow phys are configured by the morse driver script */
+	let driver_path = realpath("/sys/class/ieee80211/" + phy_name + "/device/driver/");
+	if (driver_path && match(driver_path, /morse/))
+		continue;
+
 	let info = phy.info;
 	if (!info || !length(info.bands))
 		continue;
