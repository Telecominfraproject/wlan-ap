#!/bin/sh /etc/rc.common

START=99

USE_PROCD=1

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "rogueap"
}

start_service() {
	interval=$(uci get rogueap.@config[-1].interval)
	[ -z "$interval" ] && return

	if [ -d "/sys/module/ath12k" ]; then
		PROG="/usr/share/rogueap/rogueap-wifi7.uc"
	else
		PROG="/usr/share/rogueap/rogueap-wifi6.uc"
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
