#!/bin/sh

# uCentral renders its configuration on top of /etc/config-shadow. When the
# shadow copy predates this package (it is only created on first boot), add
# the sshguard config to it so the ssh template can enable the daemon.
[ -d /etc/config-shadow ] && [ ! -f /etc/config-shadow/sshguard ] && \
	cp /etc/config/sshguard /etc/config-shadow/sshguard

exit 0
