config sshguard 'main'
	# rendered by the uCentral ssh service template (services.ssh)
	option enabled '0'
	# failures from one source within 'window' minutes before blocking
	option failures '9'
	option window '10'
	# minutes a source stays blocked on the SSH port
	option ban_time '10'
	# nftables sets in table 'inet <table>' created by the ssh template
	option table 'fw4'
	option set4 'ssh_ban4'
	option set6 'ssh_ban6'
