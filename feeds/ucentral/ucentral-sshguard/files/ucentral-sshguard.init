#!/bin/sh /etc/rc.common

START=81

USE_PROCD=1
PROG=/usr/sbin/ucentral-sshguard

start_service() {
	config_load sshguard
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	# named like the service: uCentral's 'no-restart' check looks it up
	procd_open_instance ucentral-sshguard
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sshguard
}

reload_service() {
	# starts or stops the instance when "enabled" changed ...
	start
	# ... and lets a running daemon pick up new thresholds
	ubus -t 2 call sshguard reload >/dev/null 2>&1
}
