From 962a6fc3acf1ba70aba3be87bab07233e0d3eb47 Mon Sep 17 00:00:00 2001
From: "crychic.tan" <crychic.tan@cybertan.com.tw>
Date: Wed, 18 Nov 2026 09:05:08 +0800
Subject: [PATCH] device: leave packets with foreign VLAN tags to the
 bridge

A tag that is not a VLAN tag of the bridge is part of the payload for
the bridge: without VLAN filtering every tag is, and with VLAN filtering
a tag of the other VLAN protocol is, e.g. the 802.1ad tag of a QinQ
packet on an 802.1Q bridge. The bridge forwards such packets unchanged,
in the PVID for the latter.

device_vlan_get_input() maps them to VLAN 0 or the PVID, and as the key
of the flow has a tag that the output VLAN does not have,
bridger_offload() pops it. Once such a flow is offloaded, QinQ packets
lose their outer tag and leave with the inner 802.1Q tag as their VLAN
tag, and tagged packets lose their tag on bridges without VLAN
filtering.

Return -1 for these packets, so that they are not offloaded and the
bridge keeps handling them.

Signed-off-by: crychic.tan <crychic.tan@cybertan.com.tw>
---
 device.c | 19 ++++++++++++++++---
 1 file changed, 16 insertions(+), 3 deletions(-)

diff --git a/device.c b/device.c
index 631026c..b17f02a 100644
--- a/device.c
+++ b/device.c
@@ -79,12 +79,25 @@ int device_vlan_get_input(struct device *dev, uint16_t bpf_vlan)
 	struct bridge *br = device_get_br(dev);
 	int i;
 
-	if (!br || !br->vlan_enabled)
+	if (!br)
 		return 0;
 
-	if (!(bpf_vlan & BRIDGER_VLAN_PRESENT) ||
+	/*
+	 * A tag that is not a VLAN tag of the bridge is part of the payload
+	 * for the bridge, which forwards it unchanged: any tag without VLAN
+	 * filtering, and a tag of the other VLAN protocol, e.g. the 802.1ad
+	 * tag of a QinQ packet on an 802.1Q bridge. The offload path would
+	 * pop it, so leave such packets to the bridge.
+	 */
+	if (!br->vlan_enabled)
+		return (bpf_vlan & BRIDGER_VLAN_PRESENT) ? -1 : 0;
+
+	if ((bpf_vlan & BRIDGER_VLAN_PRESENT) &&
 	    !!(bpf_vlan & BRIDGER_VLAN_TYPE_AD) !=
-	    (br->vlan_proto == ETH_P_8021AD)) {
+	    (br->vlan_proto == ETH_P_8021AD))
+		return -1;
+
+	if (!(bpf_vlan & BRIDGER_VLAN_PRESENT)) {
 		if (!dev->pvid)
 			return -1;
 
