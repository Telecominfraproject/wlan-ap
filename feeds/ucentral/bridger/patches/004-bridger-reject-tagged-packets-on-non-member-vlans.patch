From 15c52e587f979d38a9e1fb20cfaadc8226c0329a Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Tue, 21 Oct 2025 10:39:57 +0000
Subject: [PATCH] bridger: reject tagged packets on non-member VLANs

Return error from device_vlan_get_input for non-member VLANs instead of PVID.
Prevents FDB lookup confusion when same MAC exists on multiple VLANs.

Signed-off-by: Felix Fietkau <nbd@nbd.name>

[backport of upstream bridger commit f994af459375 ("bridger: reject
tagged packets on non-member VLANs")]

The bridge drops tagged packets of a VLAN that the ingress port is not a
member of. bridger mapped them to the PVID of the port instead, so once
a flow between two hosts known in the PVID was offloaded, such packets
were forwarded into the PVID with their tag popped.
---
 device.c | 2 +-
 flow.c   | 3 +++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/device.c b/device.c
index 274236c..64470fd 100644
--- a/device.c
+++ b/device.c
@@ -92,7 +92,7 @@ int device_vlan_get_input(struct device *dev, uint16_t bpf_vlan)
 		if (bpf_vlan == dev->vlan[i].id)
 			return bpf_vlan;
 
-	return dev->pvid;
+	return -1;
 }
 
 uint16_t device_vlan_get_output(struct device *dev, int vid)
diff --git a/flow.c b/flow.c
index 63bd0ce..564983b 100644
--- a/flow.c
+++ b/flow.c
@@ -77,6 +77,9 @@ void bridger_check_pending_flow(struct bridger_flow_key *key,
 
 	memcpy(fkey.addr, key->src, ETH_ALEN);
 	fkey.vlan = device_vlan_get_input(dev, key->vlan);
+	if (fkey.vlan == (uint16_t)-1)
+		return;
+
 	fdb_in = fdb_get(br, &fkey);
 
 	if (dev->redirect_dev) {
-- 
