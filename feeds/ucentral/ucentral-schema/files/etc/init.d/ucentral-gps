#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

. /lib/functions.sh

# On OAP101/OAP101E the GPS module and the BLE MCU share one UART
# (/dev/ttyMSM1), selected by ble_enable (tlmm 30):
#   ble_enable=1 -> BLE owns the UART
#   ble_enable=0 -> GPS owns the UART
# ble-provisiond must not run while GPS owns the UART, otherwise it parses
# NMEA as BLE frames and its commands reach the GPS module.

ble_stop() {
	[ -x /etc/init.d/ble-provision ] && /etc/init.d/ble-provision stop
}

ble_start() {
	[ -x /etc/init.d/ble-provision ] && /etc/init.d/ble-provision start
}

gps_enable() {
	case "$(board_name)" in
	"edgecore,oap101"|\
	"edgecore,oap101e")
		# Release /dev/ttyMSM1 before handing the UART to GPS.
		ble_stop
		echo 0 > /sys/class/gpio/ble_enable/value
		echo 1 > /sys/class/gpio/gps_reset/value
		sleep 1
		echo 0 > /sys/class/gpio/gps_reset/value
		sleep 1
		# enable PAIR message to include Packet Type: 062 with GST (8 = NMEA_SEN_GST )
		echo "\$PAIR062,8,1*37" > /dev/ttyMSM1
		;;
	esac
}

gps_disable() {
	case "$(board_name)" in
	"edgecore,oap101"|\
	"edgecore,oap101e")
		echo 1 > /sys/class/gpio/gps_reset/value
		echo 1 > /sys/class/gpio/ble_enable/value
		# The UART is back on the BLE side; (re)start BLE.
		ble_start
		;;
	esac
}

start_service() {
	local disabled=$(uci -q get gps.@gps[-1].disabled)
	if [ "$disabled" = "1" ]; then
		gps_disable
	else
		gps_enable
	fi
}

# Re-run the switch whenever /etc/config/gps changes (e.g. a uCentral
# apply that turns GPS on or off), so no reboot is needed.
service_triggers() {
	procd_add_reload_trigger "gps"
}

reload_service() {
	start_service
}
