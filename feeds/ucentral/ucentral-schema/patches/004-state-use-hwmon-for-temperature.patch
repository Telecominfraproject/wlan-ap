From: Sujeet Kumar <sujeet.kumar@inventum.net>
Date: Tue, 6 Oct 2026 09:30:00 +0000
Subject: [PATCH] state: read unit temperature from hwmon instead of thermal_zone

This platform has no SoC/CPU thermal-zone node, so /sys/class/thermal
is empty and state.unit.temperature is never populated. The two
ath10k wifi radios each expose a real reading at
/sys/class/hwmon/hwmon*/temp1_input, so use those as the temperature
source instead.

Signed-off-by: Sujeet Kumar <sujeet.kumar@inventum.net>
---
--- a/system/state.uc
+++ b/system/state.uc
@@ -208,7 +208,7 @@
 for (let l = 0; l < 3; l++)
 	state.unit.load[l] /= 65535.0;
 
-let thermal = fs.glob('/sys/class/thermal/thermal_zone*/temp');
+let thermal = fs.glob('/sys/class/hwmon/hwmon*/temp1_input');
 if (length(thermal) > 0) {
 	let temps = [];
 	for (let t in thermal) {
