# /etc/copp_template.nft
# CoPP Traffic Control Template for __IFACE__

add table netdev traffic_control

# Delete old chain first (add + delete combination to prevent errors when chain doesn't exist on first run)
add chain netdev traffic_control __IFACE__
delete chain netdev traffic_control __IFACE__

# Recreate clean chain and bind to specific interface
add chain netdev traffic_control __IFACE__ { type filter hook ingress device "__IFACE__" priority -500; policy accept; }

# 1. ARP rate limit 1000 pps
add rule netdev traffic_control __IFACE__ ether type arp limit rate 1000/second burst 100 packets counter accept comment "Limit ARP"
add rule netdev traffic_control __IFACE__ ether type arp counter drop comment "Drop excess ARP storm"

# 2. DHCP rate limit 1000 pps
add rule netdev traffic_control __IFACE__ udp dport 67-68 limit rate 1000/second burst 100 packets counter accept comment "Limit DHCP"
add rule netdev traffic_control __IFACE__ udp dport 67-68 counter drop comment "Drop excess DHCP storm"

# 3. Multicast/Broadcast rate limit 1000 pps
add rule netdev traffic_control __IFACE__ ip daddr 224.0.0.0/4 limit rate 1000/second burst 100 packets counter accept comment "Limit MC"
add rule netdev traffic_control __IFACE__ ip daddr 224.0.0.0/4 counter drop comment "Drop excess MC storm"

add rule netdev traffic_control __IFACE__ ip daddr 255.255.255.255 limit rate 1000/second burst 100 packets counter accept comment "Limit BC"
add rule netdev traffic_control __IFACE__ ip daddr 255.255.255.255 counter drop comment "Drop excess BC storm"
