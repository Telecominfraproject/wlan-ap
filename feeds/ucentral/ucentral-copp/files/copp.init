#!/bin/sh /etc/rc.common

START=80

USE_PROCD=1

copp_ruleset_add() {
	local interface="$1"   # i.e. up0v0, down1v0, admin-ui

	config_get_bool enable "$interface" enable 0

	if [ "$enable" = "1" ]; then
		sed "s/__IFACE__/${interface}/g" /etc/copp_template.nft > /tmp/etc/copp_${interface}.nft

		if [ -d "/sys/class/net/$interface" ] && [ -s "/tmp/etc/copp_${interface}.nft" ]; then
			logger -t copp "service: applying netdev CoPP ruleset for $interface"
			nft -f "/tmp/etc/copp_${interface}.nft"
		else
			logger -t copp "service: skip $interface"
		fi
	fi
}

start_service() {
	logger -t copp "service: starting"
	config_load copp
	config_foreach copp_ruleset_add interface
}

service_triggers() {
    procd_add_reload_trigger "copp"
}
