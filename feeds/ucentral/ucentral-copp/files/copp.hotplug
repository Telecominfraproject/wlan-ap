#!/bin/sh

# logger -t copp "hotplug: ${DEVICENAME}: net hotplug triggered with ACTION=${ACTION}"

case "$DEVICENAME" in
    up*|down*|admin-ui)
        ;;
    *)
        exit 0
        ;;
esac

[ "$ACTION" = "add" ] || exit 0

nft_file="/tmp/etc/copp_${DEVICENAME}.nft"

if [ -s "$nft_file" ]; then
    logger -t copp "hotplug: applying netdev CoPP ruleset for $DEVICENAME"
    nft -f "$nft_file"
fi
