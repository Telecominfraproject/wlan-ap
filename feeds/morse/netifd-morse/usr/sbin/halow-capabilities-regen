#!/bin/sh
#
# halow-capabilities-regen - Update /etc/ucentral/capabilities.json to reflect
# the CURRENT HaLow (Morse) dongle state, and nudge one state cycle so the
# change is visible to the cloud within seconds (not minutes). Called from
# the ieee80211 hotplug handlers. [ECCLOUD-10057]
#
# Intentionally minimal:
#   - Regenerates capabilities.json (matters for both cloud and standalone;
#     the ecAPP BLE/CGI reads the file directly).
#   - Forks ONE state.uc run. This is the same script ucentral-state runs
#     periodically; running it once out-of-cycle emits an immediate
#     telemetry frame so the cloud sees the radio list change now instead
#     of waiting for the next stats.interval tick (which can be 60-300s).
#   - Does NOT restart ucentral or reload wifi. Restarting ucentral would
#     force a full reconnect and race the in-flight cloud config apply,
#     which we've seen corrupt radio/SSID bindings on this device.
#   - flock serialises concurrent plug/unplug events.

LOCK=/tmp/halow-cap.lock
CAP=/etc/ucentral/capabilities.json

(
	flock -x 9 || { logger -t halow-cap "flock failed, aborting"; exit 1; }

	mkdir -p /etc/ucentral/
	rm -f "$CAP"
	/usr/share/ucentral/capabilities.uc
	rc=$?

	if [ "$rc" = "0" ] && [ -f "$CAP" ]; then
		if grep -qi 'halow\|s1g' "$CAP"; then
			state="HaLow=present"
		else
			state="HaLow=absent"
		fi
		logger -t halow-cap "capabilities.json OK ($state)"
	else
		logger -t halow-cap "capabilities.uc FAILED (exit=$rc, file=$([ -f "$CAP" ] && echo yes || echo no))"
	fi

	# Nudge one telemetry cycle so cloud sees the new radio list quickly.
	# Use `ucode` explicitly (state.uc may not be marked executable in every
	# ucentral-schema build). Run in background so we don't hold the flock
	# while state.uc walks the whole radio state.
	if pidof ucentral >/dev/null 2>&1; then
		( /usr/bin/ucode /usr/share/ucentral/state.uc >/dev/null 2>&1 ) &
		logger -t halow-cap "nudged state.uc for immediate telemetry push"
	else
		logger -t halow-cap "ucentral not running (standalone), skipping state.uc nudge"
	fi
) 9>"$LOCK"
