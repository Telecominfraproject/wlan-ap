#!/bin/sh
#
# halow-capabilities-sync - periodic watchdog to catch races where the
# ieee80211 hotplug handler ran before the morse firmware/debugfs was
# ready (so capabilities.json ended up without HaLow even though the
# dongle is plugged), or where a hotplug uevent was lost entirely.
# Runs from cron every minute. [ECCLOUD-10057]
#
# Cheap by design: it only inspects sysfs and greps a small JSON file.
# When the two states agree (the common case) it exits immediately.
# Only when they disagree does it invoke halow-capabilities-regen.

# Is a morse PHY currently present?
morse_present=0
for p in /sys/class/ieee80211/phy*; do
	[ -e "$p" ] || continue
	drv=$(readlink -f "$p/device/driver" 2>/dev/null)
	case "${drv##*/}" in
	morse_*) morse_present=1; break ;;
	esac
done

# Does capabilities.json advertise a HaLow / s1g radio?
cap_has_halow=0
if [ -f /etc/ucentral/capabilities.json ]; then
	if grep -qi 'halow\|s1g' /etc/ucentral/capabilities.json; then
		cap_has_halow=1
	fi
fi

# States agree - nothing to do (the common path).
[ "$morse_present" = "$cap_has_halow" ] && exit 0

logger -t halow-sync "state mismatch: morse_present=$morse_present cap_has_halow=$cap_has_halow, triggering regen"
/usr/sbin/halow-capabilities-regen
