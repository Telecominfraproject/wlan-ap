#!/bin/sh /etc/rc.common
#
# Deferred boot-time sync for HaLow capabilities.
#
# The ieee80211 hotplug handler (30-morse-detect) fires the moment the
# morse PHY is registered, which on some boots is BEFORE the debugfs
# node /sys/kernel/debug/ieee80211/phyN/morse is populated. In that
# window capabilities.uc's scan_morse_phys() sees no morse PHY and
# writes a capabilities.json without HaLow, even though the dongle is
# plugged. The 1-minute cron eventually catches this, but a device
# owner watching the console during first boot sees a stale file for
# up to 60s.
#
# This service fires ONCE, ~20s after boot completes (long enough for
# firmware/debugfs to settle, well before the first cron tick), by
# calling halow-capabilities-sync. If everything is already in sync
# the sync script exits immediately (cheap).

# Run after ucentral (START=99) so any capabilities.json it wrote is
# already on disk by the time we double-check it.
START=99

# Only makes sense on the EAP115 family; on other boards nothing to do.
boot() {
	. /lib/functions.sh
	case "$(board_name)" in
	edgecore,eap115|\
	edgecore,eap115a) ;;
	*) return 0 ;;
	esac

	# Fire in background so we do not block procd bring-up.
	( sleep 20; /usr/sbin/halow-capabilities-sync ) &
}
