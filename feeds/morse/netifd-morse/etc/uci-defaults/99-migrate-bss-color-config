#!/bin/sh

. /lib/functions.sh

# Older netifd-morse read bss_color from the wifi-device and applied it with
# morse_cli. The current script reads s1g_bss_color from each wifi-iface and
# passes it to hostapd_s1g, so move the value to the interfaces of that radio.

_set_bss_color_for_wifi_iface() {
local iface="$1"
local device="$2"
local bss_color="$3"
local device_config s1g_bss_color

config_get device_config "$iface" device
config_get s1g_bss_color "$iface" s1g_bss_color
if [ "$device_config" = "$device" ] && [ -z "$s1g_bss_color" ]; then
uci set wireless."${iface}".s1g_bss_color="$bss_color"
fi
}

_get_bss_color_from_each_device() {
local config="$1"
local type bss_color

config_get type "$config" type
[ "$type" = "morse" ] || return 0

config_get bss_color "$config" bss_color
[ -n "$bss_color" ] || return 0

config_foreach _set_bss_color_for_wifi_iface wifi-iface "$config" "$bss_color"
uci -q delete wireless."${config}".bss_color
}

config_load wireless
config_foreach _get_bss_color_from_each_device wifi-device
uci -q commit wireless

exit 0
