#!/bin/sh
#
# Install a per-minute cron entry that runs halow-capabilities-sync on
# EAP115/EAP115a. Catches boot-time races where capabilities.json ended
# up out of sync with the actual HaLow dongle state.

. /lib/functions.sh

case "$(board_name)" in
edgecore,eap115|\
edgecore,eap115a) ;;
*) exit 0 ;;
esac

CRON_LINE="* * * * * /usr/sbin/halow-capabilities-sync"

mkdir -p /etc/crontabs
touch /etc/crontabs/root

# Idempotent: only insert if the line isn't already there.
if ! grep -qxF "$CRON_LINE" /etc/crontabs/root; then
	echo "$CRON_LINE" >> /etc/crontabs/root
	# Reload cron so the new entry is picked up without reboot.
	/etc/init.d/cron reload 2>/dev/null || /etc/init.d/cron restart 2>/dev/null || true
fi

exit 0
