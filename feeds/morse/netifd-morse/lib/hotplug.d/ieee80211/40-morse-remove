#!/bin/sh
#
# Handle Morse Micro HaLow PHY removal on USB hotplug (dongle unplug).
# Triggered when an ieee80211 PHY is unregistered.
#
# Conservative behaviour:
#   1) Only act on ACTION=remove.
#   2) If any morse PHY is still present in sysfs, this remove event was
#      for something else (e.g. one of the 2G/5G phys) - do nothing.
#   3) The dongle really is gone: mark every morse-type radio as
#      disabled=1. Do NOT delete the section: keep radioN stable across
#      plug/unplug so cloud SSID bindings (device=radio2) stay valid.
#   4) Regenerate capabilities.json so HaLow is no longer advertised.
#      Do NOT restart ucentral; the next state cycle picks it up.

[ "$ACTION" = "remove" ] || exit 0

# Is any morse PHY still present?
for _p in /sys/class/ieee80211/phy*; do
	[ -e "$_p" ] || continue
	_drv=$(readlink -f "$_p/device/driver" 2>/dev/null)
	case "${_drv##*/}" in
	morse_*) exit 0 ;;
	esac
done

logger -t morse-hotplug "no morse PHY left, disabling morse radios"

# No morse PHY left. Mark morse radios disabled (keep the section).
_changed=0
_i=0
while [ "$(uci -q get wireless.radio${_i}.type)" != "" ]; do
	if [ "$(uci -q get wireless.radio${_i}.type)" = "morse" ]; then
		if [ "$(uci -q get wireless.radio${_i}.disabled)" != "1" ]; then
			uci -q set wireless.radio${_i}.disabled=1
			logger -t morse-hotplug "Disabled wireless.radio${_i} (morse dongle removed)"
			_changed=1
		fi
	fi
	_i=$((_i + 1))
done
[ "$_changed" = "1" ] && uci -q commit wireless

[ -x /usr/sbin/halow-capabilities-regen ] && /usr/sbin/halow-capabilities-regen
