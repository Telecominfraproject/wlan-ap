mac80211 6.18 compat: adapt to ieee80211_twt_params union + control flag rename

Linux 6.18 restructured struct ieee80211_twt_params: the individual-TWT
fields (twt, min_twt_dur, mantissa, channel) moved into an anonymous union
member '.indiv' (with a sibling '.bcast' for broadcast TWT). It also
renamed IEEE80211_TWT_CONTROL_RESP_MODE to
IEEE80211_TWT_CONTROL_RESPONDER_PM_MODE.

The morse driver only implements individual TWT, so every params.<field>
access maps to the .indiv sub-struct. Add a version-gated accessor
MM_TWT_INDIV(p) that yields &(p)->indiv on 6.18+ and (p) on older
mac80211 (where the fields are top-level), and route the affected field
accesses through it. req_type stays top-level in both layouts and is left
untouched. Also alias the renamed control flag so MORSE_TWT_CTRL_SUP()
keeps resolving.

Build-level compatibility fix for Linux 6.18; TWT is not exercised by the
default HaLow AP/STA bring-up, and Morse officially supports up to 6.12.

Signed-off-by: EdgeCore <dev@edge-core.com>

--- a/twt.c
+++ b/twt.c
@@ -18,6 +18,23 @@
 #define TWT_SETUP_CMD_UNKNOWN	(8)
 #define TWT_WAKE_DUR_UNIT_256	(256)
 
+/*
+ * mac80211 6.18 moved the individual-TWT fields of struct
+ * ieee80211_twt_params (twt, min_twt_dur, mantissa, channel) into an
+ * anonymous union member '.indiv'. The morse driver only uses individual
+ * TWT, so route every affected field access through this accessor: it
+ * yields the .indiv sub-struct on 6.18+ and the struct itself otherwise.
+ */
+#if KERNEL_VERSION(6, 18, 0) <= MAC80211_VERSION_CODE
+#define MM_TWT_INDIV(p)		(&(p)->indiv)
+#ifndef IEEE80211_TWT_CONTROL_RESP_MODE
+/* Renamed in 6.18; alias so MORSE_TWT_CTRL_SUP(..., RESP_MODE) resolves. */
+#define IEEE80211_TWT_CONTROL_RESP_MODE	IEEE80211_TWT_CONTROL_RESPONDER_PM_MODE
+#endif
+#else
+#define MM_TWT_INDIV(p)		(p)
+#endif
+
 #define MORSE_TWT_DBG(_m, _f, _a...)		morse_dbg(FEATURE_ID_TWT, _m, _f, ##_a)
 #define MORSE_TWT_INFO(_m, _f, _a...)		morse_info(FEATURE_ID_TWT, _m, _f, ##_a)
 #define MORSE_TWT_WARN(_m, _f, _a...)		morse_warn(FEATURE_ID_TWT, _m, _f, ##_a)
@@ -81,5 +98,5 @@ static u64 morse_twt_calculate_wake_interval_us(struct ieee80211_twt_params *par
 	u16 exp = (le16_to_cpu(params->req_type) & IEEE80211_TWT_REQTYPE_WAKE_INT_EXP) >>
 	    IEEE80211_TWT_REQTYPE_WAKE_INT_EXP_OFFSET;
 
-	return (u64)le16_to_cpu(params->mantissa) * (1 << exp);
+	return (u64)le16_to_cpu(MM_TWT_INDIV(params)->mantissa) * (1 << exp);
 }
@@ -122,10 +141,10 @@ static void morse_twt_update_params(struct ieee80211_twt_params *params,
 	u16 mantissa;
 
-	params->twt = cpu_to_le64(wake_time_us);
+	MM_TWT_INDIV(params)->twt = cpu_to_le64(wake_time_us);
 	mantissa = div_u64(wake_interval_us, (1 << exp));
-	params->mantissa = cpu_to_le16(mantissa);
+	MM_TWT_INDIV(params)->mantissa = cpu_to_le16(mantissa);
 	if (MORSE_TWT_CTRL_SUP(control, WAKE_DUR_UNIT))
-		params->min_twt_dur = MORSE_US_TO_TU(wake_duration_us);
+		MM_TWT_INDIV(params)->min_twt_dur = MORSE_US_TO_TU(wake_duration_us);
 	else
-		params->min_twt_dur = wake_duration_us / TWT_WAKE_DUR_UNIT_256;
+		MM_TWT_INDIV(params)->min_twt_dur = wake_duration_us / TWT_WAKE_DUR_UNIT_256;
 }
@@ -1944,7 +1963,7 @@ static int morse_twt_validate_params(struct morse *mors, u8 control,
 		return -EINVAL;
 	}
 
-	if (params->channel > 0) {
+	if (MM_TWT_INDIV(params)->channel > 0) {
 		MORSE_TWT_WARN(mors, "TWT channel unsupported\n");
 		return -EINVAL;
 	}
@@ -2003,9 +2022,9 @@ static int morse_twt_parse_ie(struct morse *mors, struct dot11ah_ies_mask *ies_m
 	ether_addr_copy(event->addr, src_addr);
 	event->flow_id = flow_id;
-	agr_data->wake_time_us = le64_to_cpu(agr_data->params.twt);
+	agr_data->wake_time_us = le64_to_cpu(MM_TWT_INDIV(&agr_data->params)->twt);
 	agr_data->wake_interval_us = morse_twt_calculate_wake_interval_us(&agr_data->params);
 
 	if (MORSE_TWT_CTRL_SUP(control, WAKE_DUR_UNIT))
-		agr_data->wake_duration_us = MORSE_TU_TO_US(agr_data->params.min_twt_dur);
+		agr_data->wake_duration_us = MORSE_TU_TO_US(MM_TWT_INDIV(&agr_data->params)->min_twt_dur);
 	else
-		agr_data->wake_duration_us = agr_data->params.min_twt_dur * TWT_WAKE_DUR_UNIT_256;
+		agr_data->wake_duration_us = MM_TWT_INDIV(&agr_data->params)->min_twt_dur * TWT_WAKE_DUR_UNIT_256;
@@ -2169,5 +2186,5 @@ static int morse_twt_configure_agreement(struct morse *mors, struct morse_vif *m
 		/* Send cmd to fw */
 		if (req_set_twt)
-			agreement->params.twt = req_set_twt->target_wake_time;
+			MM_TWT_INDIV(&agreement->params)->twt = req_set_twt->target_wake_time;
 
 		ret = morse_cmd_twt_agreement_install_req(mors, agreement, vif_id);
@@ -2237,23 +2256,23 @@ static int morse_twt_process_set_cmd(struct morse *mors, struct morse_vif *mors_
 	if (req_set_twt->opcode == MORSE_CMD_TWT_CONF_OP_CONFIGURE_EXPLICIT) {
-		agreement->params.mantissa =
+		MM_TWT_INDIV(&agreement->params)->mantissa =
 		    req_set_twt->wake_interval.explicit_twt.wake_interval_mantissa;
 		exponent = req_set_twt->wake_interval.explicit_twt.wake_interval_exponent;
 		agreement->wake_interval_us =
-		    twt_calculate_wake_interval(le16_to_cpu(agreement->params.mantissa), exponent);
+		    twt_calculate_wake_interval(le16_to_cpu(MM_TWT_INDIV(&agreement->params)->mantissa), exponent);
 	} else {
 		agreement->wake_interval_us =
 		    twt_calculate_wake_interval_fields(le64_to_cpu(*wake_interval_us),
-						       &agreement->params.mantissa, &exponent);
+						       &MM_TWT_INDIV(&agreement->params)->mantissa, &exponent);
 	}
 
 	agreement->wake_duration_us = le32_to_cpu(req_set_twt->wake_duration_us);
-	agreement->params.min_twt_dur = twt_calculate_wake_duration(agreement->wake_duration_us);
+	MM_TWT_INDIV(&agreement->params)->min_twt_dur = twt_calculate_wake_duration(agreement->wake_duration_us);
 	agreement->params.req_type |=
 	    cpu_to_le16(req_set_twt->flow_id <<
 	    (IEEE80211_TWT_REQTYPE_FLOWID_OFFSET) & IEEE80211_TWT_REQTYPE_FLOWID);
 	agreement->params.req_type |= cpu_to_le16((exponent <<
 		IEEE80211_TWT_REQTYPE_WAKE_INT_EXP_OFFSET) & IEEE80211_TWT_REQTYPE_WAKE_INT_EXP);
 
 	MORSE_TWT_DBG(mors, "TWT config dur:%d mant:%d exp:%d wake_int:%lld req:0x%x\n",
-		      agreement->params.min_twt_dur, agreement->params.mantissa,
+		      MM_TWT_INDIV(&agreement->params)->min_twt_dur, MM_TWT_INDIV(&agreement->params)->mantissa,
 		      exponent, agreement->wake_interval_us, agreement->params.req_type);
@@ -2331,21 +2350,21 @@ int morse_twt_initialise_agreement(struct morse_twt_agreement_data *twt_data, u8
 	memcpy((agreement + TWT_AGREEMENT_WAKE_DURATION_OFFSET),
-	       &twt_data->params.min_twt_dur, sizeof(twt_data->params.min_twt_dur));
-	agreement_len += sizeof(twt_data->params.min_twt_dur);
+	       &MM_TWT_INDIV(&twt_data->params)->min_twt_dur, sizeof(MM_TWT_INDIV(&twt_data->params)->min_twt_dur));
+	agreement_len += sizeof(MM_TWT_INDIV(&twt_data->params)->min_twt_dur);
 
 	memcpy((agreement + TWT_AGREEMENT_WAKE_INTERVAL_MANTISSA_OFFSET),
-	       &twt_data->params.mantissa, sizeof(twt_data->params.mantissa));
-	agreement_len += sizeof(twt_data->params.mantissa);
+	       &MM_TWT_INDIV(&twt_data->params)->mantissa, sizeof(MM_TWT_INDIV(&twt_data->params)->mantissa));
+	agreement_len += sizeof(MM_TWT_INDIV(&twt_data->params)->mantissa);
 
 	/* Fill remainder of fields for the request and copy to agreement */
 	twt_data->params.req_type |= cpu_to_le16(IEEE80211_TWT_REQTYPE_IMPLICIT);
 	memcpy((agreement + TWT_AGREEMENT_REQUEST_TYPE_OFFSET),
 	       &twt_data->params.req_type, sizeof(twt_data->params.req_type));
 	agreement_len += sizeof(twt_data->params.req_type);
 
 	/* Copy the target wake time. Currently twt value is always present */
 	memcpy((agreement + TWT_AGREEMENT_TARGET_WAKE_TIME_OFFSET),
-	       &twt_data->params.twt, sizeof(twt_data->params.twt));
-	agreement_len += sizeof(twt_data->params.twt);
+	       &MM_TWT_INDIV(&twt_data->params)->twt, sizeof(MM_TWT_INDIV(&twt_data->params)->twt));
+	agreement_len += sizeof(MM_TWT_INDIV(&twt_data->params)->twt);
 
-	return agreement_len + sizeof(twt_data->control) + sizeof(twt_data->params.channel);
+	return agreement_len + sizeof(twt_data->control) + sizeof(MM_TWT_INDIV(&twt_data->params)->channel);
 }
