morse: drop BAR frames in TX path

MM8108 firmware crashes on BAR frames. Drop them at TX entry.

Signed-off-by: EdgeCore <dev@edge-core.com>

--- a/mac.c
+++ b/mac.c
@@ -2158,6 +2158,13 @@ static void morse_mac_ops_tx(struct ieee
 	struct morse_skb_tx_info tx_info = { 0 };
 	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
 	bool is_mgmt = (hdr && ieee80211_is_mgmt(hdr->frame_control));
+
+	if (hdr && ieee80211_is_back_req(hdr->frame_control)) {
+		pr_info_ratelimited("morse: drop BAR to %pM\n", hdr->addr1);
+		ieee80211_free_txskb(hw, skb);
+		return;
+	}
+
 	const int op_bw_mhz = mors->custom_configs.channel_info.op_bw_mhz;
 	int tx_bw_mhz = op_bw_mhz;
 	struct ieee80211_sta *sta = NULL;
