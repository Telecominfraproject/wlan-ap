From c880dca41e43d083db9a6de8e117505a2f7f08e9 Mon Sep 17 00:00:00 2001
From: Morse Micro <support@morsemicro.com>
Subject: [PATCH] dpp: increase the DPP command buffer size

Taken verbatim from the Morse Micro OpenWrt feed, which is the vendor
porting template for this platform.
Upstream ships this file as a plain diff with no From line, so the hash above
is the real commit of the feed that carries it (a feed commit, not a hostap
commit).
  repo   : https://github.com/MorseMicro/morse-feed
  commit : c880dca41e43d083db9a6de8e117505a2f7f08e9
           (pinned by github.com/MorseMicro/openwrt tag 3.0.2)
  path   : essentials/hostapd_s1g/patches/mm61x/0004-Increase-dpp-cmd-buffer-size.patch

Bumps the buffer that holds a DPP config/PKEX command in both the AP and the
supplicant. Chip-independent; kept because the vendor applies it to the same
hostap revision this package pins (mm6108-2.0.1).

Original patch content follows unmodified.

diff --git a/src/ap/dpp_hostapd.c b/src/ap/dpp_hostapd.c
index 3b245689a..40cfc7801 100644
--- a/src/ap/dpp_hostapd.c
+++ b/src/ap/dpp_hostapd.c
@@ -339,7 +339,7 @@ static int hostapd_dpp_pkex_done(void *ctx, void *conn,
 				 struct dpp_bootstrap_info *peer_bi)
 {
 	struct hostapd_data *hapd = ctx;
-	char cmd[500];
+	char cmd[4096];
 	const char *pos;
 	u8 allowed_roles = DPP_CAPAB_CONFIGURATOR;
 	struct dpp_bootstrap_info *own_bi = NULL;
@@ -2445,7 +2445,7 @@ hostapd_dpp_rx_pkex_commit_reveal_resp(struct hostapd_data *hapd, const u8 *src,
 	int res;
 	struct dpp_bootstrap_info *bi;
 	struct dpp_pkex *pkex = hapd->dpp_pkex;
-	char cmd[500];
+	char cmd[4096];
 
 	eloop_cancel_timeout(hostapd_dpp_pkex_retry_timeout, hapd, NULL);
 	wpa_printf(MSG_DEBUG, "DPP: PKEX Commit-Reveal Response from " MACSTR,
@@ -2514,7 +2514,7 @@ static void hostapd_dpp_pb_pkex_init(struct hostapd_data *hapd,
 	struct dpp_pkex *pkex;
 	struct wpabuf *msg;
 	char ssid_hex[2 * SSID_MAX_LEN + 1], *pass_hex = NULL;
-	char cmd[300];
+	char cmd[4096];
 	const char *password = NULL;
 #ifdef CONFIG_SAE
 	struct sae_password_entry *e;
diff --git a/wpa_supplicant/dpp_supplicant.c b/wpa_supplicant/dpp_supplicant.c
index 97e48fc87..5fc8b9310 100644
--- a/wpa_supplicant/dpp_supplicant.c
+++ b/wpa_supplicant/dpp_supplicant.c
@@ -3063,7 +3063,7 @@ static int wpas_dpp_pkex_done(void *ctx, void *conn,
 			      struct dpp_bootstrap_info *peer_bi)
 {
 	struct wpa_supplicant *wpa_s = ctx;
-	char cmd[500];
+	char cmd[4096];
 	const char *pos;
 	u8 allowed_roles = DPP_CAPAB_CONFIGURATOR;
 	struct dpp_bootstrap_info *own_bi = NULL;
@@ -3522,7 +3522,7 @@ wpas_dpp_rx_pkex_commit_reveal_resp(struct wpa_supplicant *wpa_s, const u8 *src,
 	int res;
 	struct dpp_bootstrap_info *bi;
 	struct dpp_pkex *pkex = wpa_s->dpp_pkex;
-	char cmd[500];
+	char cmd[4096];
 
 	wpa_printf(MSG_DEBUG, "DPP: PKEX Commit-Reveal Response from " MACSTR,
 		   MAC2STR(src));
