From c880dca41e43d083db9a6de8e117505a2f7f08e9 Mon Sep 17 00:00:00 2001
From: Morse Micro <support@morsemicro.com>
Subject: [PATCH] AP/STA: log RSSI for auth and assoc management frames

Taken verbatim from the Morse Micro OpenWrt feed, which is the vendor
porting template for this platform.
Upstream ships this file as "git show" output rather than "git format-patch"
output, so it has no From line. The commit it names
(d9c3e1ff328211e1ebcc88b3c07c68f0174ac829) is not reachable in the public
MorseMicro/hostap mirror and therefore cannot be verified from here, so the
From line above uses the feed commit that carries the file instead of
repeating an unverifiable one.
  repo   : https://github.com/MorseMicro/morse-feed
  commit : c880dca41e43d083db9a6de8e117505a2f7f08e9
           (pinned by github.com/MorseMicro/openwrt tag 3.0.2)
  path   : essentials/hostapd_s1g/patches/mm61x/905-ap-sta-connect-mgmt-frame-rssi-log.patch

Threads the nl80211 RSSI of auth/assoc frames through to the logs on both
sides. Useful while bringing the SPI link up, chip-independent.

Original patch content follows unmodified.

commit d9c3e1ff328211e1ebcc88b3c07c68f0174ac829
Author: Prabha Murugesan <prabha.murugesan@morsemicro.com>
Date:   Tue Mar 31 18:48:54 2026 +1100

    AP/STA: log RSSI for auth and assoc management frames

diff --git a/src/ap/drv_callbacks.c b/src/ap/drv_callbacks.c
index 70177d22d..49eba43e1 100644
--- a/src/ap/drv_callbacks.c
+++ b/src/ap/drv_callbacks.c
@@ -1671,6 +1671,14 @@ static void hostapd_notif_auth(struct hostapd_data *hapd,
 	u8 resp_ies[2 + WLAN_AUTH_CHALLENGE_LEN];
 	size_t resp_ies_len = 0;
 
+	wpa_msg(hapd->msg_ctx, MSG_INFO,
+		"authentication: STA=" MACSTR
+		" auth_alg=%u auth_transaction=%u status_code=%u"
+		" rssi=%d (offload)",
+		MAC2STR(rx_auth->peer), rx_auth->auth_type,
+		rx_auth->auth_transaction, rx_auth->status_code,
+		rx_auth->ssi_signal);
+
 	sta = ap_get_sta(hapd, rx_auth->peer);
 	if (!sta) {
 		sta = ap_sta_add(hapd, rx_auth->peer);
@@ -2671,6 +2679,14 @@ void wpa_supplicant_event(void *ctx, enum wpa_event_type event,
 			}
 		}
 #endif /* CONFIG_IEEE80211BE */
+		if (data->assoc_info.addr) {
+			wpa_msg(hapd->msg_ctx, MSG_INFO,
+				"%sassociation request: STA=" MACSTR
+				" rssi=%d (offload)",
+				data->assoc_info.reassoc ? "re" : "",
+				MAC2STR(data->assoc_info.addr),
+				data->assoc_info.ssi_signal);
+		}
 		hostapd_notif_assoc(hapd, data->assoc_info.addr,
 				    data->assoc_info.req_ies,
 				    data->assoc_info.req_ies_len,
