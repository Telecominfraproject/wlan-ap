From c880dca41e43d083db9a6de8e117505a2f7f08e9 Mon Sep 17 00:00:00 2001
From: Morse Micro <support@morsemicro.com>
Subject: [PATCH] hostapd/wpa_supplicant: report compiled-in features via -v<feature>

Taken verbatim from the Morse Micro OpenWrt feed, which is the vendor
porting template for this platform.
Upstream ships this file as a plain diff with no From line, so the hash above
is the real commit of the feed that carries it (a feed commit, not a hostap
commit).
  repo   : https://github.com/MorseMicro/morse-feed
  commit : c880dca41e43d083db9a6de8e117505a2f7f08e9
           (pinned by github.com/MorseMicro/openwrt tag 3.0.2)
  path   : essentials/hostapd_s1g/patches/mm61x/420-indicate-features.patch

The standard OpenWrt feature-probe patch: -v<feature> exits 0 when <feature>
is compiled in. netifd-morse relies on it (lib/netifd/morse/morse_overrides.sh
runs "hostapd_s1g -vfils || fils=0"); without it that probe always reports
"not supported" because plain -v just prints the version and exits non-zero.
Needs src/utils/build_features.h, which this package supplies as an override
file under ./src/.

Original patch content follows unmodified.

--- a/hostapd/main.c
+++ b/hostapd/main.c
@@ -32,7 +32,7 @@
 #include "config_file.h"
 #include "eap_register.h"
 #include "ctrl_iface.h"
-
+#include "build_features.h"
 
 struct hapd_global {
 	void **drv_priv;
@@ -864,7 +864,7 @@
 #endif /* CONFIG_DPP */
 
 	for (;;) {
-		c = getopt(argc, argv, "b:Bde:f:hi:KP:sSTtu:vg:G:q");
+		c = getopt(argc, argv, "b:Bde:f:hi:KP:sSTtu:g:G:qv::");
 		if (c < 0)
 			break;
 		switch (c) {
@@ -901,6 +901,8 @@
 			break;
 #endif /* CONFIG_DEBUG_LINUX_TRACING */
 		case 'v':
+			if (optarg)
+				exit(!has_feature(optarg));
 			show_version();
 			exit(1);
 		case 'g':
--- a/wpa_supplicant/main.c
+++ b/wpa_supplicant/main.c
@@ -12,6 +12,7 @@
 #endif /* __linux__ */
 
 #include "common.h"
+#include "build_features.h"
 #include "crypto/crypto.h"
 #include "fst/fst.h"
 #include "wpa_supplicant_i.h"
@@ -206,7 +207,7 @@
 
 	for (;;) {
 		c = getopt(argc, argv,
-			   "b:Bc:C:D:de:f:g:G:hi:I:KLMm:No:O:p:P:qsTtuvWy");
+				"b:Bc:C:D:de:f:g:G:hi:I:KLMm:No:O:p:P:qsTtuv::Wy");
 		if (c < 0)
 			break;
 		switch (c) {
@@ -306,8 +307,12 @@
 			break;
 #endif /* CONFIG_CTRL_IFACE_DBUS_NEW */
 		case 'v':
-			printf("%s\n", wpa_supplicant_version);
-			exitcode = 0;
+			if (optarg) {
+				exitcode = !has_feature(optarg);
+			} else {
+				printf("%s\n", wpa_supplicant_version);
+				exitcode = 0;
+			}
 			goto out;
 		case 'W':
 			params.wait_for_monitor++;
