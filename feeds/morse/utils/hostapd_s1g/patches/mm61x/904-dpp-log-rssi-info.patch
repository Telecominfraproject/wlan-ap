-			   const u8 *buf, size_t len, unsigned int freq);
+			   const u8 *buf, size_t len, unsigned int freq,
+			   int ssi_signal);
 void hostapd_dpp_tx_status(struct hostapd_data *hapd, const u8 *dst,
 			   const u8 *data, size_t data_len, int ok);
 struct wpabuf *
