 		end = drv_mgmt->frame + drv_mgmt->frame_len;
 		hostapd_dpp_rx_action(hapd, mgmt->sa, pos, end - pos,
-				      drv_mgmt->freq);
+				      drv_mgmt->freq,
+				      drv_mgmt->ssi_signal);
 		return;
 	}
 #endif /* CONFIG_DPP */
--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -6797,7 +6797,7 @@
 
