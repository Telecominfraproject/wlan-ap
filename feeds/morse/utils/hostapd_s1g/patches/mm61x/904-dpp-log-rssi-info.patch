  repo   : https://github.com/MorseMicro/morse-feed
  commit : c880dca41e43d083db9a6de8e117505a2f7f08e9
           (pinned by github.com/MorseMicro/openwrt tag 3.0.2)
  path   : essentials/hostapd_s1g/patches/mm61x/904-dpp-log-rssi-info.patch

Adds RSSI to the DPP action-frame logs. Useful while bringing the SPI link up,
chip-independent.

Original patch content follows unmodified.

commit d40e6fbe047a4d207b354f29a4da7a808aea41c9
Author: Prabha Murugesan <prabha.murugesan@morsemicro.com>
Date:   Tue Mar 31 18:47:31 2026 +1100

    DPP: log RSSI for received action frames

--- a/src/ap/dpp_hostapd.c
+++ b/src/ap/dpp_hostapd.c
@@ -3058,7 +3058,8 @@
 
 
 void hostapd_dpp_rx_action(struct hostapd_data *hapd, const u8 *src,
-			   const u8 *buf, size_t len, unsigned int freq)
+			   const u8 *buf, size_t len, unsigned int freq,
+			   int ssi_signal)
 {
 	u8 crypto_suite;
 	enum dpp_public_action_frame_type type;
@@ -3082,25 +3083,28 @@
 
 	wpa_printf(MSG_DEBUG,
 		   "DPP: Received DPP Public Action frame crypto suite %u type %d from "
-		   MACSTR " freq=%u",
-		   crypto_suite, type, MAC2STR(src), freq);
+		   MACSTR " freq=%u rssi=%d",
+		   crypto_suite, type, MAC2STR(src), freq, ssi_signal);
 	if (crypto_suite != 1) {
 		wpa_printf(MSG_DEBUG, "DPP: Unsupported crypto suite %u",
 			   crypto_suite);
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_RX "src=" MACSTR
-			" freq=%u type=%d ignore=unsupported-crypto-suite",
-			MAC2STR(src), freq, type);
+			" freq=%u type=%d ignore=unsupported-crypto-suite"
+			" rssi=%d",
+			MAC2STR(src), freq, type, ssi_signal);
 		return;
 	}
 	wpa_hexdump(MSG_MSGDUMP, "DPP: Received message attributes", buf, len);
 	if (dpp_check_attrs(buf, len) < 0) {
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_RX "src=" MACSTR
-			" freq=%u type=%d ignore=invalid-attributes",
-			MAC2STR(src), freq, type);
+			" freq=%u type=%d ignore=invalid-attributes"
+			" rssi=%d",
+			MAC2STR(src), freq, type, ssi_signal);
 		return;
 	}
 	wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_RX "src=" MACSTR
-		" freq=%u type=%d", MAC2STR(src), freq, type);
+		" freq=%u type=%d rssi=%d",
+		MAC2STR(src), freq, type, ssi_signal);
 
 #ifdef CONFIG_DPP2
 	if (dpp_relay_rx_action(hapd->iface->interfaces->dpp,
--- a/src/ap/dpp_hostapd.h
