From c880dca41e43d083db9a6de8e117505a2f7f08e9 Mon Sep 17 00:00:00 2001
From: Morse Micro <support@morsemicro.com>
Subject: [PATCH] Fix a crash when a ubus-registered BSS is torn down during DPP

Taken verbatim from the Morse Micro OpenWrt feed, which is the vendor
porting template for this platform.
Upstream ships this file as a plain diff with no From line, so the hash above
is the real commit of the feed that carries it (a feed commit, not a hostap
commit).
  repo   : https://github.com/MorseMicro/morse-feed
  commit : c880dca41e43d083db9a6de8e117505a2f7f08e9
           (pinned by github.com/MorseMicro/openwrt tag 3.0.2)
  path   : essentials/hostapd_s1g/patches/mm61x/621-fix-DPP-teardown-ubus-crash.patch

Reorders the ubus object teardown so the interface is deregistered before its
state is freed. Depends on 600-ubus_support.patch.

Original patch content follows unmodified.

--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -512,7 +512,6 @@
 	hapd->beacon_set_done = 0;
 
 	wpa_printf(MSG_DEBUG, "%s(%s)", __func__, hapd->conf->iface);
-	hostapd_ubus_free_bss(hapd);
 	accounting_deinit(hapd);
 	hostapd_deinit_wpa(hapd);
 	vlan_deinit(hapd);
@@ -553,6 +552,9 @@
 	gas_query_ap_deinit(hapd->gas);
 	hapd->gas = NULL;
 #endif /* CONFIG_DPP */
+
+	hostapd_ubus_free_bss(hapd);
+
 #ifdef CONFIG_NAN_USD
 	hostapd_nan_usd_deinit(hapd);
 #endif /* CONFIG_NAN_USD */
--- a/wpa_supplicant/wpa_supplicant.c
+++ b/wpa_supplicant/wpa_supplicant.c
@@ -8118,6 +8118,8 @@
 		wpa_s->conf = NULL;
 	}
 
+	wpas_ubus_free_bss(wpa_s);
+
 	os_free(wpa_s->ssids_from_scan_req);
 	os_free(wpa_s->last_scan_freqs);
 
@@ -8314,8 +8316,6 @@
 	struct wpa_supplicant *parent = wpa_s->parent;
 #endif /* CONFIG_MESH */
 
-	wpas_ubus_free_bss(wpa_s);
-
 	/* Remove interface from the global list of interfaces */
 	prev = global->ifaces;
 	if (prev == wpa_s) {
