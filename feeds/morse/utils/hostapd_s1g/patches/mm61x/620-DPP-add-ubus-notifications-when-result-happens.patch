+		}
 	}
 	ifaces->dpp_pb_time.sec = 0;
 	ifaces->dpp_pb_time.usec = 0;
--- a/src/common/dpp.c
+++ b/src/common/dpp.c
@@ -1510,6 +1510,7 @@ void dpp_auth_deinit(struct dpp_authentication *auth)
 		struct dpp_config_obj *conf = &auth->conf_obj[i];
 
 		os_free(conf->connector);
+		os_free(conf->conf_obj);
 		wpabuf_free(conf->c_sign_key);
 		wpabuf_free(conf->certbag);
 		wpabuf_free(conf->certs);
@@ -3305,6 +3306,8 @@ static int dpp_parse_conf_obj(struct dpp_authentication *auth,
 	}
 	conf = &auth->conf_obj[auth->num_conf_obj++];
 
+	conf->conf_obj = os_strdup((const char *) conf_obj);
+
 	if (ssid64) {
 		conf->ssid_len = wpabuf_len(ssid64);
 		os_memcpy(conf->ssid, wpabuf_head(ssid64), conf->ssid_len);
