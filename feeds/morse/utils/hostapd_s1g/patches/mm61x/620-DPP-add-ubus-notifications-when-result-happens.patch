From c880dca41e43d083db9a6de8e117505a2f7f08e9 Mon Sep 17 00:00:00 2001
From: Morse Micro <support@morsemicro.com>
Subject: [PATCH] DPP: emit ubus notifications when a DPP result occurs

Taken verbatim from the Morse Micro OpenWrt feed, which is the vendor
porting template for this platform.
Upstream ships this file as a plain diff with no From line, so the hash above
is the real commit of the feed that carries it (a feed commit, not a hostap
commit).
  repo   : https://github.com/MorseMicro/morse-feed
  commit : c880dca41e43d083db9a6de8e117505a2f7f08e9
           (pinned by github.com/MorseMicro/openwrt tag 3.0.2)
  path   : essentials/hostapd_s1g/patches/mm61x/620-DPP-add-ubus-notifications-when-result-happens.patch

Surfaces DPP progress/results as ubus events. Depends on
600-ubus_support.patch and on the ubus override files under ./src/.

Original patch content follows unmodified.

--- a/src/ap/dpp_hostapd.c
+++ b/src/ap/dpp_hostapd.c
@@ -23,6 +23,7 @@
 #include "gas_serv.h"
 #include "wpa_auth.h"
 #include "beacon.h"
+#include "ubus.h"
 #include "dpp_hostapd.h"
 
 #ifdef CONFIG_MORSE_5GHZ_MAPPED
@@ -1385,8 +1386,10 @@ static void hostapd_dpp_gas_resp_cb(void *ctx, const u8 *addr, u8 dialog_token,
 	}
 #endif /* CONFIG_TESTING_OPTIONS */
 fail:
-	if (status != DPP_STATUS_OK)
+	if (status != DPP_STATUS_OK) {
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_CONF_FAILED);
+		hostapd_ubus_notify_dpp_conf_failed(hapd, auth);
+	}
 #ifdef CONFIG_DPP2
 	if (auth->peer_version >= 2 &&
 	    auth->conf_resp_status == DPP_STATUS_OK) {
@@ -1585,6 +1588,7 @@ static void hostapd_dpp_config_result_wait_timeout(void *eloop_ctx,
 	wpa_printf(MSG_DEBUG,
 		   "DPP: Timeout while waiting for Configuration Result");
 	wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_CONF_FAILED);
+	hostapd_ubus_notify_dpp_conf_failed(hapd, auth);
 	dpp_auth_deinit(auth);
 	hapd->dpp_auth = NULL;
 }
@@ -1691,23 +1695,31 @@ static void hostapd_dpp_rx_conf_result(struct hostapd_data *hapd, const u8 *src,
 	}
 	hostapd_drv_send_action_cancel_wait(hapd);
 	hostapd_dpp_listen_stop(hapd);
-	if (status == DPP_STATUS_OK)
+	if (status == DPP_STATUS_OK) {
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_CONF_SENT
 			"conf_status=%d", auth->conf_resp_status);
-	else
+		if (auth->peer_bi && auth->peer_bi->type == DPP_BOOTSTRAP_QR_CODE)
+			hostapd_ubus_notify_dpp_result(hapd, "success", auth);
+	} else {
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_CONF_FAILED);
+		hostapd_ubus_notify_dpp_conf_failed(hapd, auth);
+	}
 	dpp_auth_deinit(auth);
 	hapd->dpp_auth = NULL;
 	eloop_cancel_timeout(hostapd_dpp_config_result_wait_timeout, hapd,
 			     NULL);
 #ifdef CONFIG_DPP3
 	if (!ifaces->dpp_pb_result_indicated && hostapd_dpp_pb_active(hapd)) {
-		if (status == DPP_STATUS_OK)
+		if (status == DPP_STATUS_OK) {
 			wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_PB_RESULT
 				"success");
-		else
+			hostapd_ubus_notify_dpp_result(hapd, "success", NULL);
+		} else {
 			wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_PB_RESULT
 				"no-configuration-available");
+			hostapd_ubus_notify_dpp_result(
+				hapd, "no-configuration-available", NULL);
+		}
 		ifaces->dpp_pb_result_indicated = true;
 		if (status == DPP_STATUS_OK)
 			hostapd_dpp_remove_pb_hash(hapd);
@@ -1823,6 +1835,9 @@ hostapd_dpp_rx_presence_announcement(struct hostapd_data *hapd, const u8 *src,
 	if (hostapd_dpp_auth_init_next(hapd) < 0) {
 		dpp_auth_deinit(hapd->dpp_auth);
 		hapd->dpp_auth = NULL;
+	} else if (auth->own_bi && auth->own_bi->type == DPP_BOOTSTRAP_QR_CODE) {
+		hostapd_ubus_notify_dpp_result(hapd, "started",
+					       hapd->dpp_auth);
 	}
 }
 
@@ -2729,6 +2744,8 @@ hostapd_dpp_rx_pb_presence_announcement(struct hostapd_data *hapd,
 				wpa_msg(hapd->msg_ctx, MSG_INFO,
 					DPP_EVENT_PB_RESULT "session-overlap");
 				ifaces->dpp_pb_result_indicated = true;
+				hostapd_ubus_notify_dpp_result(
+					hapd, "session-overlap", NULL);
 			}
 			hostapd_dpp_push_button_stop(hapd);
 			return;
@@ -3292,8 +3309,10 @@ hostapd_dpp_gas_req_handler(struct hostapd_data *hapd, const u8 *sa,
