From c880dca41e43d083db9a6de8e117505a2f7f08e9 Mon Sep 17 00:00:00 2001
From: Morse Micro <support@morsemicro.com>
Subject: [PATCH] Allow a co-located AP and STA on one S1G radio

Taken verbatim from the Morse Micro OpenWrt feed, which is the vendor
porting template for this platform.
Upstream ships this file as a plain diff with no From line, so the hash above
is the real commit of the feed that carries it (a feed commit, not a hostap
commit).
  repo   : https://github.com/MorseMicro/morse-feed
  commit : c880dca41e43d083db9a6de8e117505a2f7f08e9
           (pinned by github.com/MorseMicro/openwrt tag 3.0.2)
  path   : essentials/hostapd_s1g/patches/mm61x/901-apsta-support.patch

Relaxes the S1G config validation and the interface-count handling so an AP
and a STA interface can share one radio. Chip-independent; the AP-STA
channel-follow daemon that builds on it (MORSE_HOSTAPD_APSTA_HANDLER) stays
off in this build.

Original patch content follows unmodified.

--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -5262,6 +5262,12 @@ int hostapd_config_s1g_val(struct hostap
 	int prim_chwidth = 0;
 	int errors = 0;
 
+	/* Special region is set for s1g. Reset from backup for a valid s1g to ht conversion */
+	if(conf->country[0] == 'Z' && conf->country[1] == 'Z') {
+		conf->country[0] = conf->op_country[0];
+		conf->country[1] = conf->op_country[1];
+	}
+
 	if (morse_ap_configure_channelization(conf->country, conf->op_class)) {
 		errors++;
 		return errors;
--- a/hostapd/main.c
+++ b/hostapd/main.c
@@ -33,6 +33,7 @@
 #include "eap_register.h"
 #include "ctrl_iface.h"
 #include "build_features.h"
+#include "ap/ubus.h"
 
 struct hapd_global {
 	void **drv_priv;
@@ -1031,6 +1032,7 @@ int main(int argc, char *argv[])
 	}
 
 	hostapd_global_ctrl_iface_init(&interfaces);
+	hostapd_s1g_ubus_add_main(&interfaces);
 
 	if (hostapd_global_run(&interfaces, daemonize, pid_file)) {
 		wpa_printf(MSG_ERROR, "Failed to start eloop");
@@ -1041,6 +1043,8 @@ int main(int argc, char *argv[])
 
  out:
 	hostapd_global_ctrl_iface_deinit(&interfaces);
+	hostapd_s1g_ubus_free_main();
+
 	/* Deinitialize all interfaces */
 	for (i = 0; i < interfaces.count; i++) {
 		if (!interfaces.iface[i])
--- a/wpa_supplicant/wpa_supplicant.c
+++ b/wpa_supplicant/wpa_supplicant.c
@@ -1171,6 +1171,7 @@ void wpa_supplicant_set_state(struct wpa
 		sme_sched_obss_scan(wpa_s, 0);
 	}
 	wpa_s->wpa_state = state;
+	wpas_ubus_event_state(wpa_s, wpa_supplicant_state_txt(state));
 
 #ifdef CONFIG_BGSCAN
 	if (state == WPA_COMPLETED && wpa_s->current_ssid != wpa_s->bgscan_ssid)
