#!/bin/sh

. /lib/functions.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

qcom_setup_interfaces()
{
	local board="$1"
	ucidef_add_switch "switch0"
	ucidef_add_switch_attr "switch0" "enable" "false"
	ucidef_add_switch_attr "switch0" "reset" "false"

	case $board in
	hfcl,ion4xi|\
	hfcl,ion4x|\
	hfcl,ion4x_2|\
	hfcl,ion4x_3|\
	hfcl,ion4xe)
		ucidef_set_interface_wan "eth0 eth1"
		ucidef_set_interface_lan ""
		;;
	indio,um-310ax-v1|\
	yuncore,ax840)
		ucidef_set_interface_lan "eth0"
		ucidef_set_interface_wan "eth1"
		;;
	edgecore,eap101|\
	glinet,axt1800)
		ucidef_set_interface_lan "eth1 eth2"
		ucidef_set_interface_wan "eth0"
		;;
	cambium,xv2-2)
		# One 2.5G port, dp1 only; the XV2-2T's dp2 does not exist here.
		ucidef_set_interface_wan "eth0"
	cambium,xv2-2t0)
	cambium,xv2-2t1)
	cambium,xe3-4)
		ucidef_set_interface_wan "eth0"
		ucidef_set_interface_lan "eth1"
		;;
	wallys,dr6018|\
	cig,wf188n)
		ucidef_set_interface_lan "eth1"
		ucidef_set_interface_wan "eth0"
		;;
	cig,wf660a|\
	emplus,wap386v2)
		ucidef_set_interface_wan "eth0"		
		;;
	yuncore,fap650)
		ucidef_set_interface_lan "eth3 eth2 eth1 eth0"
		ucidef_set_interface_wan "eth4"
		;;
	wallys,dr6018-v4|\
	glinet,ax1800)
		ucidef_set_interface_lan "eth1 eth2 eth3 eth4"
		ucidef_set_interface_wan "eth0"
		;;
	esac
}

qcom_setup_macs()
{
	local board="$1"

	case $board in
	cig,wf188n)
		mtd=$(find_mtd_chardev "0:APPSBLENV")
		[ -z "$mtd" ] && return;
		mac=$(grep BaseMacAddress= $mtd | cut -dx -f2)
		[ -z "$mac" ] && return;
		wan_mac=$(macaddr_canonicalize $mac)
		lan_mac=$(macaddr_add "$wan_mac" 1)
		ucidef_set_network_device_mac eth0 $wan_mac
		ucidef_set_network_device_mac eth1 $lan_mac
                ucidef_set_label_macaddr $wan_mac
		;;
	cig,wf660a)
		mmc_dev=$(find_mtd_chardev "0:APPSBLENV")
		[ -z "$mmc_dev" ] && mmc_dev=$(find_mmc_part "0:APPSBLENV")
		[ -z "$mmc_dev" ] && return
		mac=$(grep BaseMacAddress= $mmc_dev | cut -dx -f2)
		[ -z "$mac" ] && return;
		wan_mac=$(macaddr_canonicalize $mac)
		ucidef_set_network_device_mac eth0 $wan_mac
		ip link set eth0 address $wan_mac
		;;
	emplus,wap386v2)
		wan_mac=$(cat /sys/class/net/eth0/address)
		;;
	indio,um-310ax-v1|\
	yuncore,ax840)
		wan_mac=$(cat /sys/class/net/eth1/address)
		lan_mac=$(macaddr_add "$wan_mac" 1)
		;;
	yuncore,fap650)
		wan_mac=$(cat /sys/class/net/eth4/address)
		;;
	cambium,xv2-2)
		# Not the arm above. On this board U-Boot's environment carries the
		# LABEL MAC as ethaddr (30:cb:c7:16:9f:9b on the reference unit) and
		# an all-zero eth1addr, so the one port must come up carrying ethaddr
		# (the device tree aliases dp1 as ethernet0, not ethernet1 as the
		# XV2-2T's does) and the label is eth0's address as read. The 2T's
		# "- 1" would present a serial that matches no certificate.
		wan_mac=$(cat /sys/class/net/eth0/address)
	cambium,xv2-2t0)
	cambium,xv2-2t1)
		# Mirrors the Cambium XV2-22H (ipq50xx 02_network). Cambium's LABEL
		# MAC is ethaddr and eth1addr is label+1: this unit has ethaddr=
		# fc:11:65:b6:ab:7c, eth1addr=fc:11:65:b6:ab:7d and mfginfo carries
		# FC1165B6AB7C (verified from the stock firmware). The uCentral serial
		# AND the birth certificate CN are both the LABEL MAC, so taking the
		# label from a port carrying eth1addr is off by one: the AP presents
		# a serial that does not match its cert and the controller closes the
		# session right after pushing config.
		#
		# The device tree aliases dp1 as ethernet1 so that eth1addr lands on
		# eth0 and the label is wan_mac - 1. That eth0 really comes up with
		# eth1addr is still UNVERIFIED on this hardware: if it carries
		# ethaddr instead, drop the -1.
	cambium,xe3-4)
		# Mirrors the Cambium XV2-22H (ipq50xx 02_network). Cambium's LABEL
		# MAC is ethaddr and eth1addr is label+1: the reference 2T0 has
		# ethaddr=fc:11:65:b6:ab:7c, eth1addr=fc:11:65:b6:ab:7d and mfginfo
		# carries FC1165B6AB7C, the reference XE3-4 ethaddr=b4:a2:5c:16:43:da,
		# eth1addr=b4:a2:5c:16:43:db and mfginfo B4A25C1643DA (both verified
		# from the stock firmware). The uCentral serial AND the birth
		# certificate CN are both the LABEL MAC, so taking the label from a
		# port carrying eth1addr is off by one: the AP presents a serial that
		# does not match its cert and the controller closes the session right
		# after pushing config.
		#
		# The device tree aliases dp1 as ethernet1 so that eth1addr lands on
		# eth0 and the label is wan_mac - 1. Verified on the XV2-2T1: it
		# onboarded over mTLS with its own certificate and stayed connected,
		# which the serial could not have done had eth0 carried ethaddr.
		wan_mac=$(cat /sys/class/net/eth0/address)
		lan_mac=$(macaddr_add "$wan_mac" 1)
		label_mac=$(macaddr_add "$wan_mac" -1)
		;;
	*)
		wan_mac=$(cat /sys/class/net/eth0/address)
		lan_mac=$(macaddr_add "$wan_mac" 1)
		;;
	esac
	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" $wan_mac
	[ -n "$wan_mac" ] && ucidef_set_label_macaddr "${label_mac:-$wan_mac}"
}

board_config_update
board=$(board_name)
qcom_setup_interfaces $board
qcom_setup_macs $board
board_config_flush

exit 0
