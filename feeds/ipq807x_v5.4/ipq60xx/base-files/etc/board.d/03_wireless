#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
cambium,xv2-2)
	# The stock firmware caps the XV2-2 at 24 dBm on 2.4 GHz and 25 dBm on
	# 5 GHz into its 5 and 6 dBi antennas. mac80211.sh clamps txpower to
	# these.
	json_select_object wlan
		json_select_object defaults
			json_select_object max_txpower
				json_add_int 2g 24
				json_add_int 5g 25
			json_select ..
		json_select ..
	json_select ..
	;;
esac

board_config_flush

exit 0
