#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
cambium,xv2-2)
	# The stock firmware caps the XV2-2 at 24 dBm on 2.4 GHz and 25 dBm on
	# 5 GHz into its 5 and 6 dBi antennas. mac80211.sh clamps txpower to
	# these.
cambium,xv2-2t1)
	# The XV2-2T1 runs the omni XV2-2T0's board data on 120-degree sector
	# antennas of 11 dBi at 2.4 GHz and 13 dBi at 5 GHz, against the 2T0's
	# 5 and 9 dBi, so the stock firmware caps its transmit power at 24 and
	# 23 dBm where the 2T0 may use 28 (Cambium's capability.json).
	# mac80211.sh clamps txpower to these.
cambium,xe3-4)
	# Cambium's capability.json gives the XE3-4 24, 25 and 24 dBm conducted
	# on 2.4, 5 and 6 GHz into 5, 6 and 6 dBi antennas. mac80211.sh clamps
	# txpower to these. A single figure cannot express the 6 GHz indoor
	# (LPI) limit, which is a power spectral density, 5 dBm/MHz EIRP:
	# through the 6 dBi antenna 24 dBm conducted is 30 dBm EIRP, the LPI
	# cap, which the PSD only reaches at 320 MHz; at 20 MHz it is 12 dB
	# over the PSD limit, at 80 MHz 6 dB. Accepted here deliberately, for
	# this lab unit; a bandwidth-aware ceiling is the proper fix.
	#
	# The stock firmware runs the 6 GHz radio as an indoor LPI access point.
	# Without this the image would run it as very low power, the renderer's
	# fall-through for an unconfigured power type, about 16 dB below stock;
	# asking the schema for indoor power instead demands an AFC block that
	# hostapd.sh then turns into standard power. hostapd.sh takes this as
	# the board's power type whenever AFC is not configured.
	json_select_object wlan
		json_select_object defaults
			json_select_object max_txpower
				json_add_int 2g 24
				json_add_int 5g 25
				json_add_int 5g 23
			json_select ..
				json_add_int 6g 24
			json_select ..
			json_add_int he_6ghz_reg_pwr_type 0
		json_select ..
	json_select ..
	;;
esac

board_config_flush

exit 0
