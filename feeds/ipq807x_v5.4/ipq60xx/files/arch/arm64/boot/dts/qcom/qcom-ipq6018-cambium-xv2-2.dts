// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
/*
 * Cambium XV2-2 device tree source
 *
 * The base model of the family: Cambium's own codename for it is plain
 * "Jaguar" (/proc/sku 20), and the XV2-2T0 (22), XV2-2T1 (31) and XE3-4 (32)
 * are derived from it. So most of this board is already described by
 * qcom-ipq6018-cambium-xv2-2t.dtsi, and what follows is only where the
 * XV2-2 differs. Every value below was read from this unit itself: the OEM
 * device tree as the stock kernel received it (/sys/firmware/fdt) and a full
 * read-only flash dump.
 *
 * Four differences from the 2T, two of them inversions of what the sibling
 * boards needed:
 *
 *   - One ethernet port, not two. The OEM tree declares the whole CP01
 *     reference set dp1..dp5 and leaves the board to wire what it has; the
 *     single 2.5G port is OEM dp5 (switch port 5, PHY 0x18, wan_bmp 0x20),
 *     which the shared dtsi calls dp1. The dtsi's dp2 (switch port 4, PHY 3)
 *     does not exist here.
 *   - ethernet0, not ethernet1. The 2T/XE3-4 put the label MAC in ethaddr
 *     and label+1 in eth1addr, so the dtsi aliases the port as ethernet1 to
 *     collect eth1addr and 02_network subtracts one. On this unit eth1addr
 *     is all zeroes and ethaddr IS the label MAC (30:cb:c7:16:9f:9b, matching
 *     mfginfo), so the port must be ethernet0 or U-Boot's eth%daddr fixup
 *     stamps a zero MAC onto it, and nss-dp replaces an invalid MAC with a
 *     random one, which would give the unit a different uCentral serial on
 *     every boot. The OEM tree aliases dp1 as ethernet0 for the same reason,
 *     and U-Boot's fixup in the captured OEM tree shows it: the two nodes
 *     carrying a real address are dp1 (ethernet0, from ethaddr) and dp5
 *     (ethernet4, from eth4addr, which holds the same address); dp2..dp4 are
 *     zero, as eth1addr..eth3addr are. A zero node is not by itself proof
 *     that the fixup wrote it, but ethaddr landing on ethernet0 is.
 *   - 128 MiB NAND in two 52 MiB banks, not 256 MiB in two 96 MiB banks.
 *     ECC is unchanged (BCH4 over 512-byte steps).
 *   - 0:ART is 256 KiB here, not 512 KiB. The 16-entry NOR map is otherwise
 *     the dtsi's, environment included: 0:APPSBLENV is at 0x510000 on this
 *     unit, so qcom-ipq6018-cambium-nor-23.dtsi must NOT be included. That is
 *     the 2T1 trap in reverse - inheriting a sibling's map silently writes
 *     the environment to the wrong place - and it was checked against each
 *     partition's own offset under /sys/class/mtd on the live unit, not
 *     inferred from the firmware version.
 *
 * Copyright (c) 2019-2021 The Linux Foundation. All rights reserved.
 */

/dts-v1/;

#include "qcom-ipq6018-cambium-xv2-2t.dtsi"

/ {
	model = "Cambium XV2-2";
	compatible = "cambium,xv2-2", "qcom,ipq6018-ap-cp01", "qcom,ipq6018";

	aliases {
		/*
		 * See the header: this board's port carries ethaddr, not
		 * eth1addr, so it is ethernet0. Dropping the dtsi's ethernet1
		 * matters as much as adding ethernet0 - left in place it would
		 * point a second alias at the same node.
		 */
		/delete-property/ ethernet1;
		ethernet0 = "/soc/dp1";
	};
};

&tlmm {
	/*
	 * GPIO 20 is TrustZone-owned on the sibling XE3-4, where leaving it
	 * visible made gpiolib's probe-time get_direction() sweep take a
	 * synchronous external abort inside msm_gpio_get_direction(), before
	 * the console was even registered; the board then rebooted on the
	 * panic timeout with nothing printed, looking exactly like a failed
	 * bootloader handoff. Whether this board's TrustZone claims the same
	 * line is not established, but GPIO 20 is referenced nowhere in the
	 * OEM tree or in ours, so reserving it costs nothing and removes the
	 * only failure mode in this family that leaves no evidence.
	 */
	gpio-reserved-ranges = <20 1>;
};

&soc {
	/* Single-port board: the dtsi's second datapath has no PHY here. */
	/delete-node/ dp2;
};

&spi_0 {
	m25p80@0 {
		/*
		 * 0:ART is 0x40000 on this unit against the 2T's 0x80000, so
		 * the 16 partitions end at 0x6a0000 and the rest of the 16 MB
		 * chip is unpartitioned. ath11k's caldata sits at the start of
		 * the partition, so the size is a correctness fix rather than a
		 * functional one - but a map that does not match the flash is
		 * how this family hides its mistakes.
		 */
		partition@660000 {
			label = "0:ART";
			reg = <0x660000 0x40000>;
			read-only;
		};
	};
};

&qpic_nand {
	nandcs@0 {
		/*
		 * 128 MiB (Winbond W29N01HZ), two 52 MiB A/B banks. The dtsi's
		 * 96 MiB banks are three partitions at different offsets, so
		 * they are deleted rather than overridden; partition@0 keeps
		 * its name and only changes size. Map transcribed from this
		 * unit's own /proc/mtd and confirmed against the OEM device
		 * tree. Bank A (rootfs) is the one stock runs from here - the
		 * environment has image=0 - so our image belongs in bank B.
		 */
		/delete-node/ partition@6000000;
		/delete-node/ partition@c000000;
		/delete-node/ partition@f000000;

		partition@0 {
			label = "rootfs";
			reg = <0x0 0x3400000>;
		};

		partition@3400000 {
			label = "rootfs_1";
			reg = <0x3400000 0x3400000>;
		};

		partition@6800000 {
			label = "NVRAM";
			reg = <0x6800000 0x1000000>;
		};

		partition@7800000 {
			label = "crashLog";
			reg = <0x7800000 0x800000>;
		};
	};
};

/*
 * LED GPIOs are unchanged: the OEM cambium_platform node carries
 * led-gpio = <73 56 37 35> on this board exactly as on the 2T, so the
 * dtsi's led2/led3/led4 (56/37/35) apply as they stand. The colours still
 * cannot be determined offline, hence the neutral labels. The OEM tree also
 * has a gpio-leds node with a USB LED on GPIO 50, which this board has and
 * the 2T does not; it is left out until the port is otherwise working.
 */
&led_running {
	label = "xv2-2:led2";
};

&led_boot {
	label = "xv2-2:led3";
};

&led_connected {
	label = "xv2-2:led4";
};
