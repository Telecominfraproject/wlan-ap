/*
 * Cambium XV2-2T0 and XV2-2T1 device tree source
 *
 * IPQ6010 (IPQ6018 family) on the AP-CP01-C1 reference design: 1 GB DRAM,
 * 16 MB SPI-NOR, 256 MB NAND, one integrated 2x2:2 dual-band Wi-Fi 6 radio,
 * two ethernet ports. The two boards are the same hardware with different
 * antennas, omnidirectional on the 2T0 and 120-degree sectors on the 2T1;
 * the vendor's own device trees for them differ in nothing but the board
 * SKU number its kernel exposes as /proc/sku (22 and 31). Peripheral values
 * are transcribed from the OEM device tree ("Qualcomm Technologies, Inc.
 * IPQ6018/AP-CP01-C1"). The model name and the LED labels are left to each
 * board's own file.
 *
 * Copyright (c) 2019-2021 The Linux Foundation. All rights reserved.
 */

#include "ipq6018.dtsi"
#include "ipq6018-cpr-regulator.dtsi"
#include <dt-bindings/input/input.h>

/ {
	aliases {
		serial0 = &blsp1_uart3;
		serial1 = &blsp1_uart2;
		/*
		 * Aliases as required by u-boot to patch MAC addresses.
		 *
		 * dp1 (the 2.5G port, WAN) is ethernet1 rather than ethernet0,
		 * the arrangement the Cambium XV2-22H uses, so that U-Boot's
		 * eth%daddr fixup puts eth1addr on it. Cambium's label MAC is
		 * ethaddr and eth1addr is label+1: the reference 2T0 has ethaddr=
		 * fc:11:65:b6:ab:7c, eth1addr=fc:11:65:b6:ab:7d and mfginfo
		 * carries FC1165B6AB7C (verified from the stock firmware).
		 * 02_network derives the uCentral serial as wan_mac-1. The OEM
		 * tree aliases dp1 as ethernet0 instead. Still UNVERIFIED on
		 * hardware: that eth0 comes up with eth1addr and not ethaddr.
		 */
		ethernet1 = "/soc/dp1";

		led-boot = &led_boot;
		led-failsafe = &led_boot;
		led-running = &led_running;
		led-upgrade = &led_boot;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " swiotlb=1 coherent_pool=2M";
	};
};

&blsp1_uart3 {
	pinctrl-0 = <&serial_3_pins>;
	pinctrl-names = "default";
	status = "ok";
};

&spi_0 {
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	cs-select = <0>;
	status = "ok";

	/*
	 * The NOR is a Macronix MX25U12835F (16 MB). The OEM tree declares it
	 * as n25q128a11, a reference-design leftover that every ipq60xx tree
	 * here shares; the driver identifies the chip by its JEDEC ID.
	 */
	m25p80@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0>;
		compatible = "n25q128a11";
		linux,modalias = "m25p80", "n25q128a11";
		spi-max-frequency = <50000000>;
		use-default-sizes;

		/*
		 * NOR map from the 2T0's own /proc/mtd, every partition
		 * verified byte-exact against a full flash dump. The vendor
		 * U-Boot only injects it inside its bootipq command, which our
		 * bootm bootcmd bypasses, so without this table the kernel sees
		 * no MTD partitions at all and ath11k runs uncalibrated. Two
		 * are load-bearing:
		 *   0:ART       - ath11k caldata is extracted from here.
		 *   0:APPSBLENV - the U-Boot environment, so fw_setenv works
		 *                 from OpenWrt (the sysupgrade bank switch).
		 * The 16 partitions end at 0x6e0000; the rest of the 16 MB chip
		 * is unpartitioned. Everything but the environment is
		 * read-only: 0:ART and mfginfo hold irreplaceable per-unit
		 * data (RF calibration, MAC and serial). The XV2-2T1 and the
		 * XE3-4 carry a 23-entry map with the environment elsewhere;
		 * qcom-ipq6018-cambium-nor-23.dtsi overrides this table for them.
		 */
		partition@0 {
			label = "0:SBL1";
			reg = <0x0 0xc0000>;
			read-only;
		};

		partition@c0000 {
			label = "0:MIBIB";
			reg = <0xc0000 0x10000>;
			read-only;
		};

		partition@d0000 {
			label = "0:BOOTCONFIG";
			reg = <0xd0000 0x20000>;
			read-only;
		};

		partition@f0000 {
			label = "0:BOOTCONFIG1";
			reg = <0xf0000 0x20000>;
			read-only;
		};

		partition@110000 {
			label = "0:QSEE";
			reg = <0x110000 0x1a0000>;
			read-only;
		};

		partition@2b0000 {
			label = "0:QSEE_1";
			reg = <0x2b0000 0x1a0000>;
			read-only;
		};

		partition@450000 {
			label = "0:DEVCFG";
			reg = <0x450000 0x10000>;
			read-only;
		};

		partition@460000 {
			label = "mfginfo";
			reg = <0x460000 0x10000>;
			read-only;
		};

		partition@470000 {
			label = "0:RPM";
			reg = <0x470000 0x40000>;
			read-only;
		};

		partition@4b0000 {
			label = "0:RPM_1";
			reg = <0x4b0000 0x40000>;
			read-only;
		};

		partition@4f0000 {
			label = "0:CDT";
			reg = <0x4f0000 0x10000>;
			read-only;
		};

		partition@500000 {
			label = "0:CDT_1";
			reg = <0x500000 0x10000>;
			read-only;
		};

		partition@510000 {
			label = "0:APPSBLENV";
			reg = <0x510000 0x10000>;
		};

		partition@520000 {
			label = "0:APPSBL";
			reg = <0x520000 0xa0000>;
			read-only;
		};

		partition@5c0000 {
			label = "0:APPSBL_1";
			reg = <0x5c0000 0xa0000>;
			read-only;
		};

		partition@660000 {
			label = "0:ART";
			reg = <0x660000 0x80000>;
			read-only;
		};
	};
};

&tlmm {
	spi_0_pins: spi-0-pins {
		pins = "gpio38", "gpio39", "gpio40", "gpio41";
		function = "blsp0_spi";
		drive-strength = <8>;
		bias-pull-down;
	};

	button_pins: button_pins {
		wps_button {
			pins = "gpio9";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};

		reset_button {
			pins = "gpio19";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	leds_pins: leds_pins {
		led2 {
			pins = "gpio56";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led3 {
			pins = "gpio37";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led4 {
			pins = "gpio35";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	mdio_pins: mdio_pinmux {
		mux_0 {
			pins = "gpio64";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};
		mux_1 {
			pins = "gpio65";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
		mux_2 {
			pins = "gpio75";
			function = "gpio";
			bias-pull-up;
		};
		mux_3 {
			pins = "gpio77";
			function = "gpio";
			bias-pull-up;
		};
	};
};

&soc {
	/* Buttons as in the stock device tree, which uses plain gpio-keys. */
	gpio_keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&tlmm 9 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			debounce-interval = <60>;
		};

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 19 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			debounce-interval = <60>;
		};
	};

	/*
	 * LEDs from the stock kernel's cambium_platform driver, fed by the
	 * "cambium-platform" node: led-gpio = <73 56 37 35> (LED1..LED4),
	 * active high, GPIO37 lit at boot, the same on both SKUs (board-sku
	 * 22 "snow_leopard", the 2T0, and 31 "snow_leopard 120", the 2T1).
	 * LED1/GPIO73 is never driven and is left out. Stock uses LED3/GPIO37
	 * while booting (and for a critical power alert), LED2/GPIO56 once up
	 * but not yet connected to its controller, and LED4/GPIO35 once
	 * connected. The colour of each LED cannot be determined offline and
	 * must be confirmed on the hardware, hence the neutral labels each
	 * board sets.
	 */
	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_running: led2 {
			gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_boot: led3 {
			gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_connected: led4 {
			gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	mdio: mdio@90000 {
		pinctrl-0 = <&mdio_pins>;
		pinctrl-names = "default";
		phy-reset-gpio = <&tlmm 75 0 &tlmm 77 1>;
		status = "ok";
		phy0: ethernet-phy@0 {
			reg = <0x18>;
		};
		phy1: ethernet-phy@1 {
			reg = <3>;
		};
	};

	/* Both ports as in the OEM tree: dp1 is the 2.5G QGMAC port, dp2 1G. */
	dp1 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <5>;
		reg = <0x3a001800 0x200>;
		qcom,mactype = <0>;
		local-mac-address = [000000000000];
		qcom,link-poll = <1>;
		qcom,phy-mdio-addr = <0x18>;
		phy-mode = "sgmii";
	};

	dp2 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <4>;
		reg = <0x3a001600 0x200>;
		qcom,mactype = <0>;
		local-mac-address = [000000000000];
		qcom,link-poll = <1>;
		qcom,phy-mdio-addr = <3>;
		phy-mode = "sgmii";
	};

	ess-switch@3a000000 {
		switch_cpu_bmp = <0x1>;  /* cpu port bitmap */
		switch_lan_bmp = <0x1e>; /* lan port bitmap */
		switch_wan_bmp = <0x20>; /* wan port bitmap */
		switch_inner_bmp = <0xc0>; /*inner port bitmap*/
		switch_mac_mode = <0x0>; /* mac mode for uniphy instance0*/
		switch_mac_mode1 = <0xf>; /* mac mode for uniphy instance1*/
		switch_mac_mode2 = <0xff>; /* mac mode for uniphy instance2*/
		qcom,port_phyinfo {
			port@0 {
				port_id = <4>;
				phy_address = <3>;
			};
			port@1 {
				port_id = <5>;
				phy_address = <0x18>;
				port_mac_sel = "QGMAC_PORT";
			};
		};
	};

	nss-macsec0 {
		compatible = "qcom,nss-macsec";
		phy_addr = <0x18>;
		phy_access_mode = <0>;
		mdiobus = <&mdio>;
	};
};

&qpic_bam {
	status = "ok";
};

&qpic_nand {
	status = "ok";

	/*
	 * NAND map from the 2T0's own /proc/mtd. The other ipq60xx boards
	 * in this tree leave it to the vendor U-Boot's mtdparts, but that is
	 * injected only by its bootipq command, which our bootm bootcmd
	 * bypasses. Bank A (rootfs) and bank B (rootfs_1) are the two
	 * sysupgrade targets; both stay writable, as do NVRAM and crashLog.
	 */
	nandcs@0 {
		compatible = "qcom,nandcs";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;

		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partition@0 {
			label = "rootfs";
			reg = <0x0 0x6000000>;
		};

		partition@6000000 {
			label = "rootfs_1";
			reg = <0x6000000 0x6000000>;
		};

		partition@c000000 {
			label = "NVRAM";
			reg = <0xc000000 0x3000000>;
		};

		partition@f000000 {
			label = "crashLog";
			reg = <0xf000000 0x1000000>;
		};
	};
};

/* The integrated IPQ6018 radio serves both bands. */
&wifi0 {
	status = "ok";
};

/*
 * The OEM tree carries a disabled qcn9000 (wifi1@f00000) and enables PCIe,
 * but this board has no add-in radio and PCIe never enumerates. Keep both
 * off.
 */
&wifi1 {
	status = "disabled";
};

&pcie_phy {
	status = "disabled";
};

&pcie0 {
	status = "disabled";
};

&nss_crypto {
	status = "ok";
};
