#!/bin/sh /etc/rc.common
# Copy the system log to /dev/pmsg0, so the last messages before a crash
# are kept in the ramoops pstore region.

START=13
USE_PROCD=1
PROG=/sbin/logread

start_service() {
	[ -e /dev/pmsg0 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" -f -F /dev/pmsg0 -p /var/run/logread.pmsg.pid
	procd_append_param command -S 128
	procd_close_instance
}
