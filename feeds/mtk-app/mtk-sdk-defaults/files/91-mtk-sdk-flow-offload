#!/bin/sh
# Forward established routed (NAT) connections through the nftables software
# flowtable instead of the full netfilter path. Without it the CPU limits NAT
# throughput well below the Wi-Fi rate on these boards.
#
# ucentral builds every configuration on top of /etc/config-shadow, which
# zzz-ucentral copies from /etc/config on the first boot. This script runs
# before it, and also updates an existing /etc/config-shadow.

for dir in /etc/config /etc/config-shadow; do
	[ -f "$dir/firewall" ] || continue
	uci -q -c "$dir" get firewall.@defaults[0] >/dev/null || continue
	uci -q -c "$dir" set firewall.@defaults[0].flow_offloading='1'
	uci -q -c "$dir" commit firewall
done

exit 0
