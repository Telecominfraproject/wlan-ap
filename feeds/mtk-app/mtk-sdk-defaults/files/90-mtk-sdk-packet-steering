#!/bin/sh
# The MediaTek SDK sets up the CPU affinity of network processing itself
# with smp_util (/sbin/smp-mt76.sh) on the boards that install it. There,
# do not let the packet steering service re-apply its own settings on
# every network or firewall reload. Boards without smp_util keep packet
# steering, otherwise all receive processing stays on one CPU.

[ -x /sbin/smp-mt76.sh ] || exit 0
[ -x /etc/init.d/packet_steering ] && /etc/init.d/packet_steering disable

exit 0
