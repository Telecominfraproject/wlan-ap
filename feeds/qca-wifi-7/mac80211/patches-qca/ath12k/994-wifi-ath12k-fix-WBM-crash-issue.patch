From 610a73565bc429557954bfb9670234189221e0fe Mon Sep 17 00:00:00 2001
From: "jemmy.lin" <jemmy.lin@cybertan.com.tw>
Date: Fri, 18 Sep 2026 16:39:09 +0800
Subject: [PATCH] fix WBM crash issue

---
 drivers/net/wireless/ath/ath12k/hal_rx.c | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/hal_rx.c b/drivers/net/wireless/ath/ath12k/hal_rx.c
index ee61a6462fdc..7c484b930c26 100644
--- a/drivers/net/wireless/ath/ath12k/hal_rx.c
+++ b/drivers/net/wireless/ath/ath12k/hal_rx.c
@@ -352,6 +352,7 @@ int ath12k_hal_wbm_desc_parse_err(struct ath12k_base *ab, void *desc,
 {
	struct hal_wbm_release_ring *wbm_desc = desc;
	struct hal_wbm_release_ring_cc_rx *wbm_cc_desc = desc;
+	struct ath12k_rx_desc_info *desc_info;
	enum hal_wbm_rel_desc_type type;
	enum hal_wbm_rel_src_module rel_src;
	bool hw_cc_done;
@@ -402,8 +403,20 @@ int ath12k_hal_wbm_desc_parse_err(struct ath12k_base *ab, void *desc,

		desc_va = ((u64)le32_to_cpu(wbm_cc_desc->buf_va_hi) << 32 |
			   le32_to_cpu(wbm_cc_desc->buf_va_lo));
-		rel_info->rx_desc =
-			(struct ath12k_rx_desc_info *)((unsigned long)desc_va);
+		desc_info = (struct ath12k_rx_desc_info *)((unsigned long)desc_va);
+
+		/*
+		* desc_va comes directly from HW CC writeback and cannot
+		* be trusted blindly. Probe a non-NULL VA safely before
+		* allowing it to be dereferenced. On failure, leave
+		* rx_desc NULL so the caller can fall back to cookie-based
+		* descriptor lookup.
+		*/
+		if (desc_va &&
+		    copy_from_kernel_nofault(&val, &desc_info->magic, sizeof(val)))
+			desc_info = NULL;
+
+		rel_info->rx_desc = desc_info;
	}

	rel_info->err_rel_src = rel_src;
--
2.34.1

