#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
cambium,x7-35x)
	# Cambium's capability.json gives the X7-35X 24, 25 and 25 dBm
	# conducted on 2.4, 5 and 6 GHz into 5, 6 and 6 dBi antennas, and the
	# datasheet says the same. The 2.4 and 5 GHz figures are taken as they
	# are. 6 GHz is held to 24: the stock firmware runs that radio as an
	# indoor (LPI) access point, whose FCC limit is 30 dBm EIRP, and
	# 25 dBm conducted through 6 dBi is 31 dBm EIRP, 1 dB over; 24 dBm
	# is exactly the cap. A single figure still cannot express the LPI
	# power spectral density limit of 5 dBm/MHz EIRP, which through 6 dBi
	# allows 12, 15, 18 and 21 dBm conducted at 20, 40, 80 and 160 MHz
	# and only reaches the 30 dBm EIRP cap at 320 MHz. Accepted here
	# deliberately, for this lab unit; a bandwidth-aware ceiling is the
	# proper fix.
	#
	# The stock firmware runs the 6 GHz radio as an indoor LPI access
	# point (hostapd he_6ghz_reg_pwr_type 0). The renderer's fall-through
	# for a configuration that names no power type is very low power (2),
	# about 16 dB below that, so the board declares LPI as its default.
	json_select_object wlan
		json_select_object defaults
			json_select_object max_txpower
				json_add_int 2g 24
				json_add_int 5g 25
				json_add_int 6g 24
			json_select ..
			json_add_int he_6ghz_reg_pwr_type 0
		json_select ..
	json_select ..
	;;
esac

board_config_flush

exit 0
