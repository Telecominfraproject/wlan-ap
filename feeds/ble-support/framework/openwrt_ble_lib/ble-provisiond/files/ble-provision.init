#!/bin/sh /etc/rc.common
# ble-provisiond procd init script
#
# Usage:
#   /etc/init.d/ble-provision start          # Start daemon
#   /etc/init.d/ble-provision stop           # Stop daemon
#   /etc/init.d/ble-provision restart        # Restart daemon
#   /etc/init.d/ble-provision reload         # Reload all config
#   /etc/init.d/ble-provision ibeacon_start  # Start iBeacon advertising
#   /etc/init.d/ble-provision ibeacon_stop   # Stop iBeacon advertising
#   /etc/init.d/ble-provision scan_start     # Start BLE scan
#   /etc/init.d/ble-provision scan_stop      # Stop BLE scan
#
# Configuration:
#   /etc/config/ble_chip  — hardware (tty, vendor, baudrate, etc.)
#   /etc/config/ble       — application (ibeacon, scan, gatt_server, daemon)

START=90
STOP=10

USE_PROCD=1
PROG=/usr/sbin/ble-provisiond

# ── Main daemon lifecycle ──

start_service() {
    # Check if BLE chip is enabled — don't start if hardware disabled
    local board_model
    board_model=$(cat /var/sysinfo/board_name 2>/dev/null | cut -d',' -f2)
    [ -z "$board_model" ] && board_model=$(cat /tmp/sysinfo/board_name 2>/dev/null | cut -d',' -f2)
    [ -z "$board_model" ] && board_model="default"

    local chip_enabled
    chip_enabled=$(uci -q get "ble_chip.${board_model}.enabled")
    [ "$chip_enabled" = "0" ] && {
        echo "BLE chip disabled (ble_chip.${board_model}.enabled=0), not starting daemon"
        return 0
    }

    procd_open_instance
    procd_set_param command "$PROG" --foreground
    procd_set_param respawn "${respawn_threshold:-3600}" \
                            "${respawn_timeout:-5}" \
                            "${respawn_retry:-5}"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/ble_chip
    procd_set_param file /etc/config/ble
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "ble_chip"
    procd_add_reload_trigger "ble"
}

reload_service() {
    # Full reload: restart daemon to re-read all config
    stop
    start
}

# ── iBeacon control (reads from /etc/config/ble ibeacon section) ──

ibeacon_start() {
    local enabled uuid major minor txpower radio_power interval

    enabled=$(uci -q get ble.ibeacon.enabled)
    [ "$enabled" != "1" ] && {
        echo "iBeacon disabled in /etc/config/ble"
        return 1
    }

    uuid=$(uci -q get ble.ibeacon.uuid)
    major=$(uci -q get ble.ibeacon.major)
    minor=$(uci -q get ble.ibeacon.minor)
    txpower=$(uci -q get ble.ibeacon.txpower)
    radio_power=$(uci -q get ble.ibeacon.radio_power)
    interval=$(uci -q get ble.ibeacon.interval)

    # Build ubus params
    local params="{\"action\":\"start\""
    [ -n "$uuid" ] && params="$params,\"uuid\":\"$uuid\""
    [ -n "$major" ] && params="$params,\"major\":$major"
    [ -n "$minor" ] && params="$params,\"minor\":$minor"
    [ -n "$txpower" ] && params="$params,\"tx_power\":$txpower"
    [ -n "$radio_power" ] && [ "$radio_power" != "" ] && \
        params="$params,\"radio_power\":$radio_power"
    params="$params}"

    echo "Starting iBeacon: uuid=$uuid major=$major minor=$minor"
    ubus call ble.provision beacon "$params"
}

ibeacon_stop() {
    echo "Stopping iBeacon"
    ubus call ble.provision beacon '{"action":"stop"}'
}

ibeacon_reload() {
    ibeacon_stop 2>/dev/null
    sleep 1
    ibeacon_start
}

# ── BLE Scan control (reads from /etc/config/ble scan section) ──

scan_start() {
    local enabled duration active filter_dup scan_filter

    enabled=$(uci -q get ble.scan.enabled)
    [ "$enabled" != "1" ] && {
        echo "BLE scan disabled in /etc/config/ble"
        return 1
    }

    duration=$(uci -q get ble.scan.duration)
    active=$(uci -q get ble.scan.active)
    filter_dup=$(uci -q get ble.scan.filter_dup)
    scan_filter=$(uci -q get ble.scan.filter)

    local params="{\"action\":\"start\""
    [ -n "$duration" ] && params="$params,\"duration\":$duration"
    [ -n "$active" ] && params="$params,\"active\":$active"
    [ -n "$filter_dup" ] && params="$params,\"filter_dup\":$filter_dup"
    [ -n "$scan_filter" ] && params="$params,\"filter\":\"$scan_filter\""
    params="$params}"

    echo "Starting BLE scan: duration=${duration}ms active=$active filter=$scan_filter"
    ubus call ble.provision scan "$params"
}

scan_stop() {
    echo "Stopping BLE scan"
    ubus call ble.provision scan '{"action":"stop"}'
}

scan_reload() {
    scan_stop 2>/dev/null
    sleep 1
    scan_start
}

# ── Auto-start on boot (if enabled in config) ──
# Note: ibeacon/scan autostart is handled internally by ble-provisiond
# based on /etc/config/ble settings. No need to call via ubus here.

boot() {
    start "$@"
}
