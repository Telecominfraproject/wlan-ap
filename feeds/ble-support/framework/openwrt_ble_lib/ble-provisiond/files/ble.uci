# /etc/config/ble — BLE application configuration
# Installed to /etc/config/ble by ble-provisiond package

config ble 'ibeacon'
    option enabled '0'
    option uuid 'e2c56db6dffb48d2b060d0f5a71096e0'
    option major '1'
    option minor '1'
    option txpower '-59'
    option radio_power ''
    option interval '100'

config ble 'scan'
    option enabled '0'
    option duration '10000'
    option active '1'
    option filter_dup '1'
    option rssi_threshold '-100'
    option filter 'all'
    option max_records '1000'
    option on_limit 'rotate'

config ble 'gatt_server'
    option enabled '0'
    option device_name 'OpenWrt-BLE'
    option allow_ota '0'
    option allow_factory_reset '0'
    option allow_config '1'
    option pin ''

config ble 'daemon'
    option log_level 'info'
    option ubus_enabled '1'
    option respawn '1'
