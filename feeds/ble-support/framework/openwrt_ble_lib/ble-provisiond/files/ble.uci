# SPDX-License-Identifier: BSD-3-Clause
# /etc/config/ble — BLE application configuration
# Installed to /etc/config/ble by ble-provisiond package

config ble 'ibeacon'
    option enabled '0'
    option uuid 'e2c56db6dffb48d2b060d0f5a71096e0'
    option major '1'
    option minor '1'
    option txpower '-59'
    option radio_power ''
    option interval '100'

config ble 'scan'
    option enabled '0'
    option duration '10000'
    option active '1'
    option filter_dup '1'
    option rssi_threshold '-100'
    option filter 'all'
    option max_records '1000'
    option on_limit 'rotate'

config ble 'gatt_server'
    # On by default. This is the third setting of this value and the second
    # reversal, so the reasoning is written out below rather than left to be
    # inferred from the digit.
    #
    # The argument for OFF has not gone away and is not disputed here: BLE
    # provisioning is a configuration surface reachable by anyone in radio range,
    # so opt-in is the conservative posture. What changed is that the costs on the
    # other side were measured rather than assumed, and they turned out to fall on
    # exactly the cases the feature exists for.
    #
    # Why this file is the only lever at all. /etc/config/ble is a rendered
    # artifact on this platform, not user state: the source of truth is
    # /etc/ucentral/ucentral.cfg.<uuid>, and a package with no uCentral schema of
    # its own gets this file restored from the package copy. The restore is the
    # uCentral render, confirmed from its triggers -- a configuration apply does
    # it, a factory reset does it, a plain reboot does not. It cannot be prevented
    # from inside this package, and a plain sysupgrade wipes the overlay anyway
    # (SAVE_CONFIG=0 on this build; see ec-standalone's keepstate.sh). So a
    # runtime `uci set` is not configuration here; the value on this line is.
    #
    # With `0`, that restore had two consequences:
    #
    #   Provisioning was one-shot. The boot right after a successful apply is the
    #   boot with this file restored, so a device provisioned over BLE stopped
    #   being reachable over BLE and needed another channel to turn it back on.
    #
    #   A factory-reset device could not be provisioned over BLE at all. The
    #   overlay wipe brings this file back, `0` means ADV_STOP + DISCONNECT, and
    #   the one state the feature exists to recover from -- a device with no
    #   configuration -- was the one state where it was unavailable.
    #
    # With `1` the restore becomes harmless for this package: all three options it
    # reverts land on working values, since `device_name` is a sentinel that
    # re-derives correctly and `fw_upgrade_mode` reverts to its shipped value too.
    #
    # The gate itself is unchanged and still correct: when this reads `0` the
    # daemon sends ADV_STOP + DISCONNECT on the TI path and skips registration on
    # the BlueZ path. An integrator who wants the conservative posture sets it
    # here and gets it. UCI-006 asserts whatever this line says, so a flip in
    # either direction has to be deliberate.
    option enabled '1'

    # Advertised name. 'OpenWrt-BLE' is a sentinel, not a name: it means "no name
    # was chosen for this board", and the daemon derives one from
    # /var/sysinfo/board_name instead (edgecore,eap104 -> EDGECORE_EAP104).
    #
    # Any other value is used verbatim, so an operator who wants a specific name
    # just sets it. Deriving is what makes the name survive a restore of this
    # file -- a hand-written per-board name does not.
    #
    # Keep any name you set to 18 characters or fewer. That is what is left of a
    # 31-byte advertising PDU after the Flags and manufacturer data, and BlueZ
    # refuses to advertise at all past it rather than truncating. The derivation
    # respects the budget by dropping the vendor; a hand-set value is on you.
    option device_name 'OpenWrt-BLE'

    option allow_ota '0'

    # Factory reset over BLE, on by default.
    #
    # It is destructive (jffs2reset -y + reboot), and it is enabled anyway for
    # two reasons: the shipped phone app offers the action and expects it to
    # work, and the command is reachable only after A5 authentication, which
    # checks the device password against /etc/shadow. An attacker who can pass
    # that already has the device.
    option allow_factory_reset '1'

    option allow_config '1'
    option pin ''
    # Firmware upgrade behaviour for the v2 'upgrade' command (A7):
    #   real     - download with 'sysupgrade -T', then flash and reboot
    #   simulate - walk the state machine only; never touches the flash
    # Overridden by the EAP_FW_UPGRADE_MODE environment variable.
    option fw_upgrade_mode 'real'
    # ATT MTU negotiation (TI path only; BlueZ negotiates on its own).
    #
    # An ATT MTU exchange happens once per connection and only if one side asks.
    # When no one asks the MTU stays at the 23-byte default, which limits a
    # notification to 20 bytes and cuts a fragmented read into 18-byte chunks --
    # at which point the format's 255-fragment ceiling caps a document at ~4.5 KB
    # and a configuration write from the app cannot be sent at all.
    #
    # Default is 1, changed from 0 after measuring on eap111: the shipped app
    # negotiates on some connections and not others, so leaving it to the client
    # means the link sometimes comes up unusable. The daemon still gives the
    # client the first move -- it waits, then skips its own request if the client
    # already negotiated -- so asking cannot collide with an app that does.
    #
    # mtu_request: 0 = wait for the client to ask
    #              1 = ask the client ourselves shortly after connecting (default)
    # mtu_size:    desired ATT MTU when mtu_request is 1.
    #              0 = use the chip's maximum (default), otherwise 23..517
    #              The firmware clamps any request to its own ceiling, which is
    #              SysConfig MAX_PDU_SIZE minus 4, so a number here can only
    #              lower the result -- leave it at 0.
    option mtu_request '1'
    option mtu_size '0'
    # Product tag advertised in the manufacturer data (uint16, little-endian).
    #
    # This is NOT the AP model number -- the real model string reaches the app
    # over the status characteristic after connecting. These two bytes let the
    # app recognise its own devices in the scan list, which it cannot filter by
    # service UUID (no room for a 128-bit UUID beside the device name).
    #
    # 3 is a SENTINEL, not a tag: it means "no tag was chosen for this board", and
    # the daemon replaces it with the board's own tag from the table in
    # adv_status.c (ECCLOUD-11895) -- edgecore,eap104 advertises 12, not 3. The
    # phone app carries the same table.
    #
    # Leave this at 3 on a supported board. Any other value is an integrator
    # override and is advertised verbatim, which also means a per-board number
    # written in here is the one thing that does NOT survive: this file is restored
    # to the package copy during an apply (see gatt_server.enabled above), so the
    # override goes and the derived tag comes back. That asymmetry is the point of
    # deriving rather than configuring, the same as `device_name`.
    #
    # 3 only reaches the air if the board is missing from the table, which the
    # daemon logs as a warning. 0 makes the app ignore this device entirely.
    option model_id '3'

config ble 'daemon'
    option log_level 'info'
    option ubus_enabled '1'
    option respawn '1'
