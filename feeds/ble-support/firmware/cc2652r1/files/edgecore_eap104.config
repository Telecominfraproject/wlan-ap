config ble_chip 'eap104'
	option enabled '1'
	option vendor 'ti'
	option model 'CC2652R1'
	option firmware '/etc/ble_fw/ti/ble5_multi_role_sdk8_33_bd9.bin'
	option fw_loaded ''
	option tty '/dev/ttyMSM1'
	option baudrate '115200'
	option resetpin '496'
	option backdoorpin '500'
	option wdt_enabled '0'
