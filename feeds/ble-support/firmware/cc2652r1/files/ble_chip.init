#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (C) 2007 OpenWrt.org

# Start after D-Bus.
START=62
USE_PROCD=1

SYSINFO_DIR="/var/sysinfo"
GPIO_DIR="/sys/class/gpio"
WDT_PID_FILE="/var/run/wdt_touch.pid"

DEV_MODEL="$(awk -F, '{print $2}' "$SYSINFO_DIR/board_name" 2>/dev/null)"

# Export a numeric GPIO and drive its sysfs value.
gpio_out() {
	_n=$1
	_v=$2

	[ -n "$_n" ] || return 1

	if [ ! -d "$GPIO_DIR/gpio$_n" ]; then
		printf '%s\n' "$_n" > "$GPIO_DIR/export" 2>/dev/null || return 1
		[ -d "$GPIO_DIR/gpio$_n" ] || return 1
	fi

	printf '%s\n' out > "$GPIO_DIR/gpio$_n/direction" 2>/dev/null || return 1
	printf '%s\n' "$_v" > "$GPIO_DIR/gpio$_n/value" 2>/dev/null || return 1
}

wdt_is_running() {
	[ -r "$WDT_PID_FILE" ] || return 1
	_wdt_pid=$(cat "$WDT_PID_FILE" 2>/dev/null)
	case "$_wdt_pid" in
		''|*[!0-9]*) return 1 ;;
	esac
	kill -0 "$_wdt_pid" 2>/dev/null
}

start_service() {
	case "$DEV_MODEL" in
		''|*[!A-Za-z0-9_-]*)
			logger -st ble_chip "cannot determine a valid board model"
			return 1
			;;
	esac

	if ! config_load ble_chip; then
		logger -st ble_chip "cannot load /etc/config/ble_chip"
		return 1
	fi

	config_get model       "$DEV_MODEL" model
	config_get firmware    "$DEV_MODEL" firmware
	config_get tty         "$DEV_MODEL" tty
	config_get baudrate    "$DEV_MODEL" baudrate
	config_get resetpin    "$DEV_MODEL" resetpin
	config_get backdoorpin "$DEV_MODEL" backdoorpin
	config_get wdt_enabled "$DEV_MODEL" wdt_enabled 0
	config_get sw_rstpin   "$DEV_MODEL" sw_rstpin

	if [ "$model" != "CC2652R1" ]; then
		logger -st ble_chip "unsupported BLE model '$model' for '$DEV_MODEL'"
		return 1
	fi

	if [ -z "$firmware" ] || [ -z "$tty" ] || [ -z "$baudrate" ] ||
		[ -z "$resetpin" ] || [ -z "$backdoorpin" ]; then
		logger -st ble_chip "incomplete BLE configuration for '$DEV_MODEL'"
		return 1
	fi

	case "$baudrate:$resetpin:$backdoorpin" in
		*[!0-9:]*|:*|*::*|*:)
			logger -st ble_chip "invalid numeric BLE configuration for '$DEV_MODEL'"
			return 1
			;;
	esac

	tichip="2652"

	# Keep the MCU running in application mode until the updater deliberately
	# enters the ROM bootloader. These physical levels were verified on EAP104:
	# reset HIGH runs the MCU; backdoor HIGH selects the application.
	gpio_out "$resetpin" 1 ||
		logger -st ble_chip "cannot drive resetpin '$resetpin' -- MCU may be held in reset"
	gpio_out "$backdoorpin" 1 ||
		logger -st ble_chip "cannot drive backdoorpin '$backdoorpin' -- MCU may stay in the ROM bootloader"

	# tisbl.sh rejects a numeric sw_rstpin when pinctrl reports that a peripheral
	# owns it. This prevents a bad board setting from taking over a shared pin,
	# such as the EAP104 MDIO clock previously identified as GPIO 501.
	if ! tisbl.sh "$tty" "$baudrate" "$tichip" "$firmware" \
		"$resetpin" "$backdoorpin" "$sw_rstpin"; then
		logger -st ble_chip "tisbl.sh failed -- BLE firmware is not usable"
		return 1
	fi

	sleep 1

	if [ "$wdt_enabled" = "1" ]; then
		if wdt_is_running; then
			wdt_touch.sh active ||
				logger -st ble_chip "failed to activate the BLE watchdog"
		else
			rm -f "$WDT_PID_FILE"
			wdt_touch.sh >/dev/null 2>&1 &
		fi
	fi
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "ble_chip"
}
