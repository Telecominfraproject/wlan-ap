# SPDX-License-Identifier: BSD-3-Clause
config ble_chip 'eap105'
	option enabled '1'
	option vendor 'silabs'
	option model 'EFR32MG21'
	option firmware '/etc/ble_fw/silabs/bt_rcp_v7.3.0-b1859.gbl'
	option tty '/dev/ttyMSM1'
	option baudrate '115200'
	option slchip 'EFR32MG21A020F512IM32-B'
	option resetpin '79'
	option backdoorpin '34'
	option wdt_enabled '0'
