From 788cc051d4e85ea201b534f25ee39e414c1ab691 Mon Sep 17 00:00:00 2001
From: Sebastian Huang <sebastian_huang@accton.com>
Date: Mon, 9 Nov 2026 22:34:51 +0800
Subject: [PATCH] mtk: mt76: mt7915: report the TX rate without WED

The SDK takes the TX rate, the TX byte counts and the per-interface TX
statistics of a station from the PPDU TX status the hardware reports to
the host (MT_AGG_ACR_PPDU_TXS2H, enabled in all cases), but only from
reports tagged MT_PACKET_ID_WED. mt76_tx_status_skb_add() only tags data
frames that way with WED, and the periodic firmware rate query only
fills in the guard interval.

Without WED the TX rate of a station therefore stayed unknown. mac80211
then could not estimate airtime for AQL, left tx_time_est at 0, and
every data frame counted against MT_MAX_NON_AQL_PKT (16 frames in flight
per station). On the EAP111 this cut the downlink to 178 Mbps on 5 GHz
and 130 Mbps on 2.4 GHz, down from 901 and 236 Mbps with WED. The
station's TX rate was also missing from the statistics, and the
interface TX byte counters stayed at 0, because mac80211 leaves those
to the driver (NL80211_EXT_FEATURE_STAS_COUNT).

Tag data frames for the PPDU TX status also without WED. Without WED the
TX free events already count failures and retries, so do not add them a
second time from the PPDU report.
---
 mt76_connac_mac.c | 12 ++++++++----
 mt7915/mac.c      | 14 ++++++++++++++
 2 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/mt76_connac_mac.c b/mt76_connac_mac.c
index cdae673f..46a97d06 100644
--- a/mt76_connac_mac.c
+++ b/mt76_connac_mac.c
@@ -666,10 +666,14 @@ bool mt76_connac2_mac_fill_txs(struct mt76_dev *dev, struct mt76_wcid *wcid,
 		stats->tx_bytes +=
 			le32_get_bits(txs_data[5], MT_TXS5_MPDU_TX_BYTE) -
 			le32_get_bits(txs_data[7], MT_TXS7_MPDU_RETRY_BYTE);
-		stats->tx_failed +=
-			le32_get_bits(txs_data[6], MT_TXS6_MPDU_FAIL_CNT);
-		stats->tx_retries +=
-			le32_get_bits(txs_data[7], MT_TXS7_MPDU_RETRY_CNT);
+
+		/* without WED, the TX free events count these */
+		if (mtk_wed_device_active(&dev->mmio.wed)) {
+			stats->tx_failed +=
+				le32_get_bits(txs_data[6], MT_TXS6_MPDU_FAIL_CNT);
+			stats->tx_retries +=
+				le32_get_bits(txs_data[7], MT_TXS7_MPDU_RETRY_CNT);
+		}
 
 		if (wcid->sta) {
 			if (!le32_get_bits(txs_data[0], MT_TXS0_FIXED_RATE))
diff --git a/mt7915/mac.c b/mt7915/mac.c
index 78bad7bd..bd081b94 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -760,6 +760,20 @@ int mt7915_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 	t->jiffies = jiffies;
 
 	pid = mt76_tx_status_skb_add(mdev, wcid, tx_info->skb);
+	/* The PPDU TX status the hardware reports to the host carries the
+	 * TX rate and the TX byte counts, but they are only taken from
+	 * reports tagged MT_PACKET_ID_WED, which mt76_tx_status_skb_add()
+	 * only uses with WED. Tag data frames without WED as well. Otherwise
+	 * the TX rate of a station stays unknown, mac80211 cannot estimate
+	 * airtime for AQL, and every data frame counts against
+	 * MT_MAX_NON_AQL_PKT.
+	 */
+	if (pid == MT_PACKET_ID_NO_SKB &&
+	    !mtk_wed_device_active(&mdev->mmio.wed) &&
+	    ((info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP) ||
+	     ieee80211_is_data(hdr->frame_control)))
+		pid = MT_PACKET_ID_WED;
+
 	mt7915_mac_write_txwi(mdev, txwi_ptr, tx_info->skb, wcid, pid, key,
 			      qid, 0);
 
-- 
