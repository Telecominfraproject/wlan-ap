From 91e2164214ae02a5ae34e2faeccfe5bc74d4c407 Mon Sep 17 00:00:00 2001
From: Sebastian Huang <sebastian_huang@accton.com>
Date: Tue, 17 Nov 2026 02:35:37 +0800
Subject: [PATCH] mediatek: mt76: mt7996: always set the TX power table

The SDK no longer sets the TX power limit table when a channel is set
up. It only sets it on a channel switch, and when mac80211 reports a TX
power change that differs from phy->txpower. But mt7996_init_txpower()
starts phy->txpower at the highest channel limit of the band. When the
requested power equals that value, the table is never sent and
txpower_cur stays 0, so the radio reports 3 dBm (0 plus the 2-chain
delta).

When the 2.4 GHz channels share one EEPROM target of 26 dBm. A 
configuration without a TX power setting therefore left the 2.4 GHz
table unset and reported 3 dBm, as did any setting of 26 dBm or more.
Limits below the EEPROM target, such as 20 dBm in ETSI countries, were
not applied either. A later channel switch rebuilt the request from
the unset txpower_cur and then really limited the radio to 3 dBm.

Fix this in three places:
- Send the power table on every TX power change from mac80211, even
  when the new value equals phy->txpower.
- Also send it when a new channel context is set up on its first
  channel, as upstream mt76 does on every channel change.
- On a channel switch, send the requested power, capped at the new
  channel's limit, instead of a value rebuilt from txpower_cur.
---
 mt7996/main.c | 36 ++++++++++++++++++++++++++++--------
 1 file changed, 28 insertions(+), 8 deletions(-)

diff --git a/mt7996/main.c b/mt7996/main.c
index 7167081b..8845ed2e 100644
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -767,6 +767,20 @@ static void mt7996_remove_interface(struct ieee80211_hw *hw,
 	}
 }
 
+/* Tx power request in dBm for the current channel: the last value from
+ * mac80211, or the channel limit if there is none or it is lower
+ */
+static int mt7996_chan_txpower(struct mt7996_phy *phy)
+{
+	struct ieee80211_channel *chan = phy->mt76->main_chandef.chan;
+	int txpower = phy->txpower;
+
+	if (chan && (txpower == INT_MIN || txpower > chan->max_power))
+		txpower = chan->max_power;
+
+	return txpower;
+}
+
 int mt7996_set_channel(struct mt76_phy *mphy)
 {
 	struct mt7996_phy *phy = mphy->priv;
@@ -795,9 +809,6 @@ int mt7996_set_channel(struct mt76_phy *mphy)
 		if (ret)
 			goto out;
 	} else if (mphy->chanctx && mphy->chanctx->state == MT76_CHANCTX_STATE_SWITCH) {
-		u8 delta;
-		int current_txpower;
-
 		if (mphy->chanctx->has_ap && phy->pp_mode == PP_USR_MODE) {
 			ret = mt7996_mcu_set_pp_en(phy, PP_USR_MODE,
 						   mphy->main_chandef.punctured);
@@ -810,9 +821,7 @@ int mt7996_set_channel(struct mt76_phy *mphy)
 		if (ret)
 			goto out;
 
-		delta = mt76_tx_power_path_delta(hweight16(mphy->chainmask));
-		current_txpower = DIV_ROUND_UP(mphy->txpower_cur + delta, 2);
-		ret = mt7996_mcu_set_txpower_sku(phy, current_txpower);
+		ret = mt7996_mcu_set_txpower_sku(phy, mt7996_chan_txpower(phy));
 		if (ret)
 			goto out;
 	}
@@ -825,6 +834,15 @@ int mt7996_set_channel(struct mt76_phy *mphy)
 	if (ret)
 		goto out;
 
+	/* first channel of a new context: set the power table now, as
+	 * upstream does on every channel set (a switch did it above)
+	 */
+	if (mphy->chanctx && mphy->chanctx->state == MT76_CHANCTX_STATE_ADD) {
+		ret = mt7996_mcu_set_txpower_sku(phy, mt7996_chan_txpower(phy));
+		if (ret)
+			goto out;
+	}
+
 	ret = mt7996_dfs_init_radar_detector(phy);
 	mt7996_mac_cca_stats_reset(phy);
 
@@ -1190,8 +1208,10 @@ mt7996_link_info_changed(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 	if (changed & BSS_CHANGED_MU_GROUPS)
 		mt7996_update_mu_group(hw, link, info);
 
-	if (changed & BSS_CHANGED_TXPOWER &&
-	    info->txpower != phy->txpower) {
+	/* always program the table: phy->txpower starts at the band maximum,
+	 * so an unchanged value does not mean the firmware has it
+	 */
+	if (changed & BSS_CHANGED_TXPOWER) {
 		phy->txpower = info->txpower;
 		mt7996_mcu_set_txpower_sku(phy, info->txpower);
 	}
-- 
2.34.1

