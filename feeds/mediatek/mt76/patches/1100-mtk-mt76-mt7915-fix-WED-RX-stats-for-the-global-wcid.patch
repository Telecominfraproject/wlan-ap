From bc12c0dd3d9f643772b9ed7023118f90d13ddfcb Mon Sep 17 00:00:00 2001
From: Sebastian Huang <sebastian_huang@accton.com>
Date: Fri, 6 Nov 2026 12:04:15 +0800
Subject: [PATCH] mtk: mt76: mt7915: fix WED RX stats for the global wcid

The WED WO firmware reports RX counters per WTBL index, and
mt7915_mmio_wed_update_rx_stats() also adds them to the netdev of the
station's interface when NL80211_EXT_FEATURE_STAS_COUNT is set. For that
it takes container_of(wcid, struct mt7915_sta, wcid). The global wcid
(index 0, used for frames that match no station) is part of struct
mt76_dev, not of a struct mt7915_sta, so msta->vif is read from an
unrelated field of mt76_dev and the netdev pointer behind it is NULL:

  Unable to handle kernel read from unreadable memory at virtual address 0000000000000098
  pc : mt7915_mmio_wed_update_rx_stats  (__dev_sw_netstats_rx_add(wdev->netdev, ...))
   mtk_wed_update_rx_stats
   mtk_wed_mcu_rx_unsolicited_event
   mtk_wed_wo_irq_tasklet

On the EAP111 this crashed the AP within one to two minutes after boot
as soon as tens of clients joined.

Only do the netdev accounting for station entries, like the TX status
path in mt7915_mac_add_txs() already does, and check msta->vif before
using it: container_of() of a NULL pointer is not NULL.
---
 mt7915/mmio.c | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/mt7915/mmio.c b/mt7915/mmio.c
index 480efd9f..2737aa82 100644
--- a/mt7915/mmio.c
+++ b/mt7915/mmio.c
@@ -601,6 +601,12 @@ static void mt7915_mmio_wed_update_rx_stats(struct mtk_wed_device *wed,
 		wcid->stats.rx_errors += le32_to_cpu(stats->rx_err_cnt);
 		wcid->stats.rx_drops += le32_to_cpu(stats->rx_drop_cnt);
 
+		/* only station entries are embedded in a struct mt7915_sta,
+		 * the global wcid (index 0) is part of struct mt76_dev
+		 */
+		if (!wcid->sta)
+			goto unlock;
+
 		if (wiphy_ext_feature_isset(dev->mphy.hw->wiphy,
 					    NL80211_EXT_FEATURE_STAS_COUNT)) {
 			struct mt7915_sta *msta;
@@ -608,16 +614,15 @@ static void mt7915_mmio_wed_update_rx_stats(struct mtk_wed_device *wed,
 			struct wireless_dev *wdev;
 
 			msta = container_of(wcid, struct mt7915_sta, wcid);
+			if (!msta->vif)
+				goto unlock;
 
 			vif = container_of((void *)msta->vif,
 					   struct ieee80211_vif,
 					   drv_priv);
-			if (!vif)
-				goto unlock;
-
 			wdev = ieee80211_vif_to_wdev(vif);
 
-			if (vif->type == NL80211_IFTYPE_MONITOR)
+			if (vif->type == NL80211_IFTYPE_MONITOR || !wdev->netdev)
 				goto unlock;
 
 			__dev_sw_netstats_rx_add(wdev->netdev, le32_to_cpu(stats->rx_pkt_cnt),
-- 
2.34.1

