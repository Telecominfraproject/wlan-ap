From f17cfccef049f408a3c18a7b80dcf4bb53813f07 Mon Sep 17 00:00:00 2001
From: Sebastian Huang <sebastian_huang@accton.com>
Date: Wed, 4 Nov 2026 20:05:15 +0800
Subject: [PATCH] mtk: mt76: connac2: reset the per-band token counts in
 tx_token_put

mt76_connac2_tx_token_put() frees every pending TX token on SER, on
restart and on unload, but it only rewinds dev->token_count. The per-band
counts in phy->tokens, which mt76_token_consume() raises and
mt76_token_release() lowers, keep the value they had before the reset.
So does dev->wed_token_count. After each recovery the per-band counts
are off by the number of tokens that were in flight:

- the debugfs "token" node shows a wrong per-band share
- a per-band limit (dev->token_threshold) starts to drop frames too early
- with WED, mt76_wed_offload_enable() waits for a wed_token_count that
  can no longer reach zero

The idr is empty at that point, so set the per-band counts and the WED
count to zero under the token lock. Then wake tx_wait, because no
mt76_token_release() call will do it for the counters that just dropped
to zero.

mt7996 has its own mt7996_tx_token_put(), which already lowers
phy->tokens for each token, so it is not changed.
---
 mt76_connac_mac.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/mt76_connac_mac.c b/mt76_connac_mac.c
index eeb16e80..cdae673f 100644
--- a/mt76_connac_mac.c
+++ b/mt76_connac_mac.c
@@ -1228,6 +1228,14 @@ void mt76_connac2_tx_token_put(struct mt76_dev *dev)
 		mt76_connac2_txwi_free(dev, txwi, NULL, NULL);
 		dev->token_count--;
 	}
+
+	/* Every token is gone now. Drop the per-band and WED shares as well,
+	 * since nothing releases them through mt76_token_release() anymore.
+	 */
+	for (id = 0; id < __MT_MAX_BAND; id++)
+		if (dev->phys[id])
+			dev->phys[id]->tokens = 0;
+	dev->wed_token_count = 0;
 	spin_unlock_bh(&dev->token_lock);
 	idr_destroy(&dev->token);
 
@@ -1236,5 +1244,8 @@ void mt76_connac2_tx_token_put(struct mt76_dev *dev)
 		if (phy)
 			atomic_set(&phy->mgmt_tx_pending, 0);
 	}
+
+	/* wake up anyone waiting for wed_token_count or mgmt_tx_pending */
+	wake_up(&dev->tx_wait);
 }
 EXPORT_SYMBOL_GPL(mt76_connac2_tx_token_put);
-- 
