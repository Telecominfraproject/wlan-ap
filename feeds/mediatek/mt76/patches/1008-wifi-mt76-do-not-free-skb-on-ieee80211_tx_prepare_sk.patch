From 34052c8f5418408cff5e17ba6dd4a7732a07ba1e Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Tue, 10 Mar 2026 14:46:09 +0000
Subject: [PATCH] wifi: mt76: do not free skb on ieee80211_tx_prepare_skb
 failure

[ upstream commit d2b1e1aa8ec4636fb216194120ea0ed74fc8b094 ]

ieee80211_tx_prepare_skb already frees the skb internally when
invoke_tx_handlers fails, so freeing it again in the caller leads to a
double-free / NULL pointer dereference in skb_release_data.

Signed-off-by: Felix Fietkau <nbd@nbd.name>
Backport-note: also removes the same double free from the SDK-only
 mt7996_beacon_mon_send_probe() (mt7996/mac.c). That function frees the
 skb again after ieee80211_tx_prepare_skb() fails. The mac80211 in this
 tree (backports 6.18.7) already frees or queues the skb when
 invoke_tx_handlers() fails.
---
 mac80211.c   | 4 +---
 mt7996/mac.c | 1 -
 scan.c       | 4 +---
 3 files changed, 2 insertions(+), 7 deletions(-)

diff --git a/mac80211.c b/mac80211.c
index 2f44992d..17732b34 100644
--- a/mac80211.c
+++ b/mac80211.c
@@ -2197,10 +2197,8 @@ mt76_offchannel_send_nullfunc(struct mt76_offchannel_cb_data *data,
 
 	if (!ieee80211_tx_prepare_skb(phy->hw, vif, skb,
 				      phy->main_chandef.chan->band,
-				      &sta)) {
-		ieee80211_free_txskb(phy->hw, skb);
+				      &sta))
 		return;
-	}
 
 	if (sta)
 		wcid = (struct mt76_wcid *)sta->drv_priv;
diff --git a/mt7996/mac.c b/mt7996/mac.c
index 11efd178..9579695f 100644
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -4246,7 +4246,6 @@ mt7996_beacon_mon_send_probe(struct mt7996_phy *phy, struct mt7996_vif *mvif,
 	skb_set_queue_mapping(skb, IEEE80211_AC_VO);
 	if (!ieee80211_tx_prepare_skb(hw, vif, skb, band, NULL)) {
 		rcu_read_unlock();
-		ieee80211_free_txskb(hw, skb);
 		return -EINVAL;
 	}
 
diff --git a/scan.c b/scan.c
index afc7ca5b..76e5d8bb 100644
--- a/scan.c
+++ b/scan.c
@@ -70,10 +70,8 @@ mt76_scan_send_probe(struct mt76_dev *dev, struct cfg80211_ssid *ssid)
 
 	rcu_read_lock();
 
-	if (!ieee80211_tx_prepare_skb(phy->hw, vif, skb, band, NULL)) {
-		ieee80211_free_txskb(phy->hw, skb);
+	if (!ieee80211_tx_prepare_skb(phy->hw, vif, skb, band, NULL))
 		goto out;
-	}
 
 	info = IEEE80211_SKB_CB(skb);
 	if (req->no_cck)
-- 
2.34.1

