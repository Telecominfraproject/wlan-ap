From 756c0e5aed1e41a75e1e6bf1bdacd5bb3831430f Mon Sep 17 00:00:00 2001
From: "huimin.he" <huimin.he@cybertan.com.tw>
Date: Thu, 19 Nov 2026 11:07:19 +0800
Subject: [PATCH] mtk: mt76: mt7996: send the power tables for a new channel
 context

mt7996_set_channel() only sends the power tables (SKU and backoff) for
a channel context switch, not for a new channel context. When the AP
comes up on another channel, the firmware keeps the tables of the
previous channel until a BSS txpower change or the hostapd txpower
vendor command sends them again, and that does not always happen: on
RAP736C, 5G on channel 52 kept the backoff table of channel 36 (all
494 entries equal to the channel 36 row of the power limit table).

Send them for a new channel context too, with the txpower set before;
mac80211 sends the txpower of the new channel with BSS_CHANGED_TXPOWER.
Send them again when that txpower differs from the one used, not only
when it differs from phy->txpower, which mt7996_init_txpower() also
changes.

Signed-off-by: huimin.he <huimin.he@cybertan.com.tw>
---
 mt7996/main.c | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/mt7996/main.c b/mt7996/main.c
index 41b4045..910c30e 100644
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -794,6 +794,14 @@ int mt7996_set_channel(struct mt76_phy *mphy)
 					   mphy->chandef.punctured);
 		if (ret)
 			goto out;
+
+		/* the firmware keeps the power tables of the previous channel
+		 * until they are sent again
+		 */
+		ret = mt7996_mcu_set_txpower_sku(phy,
+						 mt7996_get_txpower_setting(phy));
+		if (ret)
+			goto out;
 	} else if (mphy->chanctx && mphy->chanctx->state == MT76_CHANCTX_STATE_SWITCH) {
 		if (mphy->chanctx->has_ap && phy->pp_mode == PP_USR_MODE) {
 			ret = mt7996_mcu_set_pp_en(phy, PP_USR_MODE,
@@ -1186,12 +1194,12 @@ mt7996_link_info_changed(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 	if (changed & BSS_CHANGED_MU_GROUPS)
 		mt7996_update_mu_group(hw, link, info);
 
-	if (changed & BSS_CHANGED_TXPOWER && info->txpower > 0)
-		phy->txpower_setting = info->txpower;
-
 	if (changed & BSS_CHANGED_TXPOWER &&
-	    info->txpower != phy->txpower) {
+	    (info->txpower != phy->txpower ||
+	     info->txpower != phy->txpower_setting)) {
 		phy->txpower = info->txpower;
+		if (info->txpower > 0)
+			phy->txpower_setting = info->txpower;
 		mt7996_mcu_set_txpower_sku(phy, info->txpower);
 	}
 
