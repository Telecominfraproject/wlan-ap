From 789dfdd5e56e31f4d69853a3019a950cae399f78 Mon Sep 17 00:00:00 2001
From: "huimin.he" <huimin.he@cybertan.com.tw>
Date: Thu, 19 Nov 2026 09:45:33 +0800
Subject: [PATCH] mtk: mt76: cap txpower limits by the total power of the
 chains

The connac3 firmware takes the rate and backoff entries as total power
(5G ch36 BW80: backoff entry 30 -> 15.5 dBm measured on 3 chains, rate
readback 32 at EHT MCS13 -> 16.6 dBm measured), but
mt76_apply_array_limit() caps them to per-chain power: with a 23 dBm
txpower on 3 chains, rates to 2 * 23 - 9 = 37 (18.5 dBm) and backoff
3T2S to 37, so 5G stays up to 4.5 dB below the table.

On connac3, cap all entries by the total power of the configured chains
instead, and fill rate entries missing in DT with the total power. The
returned max power stays per-chain.

mt7996_mcu_set_txpower_sku() uses a per-chain limit of up to 118 when
no txpower is configured, so clamp the total power to S8_MAX.

Only the DT power limits are changed; the file based table
(mt76_get_rate_power_limits_file) is not.

Signed-off-by: huimin.he <huimin.he@cybertan.com.tw>
---
 eeprom.c | 35 +++++++++++++++++++++++++++++++----
 1 file changed, 31 insertions(+), 4 deletions(-)

diff --git a/eeprom.c b/eeprom.c
index 016a6fc..db9f872 100644
--- a/eeprom.c
+++ b/eeprom.c
@@ -430,6 +430,12 @@ static inline u8 mt76_backoff_n_chains(struct mt76_dev *dev, u8 idx)
 	return is_mt799x(dev) ? connac3_table[idx] : connac2_table[idx];
 }
 
+/* per-chain power + path delta, clamped to the s8 range of the tables */
+static s8 mt76_total_power(s8 target_power, int delta)
+{
+	return min_t(int, target_power + delta, S8_MAX);
+}
+
 static void
 mt76_apply_array_limit(struct mt76_dev *dev, s8 *pwr, size_t pwr_len,
 		       const s8 *data, s8 target_power, s8 nss_delta,
@@ -444,7 +450,7 @@ mt76_apply_array_limit(struct mt76_dev *dev, s8 *pwr, size_t pwr_len,
 		u8 backoff_chain_idx = i;
 		int backoff_n_chains;
 		s8 backoff_delta;
-		s8 delta;
+		s8 delta, cur;
 
 		switch (type) {
 		case MT76_SKU_RATE:
@@ -464,7 +470,21 @@ mt76_apply_array_limit(struct mt76_dev *dev, s8 *pwr, size_t pwr_len,
 			return;
 		}
 
-		pwr[i] = min_t(s8, target_power + delta - backoff_delta, data[i] + nss_delta);
+		if (is_mt799x(dev)) {
+			/* connac3 firmware takes rate and backoff entries as
+			 * total power, so limit them by the total power of the
+			 * configured chains instead of the per-chain power.
+			 * max_power stays per-chain.
+			 */
+			delta = mt76_tx_power_path_delta(n_chains);
+			pwr[i] = min_t(int, mt76_total_power(target_power, delta),
+				       data[i] + nss_delta);
+			cur = pwr[i] - delta;
+		} else {
+			pwr[i] = min_t(s8, target_power + delta - backoff_delta,
+				       data[i] + nss_delta);
+			cur = pwr[i];
+		}
 
 		/* used for padding, doesn't need to be considered */
 		if (data[i] >= S8_MAX - 1)
@@ -474,7 +494,7 @@ mt76_apply_array_limit(struct mt76_dev *dev, s8 *pwr, size_t pwr_len,
 		if (type != MT76_SKU_RATE && n_chains != backoff_n_chains)
 			continue;
 
-		*max_power = max(*max_power, pwr[i]);
+		*max_power = max(*max_power, cur);
 	}
 }
 
@@ -542,7 +562,14 @@ s8 mt76_get_rate_power_limits(struct mt76_phy *phy,
 	s8 txs_delta;
 	int n_chains = hweight16(phy->chainmask);
 
-	memset(dest, target_power, sizeof(*dest) - sizeof(dest->path));
+	/* rate entries missing in DT: no limit below the txpower, which is
+	 * total power on connac3
+	 */
+	memset(dest, is_mt799x(dev) ?
+	       mt76_total_power(target_power,
+				mt76_tx_power_path_delta(n_chains)) :
+	       target_power,
+	       sizeof(*dest) - sizeof(dest->path));
 	memset(&dest->path, 0, sizeof(dest->path));
 
 	if (!IS_ENABLED(CONFIG_OF))
-- 
2.34.1

