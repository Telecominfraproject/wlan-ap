From 96843f55532b7bd2dbe2622f1cce1565e2978f5c Mon Sep 17 00:00:00 2001
From: Sebastian Huang <sebastian_huang@accton.com>
Date: Fri, 16 Oct 2026 01:22:51 +0800
Subject: [PATCH] owf: hostapd: ubus: fix ban timeout unit (seconds)

eloop_register_timeout() takes (seconds, microseconds). The ban timeout
passed the ban_time value as a number of milliseconds, so bans set over
ubus expired 1000x sooner than intended. The OpenWrt hostapd used by
the other TIP boards takes ban_time in seconds; do the same here.

Port of the main branch fix by John Crispin.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ap/ubus.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/ap/ubus.c b/src/ap/ubus.c
index faaccc7..5d2734b 100644
--- a/src/ap/ubus.c
+++ b/src/ap/ubus.c
@@ -153,7 +153,7 @@ hostapd_bss_ban_client(struct hostapd_data *hapd, u8 *addr, int time)
 		}
 	}
 
-	eloop_register_timeout(0, time * 1000, hostapd_bss_del_ban, ban, hapd);
+	eloop_register_timeout(time, 0, hostapd_bss_del_ban, ban, hapd);
 }
 
 static int
-- 
2.34.1

