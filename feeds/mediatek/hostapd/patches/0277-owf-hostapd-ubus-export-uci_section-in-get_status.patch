From e23aedaf6e0df117d033fe7e483ac23cc4854084 Mon Sep 17 00:00:00 2001
From: Tony Lu <tony_lu@accton.com>
Date: Tue, 13 Oct 2026 11:42:10 +0800
Subject: [PATCH] mtk: hostapd: export uci_section in ubus get_status

Export uci_section in the hostapd.<bss> get_status ubus reply so that
ucentral-event can resolve each BSS's wireless config. The mediatek
hostapd feed parses uci_section from the hostapd config (0264) but
never reports it over ubus. Without this, hapd.config stays undefined
and strict_fwd_set_redirect() returns silently, so the bridger redirect
is never configured and strict forwarding has no effect on MTK-based
APs.

Signed-off-by: Tony Lu <tony_lu@accton.com>
---
 src/ap/ubus.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/ap/ubus.c b/src/ap/ubus.c
index daaa756..faaccc7 100644
--- a/src/ap/ubus.c
+++ b/src/ap/ubus.c
@@ -419,6 +419,9 @@ hostapd_bss_get_status(struct ubus_context *ctx, struct ubus_object *obj,
 			hapd->iface->cac_started ? hapd->iface->dfs_cac_ms / 1000 - now.sec : 0);
 	blobmsg_close_table(&b, dfs_table);
 
+	if (hapd->conf->uci_section)
+		blobmsg_add_string(&b, "uci_section", hapd->conf->uci_section);
+
 	ubus_send_reply(ctx, req, b.head);
 
 	return 0;
-- 
2.34.1

