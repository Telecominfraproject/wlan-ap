/dts-v1/;

#include <dt-bindings/leds/common.h>
#include "mt7981.dtsi"

/ {
	model = "EdgeCore EAP112";
	compatible = "edgecore,eap112", "mediatek,mt7981";

	aliases {
		serial0 = &uart0;
		led-boot = &led_green;
		led-failsafe = &led_green;
		led-running = &led_green;
		led-upgrade = &led_green;
		label-mac-device = &gmac1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_green: led-green {
			label = "green:power";
			gpios = <&pio 9 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
		};

		led_orange: led-orange {
			label = "orange:halow";
			gpios = <&pio 34 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_ORANGE>;
			function = LED_FUNCTION_INDICATOR;
		};

		led_blue: led-blue {
			label = "blue:lte";
			gpios = <&pio 35 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
		};
	};
};

&uart0 {
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pins>;
	status = "okay";
};

&watchdog {
	status = "okay";
};

/* LTE modem on the SoC USB port. mt7981.dtsi leaves the PHY and the xHCI
 * controller disabled. The modem power and reset lines are driven from
 * userspace (board.d/03_gpio_switches).
 */
&usb_phy {
	status = "okay";
};

&xhci {
	status = "okay";
};

&pio {
	spi0_flash_pins: spi0-pins {
		mux {
			function = "spi";
			groups = "spi0", "spi0_wp_hold";
		};
	};

	/* Only CS/CLK/MOSI/MISO (GPIO 26-29) go to SPI2; GPIO 30 and 31 are the
	 * MM6108 interrupt and reset lines, so "spi2_wp_hold" is not selected.
	 */
	spi2_pins: spi2-pins {
		mux {
			function = "spi";
			groups = "spi2";
		};
	};

	uart2_pins: uart2-pins {
		mux {
			function = "uart";
			groups = "uart2_1";
		};
	};
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	cs-gpios = <0>, <0>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <52000000>;

		spi-cal-enable;
		spi-cal-mode = "read-data";
		spi-cal-datalen = <7>;
		spi-cal-data = /bits/ 8 <0x53 0x50 0x49 0x4E 0x41 0x4E 0x44>;
		spi-cal-addrlen = <5>;
		spi-cal-addr = /bits/ 32 <0x0 0x0 0x0 0x0 0x0>;

		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		mediatek,nmbm;
		mediatek,bmt-max-ratio = <1>;
		mediatek,bmt-max-reserved-blocks = <64>;

		/* Same layout as the kernel 5.4 image, so either kernel can write the
		 * other's sysupgrade image. No "linux,ubi": U-Boot passes the slot to
		 * attach on the command line.
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "BL2";
				reg = <0x00000 0x100000>;
				read-only;
			};

			partition@100000 {
				label = "u-boot-env";
				reg = <0x100000 0x80000>;
			};

			partition@180000 {
				label = "Factory";
				reg = <0x180000 0x200000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory: eeprom@0 {
						reg = <0x0 0x1000>;
					};

					macaddr_wan: macaddr@2a {
						reg = <0x2a 0x6>;
					};

					macaddr_lan: macaddr@24 {
						reg = <0x24 0x6>;
					};
				};
			};

			partition@380000 {
				label = "FIP";
				reg = <0x380000 0x200000>;
				read-only;
			};

			partition@580000 {
				label = "rootfs1";
				reg = <0x580000 0x4000000>;
			};

			partition@4580000 {
				label = "rootfs2";
				reg = <0x4580000 0x4000000>;
			};
		};
	};
};

/* Morse Micro MM6108 (Wi-Fi HaLow). The driver only registers an spi_driver,
 * so this node is what creates the device, and probe fails without
 * reset-gpios and spi-irq-gpios. 50 MHz is the highest SPI clock the
 * mm6108-2.0.1 driver accepts; it clips anything above with a warning.
 */
&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_pins>;
	status = "okay";

	mm6108: mm6108@0 {
		compatible = "morse,mm610x-spi";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;
		reset-gpios = <&pio 31 GPIO_ACTIVE_HIGH>;
		spi-irq-gpios = <&pio 30 GPIO_ACTIVE_HIGH>;
		power-gpios = <&pio 5 GPIO_ACTIVE_HIGH>, <&pio 0 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&mdio_bus {
	reset-gpios = <&pio 39 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <10000>;

	en8801sc: ethernet-phy@24 {
		reg = <24>;
		compatible = "ethernet-phy-id03a2.9471";
		phy-mode = "sgmii";
	};

	an8801sb: ethernet-phy@30 {
		reg = <30>;
		compatible = "ethernet-phy-idc0ff.0421";
		phy-mode = "sgmii";
		full-duplex;
		pause;
		airoha,surge = <0>;
		airoha,polarity = <2>;
	};
};

&eth {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";

	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "sgmii";
		phy-handle = <&an8801sb>;
		phy-handle2 = <&en8801sc>;
		managed = "in-band-status";
		nvmem-cells = <&macaddr_lan>;
		nvmem-cell-names = "mac-address";
	};

	gmac1: mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		phy-mode = "gmii";
		phy-handle = <&int_gbe_phy>;
		nvmem-cells = <&macaddr_wan>;
		nvmem-cell-names = "mac-address";
	};
};

&wifi {
	nvmem-cells = <&eeprom_factory>;
	nvmem-cell-names = "eeprom";
	status = "okay";
};
