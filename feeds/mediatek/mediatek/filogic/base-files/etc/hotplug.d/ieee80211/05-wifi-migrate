#!/bin/sh

# This must run before 10-wifi-detect


[ "${ACTION}" = "add" ] || return


. /lib/functions.sh


check_radio()
{
	local cfg="$1" to="$2"

	config_get path "$cfg" path

	[ "$path" = "$to" ] && PATH_EXISTS=true
}

do_migrate_radio()
{
	local cfg="$1" from="$2" to="$3"

	config_get path "$cfg" path

	[ "$path" = "$from" ] || return

	uci set "wireless.${cfg}.path=${to}"
	WIRELESS_CHANGED=true

	logger -t wifi-migrate "Updated path of wireless.${cfg} from '${from}' to '${to}'"
}

migrate_radio()
{
	local from="$1" to="$2"

	config_load wireless

	# Check if there is already a section with the target path: In this case, the system
	# was already upgraded to a version without this migration script before; better bail out,
	# as we can't be sure we don't break more than we fix.
	PATH_EXISTS=false
	config_foreach check_radio wifi-device "$to"
	$PATH_EXISTS && return

	config_foreach do_migrate_radio wifi-device "$from" "$to"
}

do_migrate_morse()
{
	local cfg="$1" to="$2" type path

	config_get type "$cfg" type
	[ "$type" = "morse" ] || return

	config_get path "$cfg" path
	[ -n "$path" ] && [ "$path" != "$to" ] || return
	[ -e "/sys/devices/$path" ] && return

	uci set "wireless.${cfg}.path=${to}"
	WIRELESS_CHANGED=true

	logger -t wifi-migrate "Updated path of wireless.${cfg} from '${path}' to '${to}'"
}


WIRELESS_CHANGED=false

case "$(board_name)" in
edgecore,eap112)
	# Kernel 5.4 named the MT7981 WMAC "wbsys" and did not place it under "soc".
	migrate_radio 'platform/18000000.wbsys' 'platform/soc/18000000.wifi'
	migrate_radio 'platform/18000000.wbsys+1' 'platform/soc/18000000.wifi+1'

	# The HaLow SPI controller moved under "soc" and its bus number changed,
	# so a kept path no longer resolves. Point it at the phy being added.
	case "$DEVPATH" in
	*/11009000.spi/*/ieee80211/*)
		config_load wireless
		to="${DEVPATH#/devices/}"
		config_foreach do_migrate_morse wifi-device "${to%/ieee80211/*}"
		;;
	esac
	;;
esac

case "$(board_name)" in
*)
	migrate_radio 'platform/18000000.wifi' 'platform/soc/18000000.wifi'
	migrate_radio 'platform/18000000.wifi+1' 'platform/soc/18000000.wifi+1'
    ;;
esac

$WIRELESS_CHANGED && uci commit wireless

exit 0
