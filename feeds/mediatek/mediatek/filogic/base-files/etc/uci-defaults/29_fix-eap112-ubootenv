#!/bin/sh

. /lib/functions.sh

[ "$(board_name)" = "edgecore,eap112" ] || exit 0

# A config-preserving sysupgrade keeps /etc/config/ubootenv but not
# /etc/fw_env.config, and 30_uboot-envtools only regenerates both when
# /etc/config/ubootenv is absent. Coming from kernel 5.4 the kept file is also
# stale: the extra raw NMBM mtd there put u-boot-env at mtd2, kernel 6.6 has it
# at mtd1. Remove it so 30_uboot-envtools looks u-boot-env up by name again.
[ -e /etc/fw_env.config ] || rm -f /etc/config/ubootenv

exit 0
