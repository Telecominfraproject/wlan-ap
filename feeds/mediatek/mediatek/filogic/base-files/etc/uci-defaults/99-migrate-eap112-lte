#!/bin/sh

. /lib/functions.sh

[ "$(board_name)" = "edgecore,eap112" ] || exit 0

# Kernel 5.4 numbered the mt7981 GPIO controller from 455, kernel 6.6 numbers
# it from GPIO_DYNAMIC_BASE (512). board.d only regenerates /etc/config/system
# on a factory boot, so a config-preserving upgrade keeps the old sysfs numbers
# of the LTE modem reset (pio 2) and power (pio 3) lines.
changed=0
[ "$(uci -q get system.gpio_lte_reset.gpio_pin)" = "457" ] && {
	uci -q set system.gpio_lte_reset.gpio_pin='514'
	changed=1
}
[ "$(uci -q get system.gpio_lte_power.gpio_pin)" = "458" ] && {
	uci -q set system.gpio_lte_power.gpio_pin='515'
	changed=1
}
[ "$changed" = "1" ] && uci -q commit system

# The xHCI controller moved under "soc" and was renamed from 11200000.xhci to
# 11200000.usb, so the modem sysfs path kept in network.wan.device changed
# prefix. The port part (usb1/1-1) is unchanged.
[ "$(uci -q get network.wan.proto)" = "modemmanager" ] || exit 0

device="$(uci -q get network.wan.device)"
case "$device" in
*platform/11200000.xhci/*)
	uci -q set network.wan.device="$(echo "$device" | sed 's#platform/11200000\.xhci/#platform/soc/11200000.usb/#')"
	uci -q commit network
	;;
esac

exit 0
