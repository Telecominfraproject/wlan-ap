From: huimin.he <Richard.Zhang@cybertan.com.tw>
Subject: [PATCH] mtk: mac80211: fix the key and chanctx cleanup of a removed
 AP_VLAN

When the last station of a dynamic VLAN leaves, hostapd removes the
AP_VLAN interface. Two MTK changes break that path.

1) Keys

The group keys of an AP_VLAN are bound to a link:
ieee80211_add_key() sets key->conf.link_id = link->link_id, which is 0
for the deflink of a non-MLD AP_VLAN and the AP's link ID for an
AP_VLAN of an MLD AP (whose link pointers are shared with the AP).

"mtk: mac80211: remove links when removing AP_VLAN interface" clears
sdata->link[] of the AP_VLAN in ieee80211_del_intf_link(), called on
NETDEV_GOING_DOWN. When ieee80211_do_stop() frees the keys afterwards,
ieee80211_key_replace() cannot find the link and returns -ENOLINK
without unlinking the key from sdata->key_list.
ieee80211_free_keys_iface() ignores the error, moves the key to the
local free list and frees it, so sdata->key_list keeps pointing to the
freed key and the second ieee80211_free_keys() call from
ieee80211_teardown_sdata() dereferences it:

  Unable to handle kernel access to user memory ... at virtual address 0000000000001238
  pc : ieee80211_key_replace
       ieee80211_free_keys_iface
       ieee80211_free_keys
       ieee80211_teardown_sdata
       ieee80211_uninit
       unregister_netdevice_many_notify
       ...
       ieee80211_if_remove
       cfg80211_remove_virtual_intf

"keep the deflink of a non-MLD AP_VLAN" avoids this for a non-MLD
AP_VLAN only. Fix it for MLD as well by:
- removing the link-bound keys of the AP_VLAN in
  ieee80211_del_intf_link() before its link pointers are cleared.
- unlinking the key from sdata->key_list in ieee80211_free_keys_iface()
  if ieee80211_key_replace() fails, so the list never keeps a freed key.

2) Chanctx

"mtk: cfg80211: rework cac started, cac start time for multi-link"
makes ieee80211_do_stop() release the channel of every valid link, not
only while a CAC is running, and "Revert: wifi: mac80211: Create
separate links for VLAN interfaces" removed the AP_VLAN check in
ieee80211_link_release_channel(). The deflink of a non-MLD AP_VLAN
holds a copy of the AP's chanctx pointer
(ieee80211_link_vlan_copy_chanctx()), so mac80211 unassigns the AP's
chanctx from the AP_VLAN, which the driver does not know:

  phy0.0-ap0-v11: Failed check-sdata-in-driver check, flags: 0x1
  WARNING: ... at drv_unassign_vif_chanctx
   ieee80211_recalc_smps_chanctx
   __ieee80211_link_release_channel
   ieee80211_link_release_channel
   ieee80211_do_stop
   ...
   nl80211_del_interface

An AP_VLAN never owns a chanctx, so skip it in that loop. Its chanctx
pointer is cleared in the AP_VLAN case further down.

Signed-off-by: huimin.he <Richard.Zhang@cybertan.com.tw>
---
 net/mac80211/cfg.c   | 14 ++++++++++++++
 net/mac80211/iface.c |  8 ++++++++
 net/mac80211/key.c   | 38 +++++++++++++++++++++++++++++++++++---
 net/mac80211/key.h   |  2 ++
 4 files changed, 59 insertions(+), 3 deletions(-)

diff --git a/net/mac80211/cfg.c b/net/mac80211/cfg.c
--- a/net/mac80211/cfg.c
+++ b/net/mac80211/cfg.c
@@ -5606,8 +5606,22 @@ static void ieee80211_del_intf_link(struct wiphy *wiphy,
 	u16 new_links = wdev->valid_links & ~BIT(link_id);
 
 	if (wdev->iftype == NL80211_IFTYPE_AP_VLAN) {
+		LIST_HEAD(keys);
 		int i;
 
+		lockdep_assert_wiphy(sdata->local->hw.wiphy);
+
+		/*
+		 * Keys bound to a link must be removed while the link
+		 * pointers are still valid, ieee80211_key_replace() can't
+		 * find the link anymore once they are cleared below.
+		 */
+		ieee80211_remove_vlan_link_keys(sdata, &keys);
+		if (!list_empty(&keys)) {
+			synchronize_net();
+			ieee80211_free_key_list(sdata->local, &keys);
+		}
+
 		/*
 		 * Only an AP_VLAN of an MLD AP shares the AP's links. A
 		 * non-MLD AP_VLAN uses its deflink as link 0, and its group
diff --git a/net/mac80211/iface.c b/net/mac80211/iface.c
--- a/net/mac80211/iface.c
+++ b/net/mac80211/iface.c
@@ -575,6 +575,14 @@ static void ieee80211_do_stop(struct ieee80211_sub_if_data *sdata, bool going_do
 				  &sdata->deflink.dfs_cac_timer_work);
 
 	for_each_valid_link(&sdata->wdev, link_id) {
+		/*
+		 * An AP_VLAN only borrows the chanctx of its AP and was
+		 * never assigned to it in the driver, so it must not
+		 * release it; its chanctx pointer is cleared below.
+		 */
+		if (sdata->vif.type == NL80211_IFTYPE_AP_VLAN)
+			break;
+
 		link = sdata_dereference(sdata->link[link_id], sdata);
 		if (!link)
 			continue;
diff --git a/net/mac80211/key.c b/net/mac80211/key.c
--- a/net/mac80211/key.c
+++ b/net/mac80211/key.c
@@ -1100,9 +1100,16 @@ static void ieee80211_free_keys_iface(struct ieee80211_sub_if_data *sdata,
 	ieee80211_debugfs_key_remove_beacon_default(sdata);
 
 	list_for_each_entry_safe(key, tmp, &sdata->key_list, list) {
-		ieee80211_key_replace(key->sdata, NULL, key->sta,
-				      key->conf.flags & IEEE80211_KEY_FLAG_PAIRWISE,
-				      key, NULL);
+		/*
+		 * If the key could not be replaced (e.g. its link is already
+		 * gone), it is still on sdata->key_list. Unlink it here,
+		 * otherwise the list keeps pointing to the key after it is
+		 * freed below.
+		 */
+		if (ieee80211_key_replace(key->sdata, NULL, key->sta,
+					  key->conf.flags & IEEE80211_KEY_FLAG_PAIRWISE,
+					  key, NULL))
+			list_del_rcu(&key->list);
 		list_add_tail(&key->list, keys);
 	}
 
@@ -1128,6 +1135,31 @@ void ieee80211_remove_link_keys(struct ieee80211_link_data *link,
 	}
 }
 
+void ieee80211_remove_vlan_link_keys(struct ieee80211_sub_if_data *sdata,
+				     struct list_head *keys)
+{
+	struct ieee80211_key *key, *tmp;
+
+	lockdep_assert_wiphy(sdata->local->hw.wiphy);
+
+	if (WARN_ON(sdata->vif.type != NL80211_IFTYPE_AP_VLAN))
+		return;
+
+	list_for_each_entry_safe(key, tmp, &sdata->key_list, list) {
+		struct ieee80211_link_data *link;
+
+		if (key->conf.link_id < 0)
+			continue;
+
+		link = sdata_dereference(sdata->link[key->conf.link_id], sdata);
+		if (ieee80211_key_replace(sdata, link, key->sta,
+					  key->conf.flags & IEEE80211_KEY_FLAG_PAIRWISE,
+					  key, NULL))
+			list_del_rcu(&key->list);
+		list_add_tail(&key->list, keys);
+	}
+}
+
 void ieee80211_free_key_list(struct ieee80211_local *local,
 			     struct list_head *keys)
 {
diff --git a/net/mac80211/key.h b/net/mac80211/key.h
--- a/net/mac80211/key.h
+++ b/net/mac80211/key.h
@@ -158,6 +158,8 @@ void ieee80211_set_default_beacon_key(struct ieee80211_link_data *link,
 				      int idx);
 void ieee80211_remove_link_keys(struct ieee80211_link_data *link,
 				struct list_head *keys);
+void ieee80211_remove_vlan_link_keys(struct ieee80211_sub_if_data *sdata,
+				     struct list_head *keys);
 void ieee80211_free_key_list(struct ieee80211_local *local,
 			     struct list_head *keys);
 void ieee80211_free_keys(struct ieee80211_sub_if_data *sdata,
