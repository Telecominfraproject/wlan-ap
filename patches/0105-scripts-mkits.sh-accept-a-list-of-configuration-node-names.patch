From a298b0f6594a7373d228646274d16a5cfb92ad78 Mon Sep 17 00:00:00 2001
From: Firas Shaari <firas.shaari@shaariconsultancy.com>
Date: Wed, 30 Sep 2026 23:49:35 -0400
Subject: [PATCH] scripts/mkits.sh: accept a list of configuration node names

Some boot loaders pick the FIT configuration node by hardware ID instead
of honouring the FIT's default property. The QCA bootipq command does
this: on the Cambium XV2-2T0 (IPQ6018) it looks for config@cp01-c1-1 on
hwid 8 and config@cp01-c1-2 on hwid 12, and the vendor image carries one
node per hardware ID so that a single image serves several SKUs. A FIT
with only one configuration node cannot be booted by it at all.

Let -c take a comma-separated list of configuration names and emit one
node per name, all pointing at the same kernel and fdt. The first name
is the default. A single name, with or without the other options, yields
the same .its as before, byte for byte.

Signed-off-by: Firas Shaari <firas.shaari@shaariconsultancy.com>
---
 scripts/mkits.sh | 31 +++++++++++++++++++++----------
 1 file changed, 21 insertions(+), 10 deletions(-)

diff --git a/scripts/mkits.sh b/scripts/mkits.sh
index 46ab5ee023..20549cc129 100755
--- a/scripts/mkits.sh
+++ b/scripts/mkits.sh
@@ -20,7 +20,7 @@ usage() {
 
 	printf "\n\t-A ==> set architecture to 'arch'"
 	printf "\n\t-C ==> set compression type 'comp'"
-	printf "\n\t-c ==> set config name 'config'"
+	printf "\n\t-c ==> set config name 'config' (comma-separated list, first is default)"
 	printf "\n\t-a ==> set load address to 'addr' (hex)"
 	printf "\n\t-e ==> set entry point to 'entry' (hex)"
 	printf "\n\t-f ==> set device tree compatible string"
@@ -192,6 +192,24 @@ OVCONFIGS=""
 	"
 done
 
+# Create one configuration node per name given to -c. Boot loaders that
+# select the configuration by hardware ID rather than by the 'default'
+# property (QCA bootipq) need a node for every ID the image serves; all of
+# them point at the same kernel and fdt. The first name is the default.
+DEFAULT_CONFIG=${CONFIG%%,*}
+CONFIG_NODES=""
+for cfg in $(printf '%s' "${CONFIG}" | tr ',' ' '); do
+	CONFIG_NODES="${CONFIG_NODES}${CONFIG_NODES:+
+		}${cfg} {
+			description = \"OpenWrt ${DEVICE}\";
+			kernel = \"kernel${REFERENCE_CHAR}1\";
+			${FDT_PROP}
+			${LOADABLES:+loadables = ${LOADABLES};}
+			${COMPATIBLE_PROP}
+			${INITRD_PROP}
+		};"
+done
+
 # Create a default, fully populated DTS file
 DATA="/dts-v1/;
 
@@ -223,15 +241,8 @@ ${ROOTFS_NODE}
 	};
 
 	configurations {
-		default = \"${CONFIG}\";
-		${CONFIG} {
-			description = \"OpenWrt ${DEVICE}\";
-			kernel = \"kernel${REFERENCE_CHAR}1\";
-			${FDT_PROP}
-			${LOADABLES:+loadables = ${LOADABLES};}
-			${COMPATIBLE_PROP}
-			${INITRD_PROP}
-		};
+		default = \"${DEFAULT_CONFIG}\";
+		${CONFIG_NODES}
 		${OVCONFIGS}
 	};
 };"
